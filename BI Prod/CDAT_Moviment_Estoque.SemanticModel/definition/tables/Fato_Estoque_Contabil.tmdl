	partition Fato_Estoque_Contabil = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "STAGE", [Query="SELECT #(lf)  S.[it-codigo] AS 'Item',#(lf)  I.[DescItem] AS 'Descrição',#(lf)  CONVERT(INT,S.[qtidade-atu],0) AS 'Quantidade',#(lf)  UPPER(S.[cod-depos]) AS 'Depósito'#(lf)FROM #(lf)  STAGE.tot.SaldoEstoq AS S#(lf)LEFT JOIN #(lf)  DW.dbo.Dim_Item AS I ON S.[it-codigo] = I.[CodItem]#(lf)WHERE #(lf)  S.[cod-depos] IN ('DCV','AAT','AIR','ATE','DAT','DES','RCB','REC','NAT','DEV') #(lf)  AND S.[cod-estabel] = '15' #(lf)  AND S.[qtidade-atu] <> 0;"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

