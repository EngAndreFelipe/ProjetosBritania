	partition Capacidade = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="WITH DateSequence AS (#(lf)    SELECT #(lf)        0 AS DayOffset#(lf)    UNION ALL#(lf)    SELECT #(lf)        DayOffset + 1#(lf)    FROM #(lf)        DateSequence#(lf)    WHERE #(lf)        DayOffset < 9#(lf))#(lf)SELECT#(lf)    10000 AS Capacidade,#(lf)    (SELECT ISNULL(SUM(QtdeNFE),0)#(lf)#(tab)#(tab)FROM logistica.Fato_EXB023#(lf)#(tab)#(tab)WHERE CONVERT(DATE, DataProgramacao) = CONVERT(DATE, GETDATE()+ DayOffset)) AS Recebimento,#(lf)    (SELECT ISNULL(COUNT(QuantidadeFaturada),0)#(lf)#(tab)#(tab)FROM logistica.Fato_FTB101#(lf)#(tab)#(tab)WHERE CONVERT(DATE, DtProgEmbarque) = CONVERT(DATE, GETDATE() + DayOffset)) AS Expedição,#(lf)    10000 - (SELECT ISNULL(SUM(QtdeNFE),0)#(lf)#(tab)#(tab)FROM logistica.Fato_EXB023#(lf)#(tab)#(tab)WHERE CONVERT(DATE, DataProgramacao) = CONVERT(DATE, GETDATE()+ DayOffset)) - #(lf)    (SELECT ISNULL(COUNT(QuantidadeFaturada),0)#(lf)#(tab)#(tab)FROM logistica.Fato_FTB101#(lf)#(tab)#(tab)WHERE CONVERT(DATE, DtProgEmbarque) = CONVERT(DATE, GETDATE() + DayOffset)) AS Saldo,#(lf)    CONVERT(DATE, GETDATE() + DayOffset) AS 'Data'#(lf)FROM #(lf)    DateSequence#(lf)ORDER BY 'Data'#(lf)OPTION (MAXRECURSION 10);"])
				in
				    Fonte

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

