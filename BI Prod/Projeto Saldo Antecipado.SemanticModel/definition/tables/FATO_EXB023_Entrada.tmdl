	partition FATO_EXB023_Entrada = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT DISTINCT#(lf)#(tab)DataProgramacao,#(lf)#(tab)Container,#(lf)#(tab)QtdeNFE,#(lf)#(tab)[Status],#(lf)#(tab)Item,#(lf)#(tab)StatusProg,#(lf)#(tab)DescricaodoItem,#(lf)#(tab)DescLinhaPai#(lf)FROM logistica.Fato_EXB023"]),
