table FATO_EXB023_Entrada
	lineageTag: dfb13db8-0438-4170-9a64-2dfff2806f95

	measure Estoque = SUMX(FILTER('tot MovtoEstoq',''))
		lineageTag: eb1b2a42-f091-4cc8-ae47-5e470a5862f0

	measure 'soma entrada' = SUM(Planilha1[Entrada])
		formatString: #,0
		lineageTag: ee25ba4b-892c-4a61-a285-aaca6e016da4

	measure 'soma saida' = SUM(Planilha1[Saída])
		formatString: 0
		lineageTag: 882e97d1-fd68-49e8-8480-25b4122a940e

	measure 'soma capacidade' = ```
			[soma entrada] + [soma saida] 
			```
		formatString: #,0
		lineageTag: 93172301-0d53-46a9-aa30-555c427a4ab9

	measure 'saldo do dia' = [soma capacidade] - Tabela[saldo]
		formatString: #,0
		lineageTag: f0336489-9d55-4150-8611-1db1ed370b1b

