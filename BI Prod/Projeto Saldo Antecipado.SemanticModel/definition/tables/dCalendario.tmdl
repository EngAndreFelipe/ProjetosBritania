	partition dCalendario = calculated
		mode: import
		source = ```
				
				VAR MinAno = 2023
				VAR MaxAno = YEAR(TODAY())+1
				 
				VAR CalendarioBase =
				    ADDCOLUMNS (
				        CALENDAR (DATE(MinAno, 01, 01), DATE(MaxAno, 12, 31)),
				        "DataInt", FORMAT ( [Date], "YYYYMMDD" ),
				        "Ano", YEAR ( [Date] ),
				        "MesNum", FORMAT ( [Date], "MM" ),
				        "AnoMesNum", FORMAT ( [Date], "YYYY/MM" ),
				        "AnoMesNome", FORMAT ( [Date], "YYYY/mmm" ),
				        "MesNomeCurto", FORMAT ( [Date], "mmm" ),
				        "MesNomeLongo", FORMAT ( [Date], "mmmm" ),
				        "DiaSemanaNum", WEEKDAY ( [Date] ),
				        "DiaSemana", FORMAT ( [Date], "dddd" ),
				        "DiaSemanaCurto", FORMAT ( [Date], "ddd" ),
				        "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				        "AnoTrimestre", FORMAT ( [Date], "YYYY" ) & "/Q" & FORMAT ( [Date], "Q" ),
				        "AnoAtual", IF(YEAR ( [Date] ) = YEAR(TODAY()), "Ano Atual", FORMAT ( [Date], "YYYY" )),
				        "MesAtual", IF(YEAR ( [Date] ) = YEAR(TODAY()) && MONTH ( [Date] ) = MONTH(TODAY()), "Mês Atual", FORMAT ( [Date], "MM" )),
				        "DiaAtual", IF(YEAR ( [Date] ) = YEAR(TODAY()) && MONTH ( [Date] ) = MONTH(TODAY()) && DAY ( [Date] ) = DAY(TODAY()), "Dia Atual", FORMAT ( [Date], "DD" ))
				    )
				 
				RETURN
				    CalendarioBase
				```

	annotation PBI_Id = 26256fff0e464e82a21b8b11c2292658

