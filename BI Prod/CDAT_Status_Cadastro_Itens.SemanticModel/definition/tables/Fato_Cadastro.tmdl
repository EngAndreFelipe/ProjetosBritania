	column TotalItens
		dataType: int64
		formatString: 0
		lineageTag: 096c846d-3761-4344-bac0-80137c57a8c3
		summarizeBy: sum
		sourceColumn: TotalItens

		annotation SummarizationSetBy = Automatic

	partition Fato_Cadastro = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("pr-s188\dw", "DW", [Query="WITH Base AS (#(lf)    SELECT #(lf)          F.Item,#(lf)          F.Descricao,#(lf)          F.Total,#(lf)          F.Reservado,#(lf)          F.Disponivel,#(lf)#(lf)          I.[peso-liquido] AS Peso_Liquido,#(lf)          I.[peso-bruto]  AS Peso_Bruto,#(lf)          I.[comprim]     AS Comprimento,#(lf)          I.[largura]     AS Largura,#(lf)          I.[altura]      AS Altura,#(lf)#(lf)          I.DATA_ALTERACAO,#(lf)          F.Endereco#(lf)#(lf)    FROM [DW].[logistica].[Fato_ESWM9022] F#(lf)#(lf)    OUTER APPLY (#(lf)        SELECT TOP 1 *#(lf)        FROM [STAGE].[tot].[Item] I#(lf)        WHERE I.[it-codigo] = F.Item#(lf)          AND I.Empresa = '15'#(lf)        ORDER BY I.DATA_ALTERACAO DESC#(lf)    ) I#(lf)#(lf)    WHERE #(lf)          F.local = 'aat'#(lf)          AND NOT (#(lf)                LEN(F.Item) = 9#(lf)                AND LEFT(F.Item, 2) IN ('03','05','06','09','10')#(lf)          )#(lf)),#(lf)TotaisPorEndereco AS (#(lf)    SELECT #(lf)          Endereco,#(lf)          COUNT(DISTINCT Item) AS TotalItens#(lf)    FROM Base#(lf)    GROUP BY Endereco#(lf))#(lf)SELECT #(lf)      B.Item,#(lf)      B.Descricao,#(lf)#(lf)      SUM(B.Total)       AS Total,#(lf)      SUM(B.Reservado)   AS Reservado,#(lf)      SUM(B.Disponivel)  AS Disponivel,#(lf)#(lf)      B.Peso_Liquido,#(lf)      B.Peso_Bruto,#(lf)      B.Comprimento,#(lf)      B.Largura,#(lf)      B.Altura,#(lf)#(lf)      CASE #(lf)            WHEN B.Peso_Liquido > B.Peso_Bruto THEN 'Liquido > Bruto'#(lf)            WHEN B.Peso_Liquido < B.Peso_Bruto THEN 'Bruto > Liquido'#(lf)            ELSE 'Liquido = Bruto'#(lf)      END AS Status_Peso,#(lf)#(lf)      CASE #(lf)            WHEN B.Peso_Liquido <> 0#(lf)             AND B.Peso_Bruto  <> 0#(lf)             AND B.Comprimento <> 0#(lf)             AND B.Largura     <> 0#(lf)             AND B.Altura      <> 0#(lf)             AND B.Peso_Liquido = B.Peso_Bruto#(lf)            THEN 'Cadastrado'#(lf)            ELSE 'Não Cadastrado'#(lf)      END AS Status,#(lf)#(lf)      B.DATA_ALTERACAO,#(lf)      B.Endereco,#(lf)      T.TotalItens#(lf)#(lf)FROM Base B#(lf)JOIN TotaisPorEndereco T#(lf)      ON T.Endereco = B.Endereco#(lf)#(lf)GROUP BY #(lf)      B.Item,#(lf)      B.Descricao,#(lf)      B.Peso_Liquido,#(lf)      B.Peso_Bruto,#(lf)      B.Comprimento,#(lf)      B.Largura,#(lf)      B.Altura,#(lf)      B.DATA_ALTERACAO,#(lf)      B.Endereco,#(lf)      T.TotalItens;#(lf)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

