	partition Dim_Ordenacao_Status = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT DISTINCT#(lf)#(tab)StatusOnda,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN StatusOnda = 'Não Integrado' THEN 0#(lf)#(tab)#(tab)WHEN StatusOnda = 'Em Separação' THEN 1#(lf)#(tab)#(tab)WHEN StatusOnda = 'Conferido Linha' THEN 2#(lf)#(tab)#(tab)WHEN StatusOnda = 'Stage Conferência' THEN 3#(lf)#(tab)#(tab)WHEN StatusOnda = 'Expedido' THEN 4#(lf)#(tab)#(tab)ELSE 5#(lf)#(tab)END AS IdStatusOnda#(lf)FROM logistica.Fato_FTB101"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

