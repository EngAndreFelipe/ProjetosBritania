	column MesAno = FORMAT(f_PDB381[DataSaida], "YYYYMM")
		lineageTag: 0717bafa-d7e1-473e-acac-fe1b622c7b0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DiasExp =
			
			var dtmin = IF(ISBLANK(f_PDB381[DataEmbarque]), f_PDB381[DtFaturamento], f_PDB381[DataEmbarque])
			var dtmax = f_PDB381[DataSaida]
			var calc = CALCULATE(
			        SUM(d_Calendario[DiaUtilCalc]),
			        DATESBETWEEN(d_Calendario[Calendario], dtmin, dtmax)
			    ) - 1
			RETURN
			    IF(calc < 0, 0, calc)
		lineageTag: 1e6221f0-544c-4456-b32a-44225d984306
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DiasUteisOs =
			
			var dtmin = f_PDB381[DataImplantacao]
			var dtmax = f_PDB381[DataSaida]
			var calc = CALCULATE(
			        SUM(d_Calendario[DiaUtilCalc]),
			        DATESBETWEEN(d_Calendario[Calendario], dtmin, dtmax)
			    ) - 1
			RETURN
			    IF(calc < 0, 0, calc)
		formatString: 0
		lineageTag: 7d38bf2d-8b15-4240-b184-9e86ded66fbc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition f_PDB381 = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataImplantacao DATE = EOMONTH(DATEADD(MONTH, -4, GETDATE()));#(lf)DECLARE @DataSaida DATE = EOMONTH(DATEADD(MONTH, -2, GETDATE()));#(lf)#(lf)-- Valida se tabela Temp existe e Deleta#(lf)IF OBJECT_ID('tempdb..#Filtered_PDB') IS NOT NULL#(lf)    DROP TABLE #Filtered_PDB;#(lf)#(lf)-- Cria Tabela Temporaria#(lf)SELECT #(lf)    NumeroPedido,#(lf)    DataImplantacao,#(lf)    NumeroOS,#(lf)    DataOS,#(lf)#(tab)CodEmitente,#(lf)    NomeMatriz,#(lf)    Cidade,#(lf)    EstadoEntrega,#(lf)    CodItem,#(lf)    DescItem,#(lf)    NatOperacao,#(lf)    Denominacao,#(lf)    QuantidadeAtendida,#(lf)    DtFaturamento,#(lf)    Embarque,#(lf)    DataEmbarque,#(lf)    DataSaida,#(lf)    NotaFiscal,#(lf)    SerieNotaFiscal,#(lf)    EstabNotaFiscal,#(lf)    Inventario,#(lf)    SitCreditoPed,#(lf)    CreditoPosto,#(lf)    PedidoCompleto,#(lf)    SitPedido,#(lf)    CreditoCliente,#(lf)    SitCredenciamento,#(lf)    SitItem,#(lf)    SaldoAAT,#(lf)    SaldoREC#(lf)INTO #Filtered_PDB#(lf)FROM DW.logistica.Fato_PDB381 WITH (NOLOCK)#(lf)WHERE #(lf)    DataImplantacao > @DataImplantacao#(lf)#(tab)AND DataSaida > @DataSaida#(lf)    AND SitPedido IN('2','3','5')#(lf)    AND SerieNotaFiscal IN (5, 21);#(lf)#(lf)-- Consulta Log de Erro FTB400#(lf)WITH ConsLog AS(#(lf)#(tab)SELECT  DISTINCT #(lf)#(tab)#(tab)lg.POSTO,#(lf)#(tab)#(tab)FORMAT(lg.DATA_ARQUIVO, 'yyyyMM') AS ANO_MES,#(lf)#(tab)#(tab)lg.PEDIDO + CAST(lg.POSTO AS VARCHAR) AS ChvPedCliente,#(lf)#(tab)#(tab)'Log Erro' AS LOG_ERRO#(tab)#(tab)#(lf)#(tab)FROM STAGE.excel.LogErroFTB400 lg WITH (NOLOCK)#(lf)#(tab)WHERE DATA_ARQUIVO > @DataSaida#(lf)#(tab)#(tab)AND NOT EXISTS (#(lf)#(tab)#(tab)#(tab)SELECT 1#(lf)#(tab)#(tab)#(tab)FROM (VALUES #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('Estado diferente'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('Natureza em garantia e emite duplicata'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('Emitente fora da faixa'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('atendido total ou cance'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('embarcado ou faturado'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)('')#(lf)#(tab)#(tab)#(tab)#(tab))AS l(Descricao)#(lf)#(tab)#(tab)#(tab)WHERE CHARINDEX(l.Descricao, lg.LOG_DE_ERRO) > 0#(lf)#(tab)#(tab)#(tab))#(lf)),#(lf)-- Busca Polegada Display#(lf)tDisplay AS(#(lf)#(tab)SELECT td.CodItem,#(lf)#(tab)#(tab)td.DescItem,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN CHARINDEX('.', SUBSTRING(td.DescItem, CHARINDEX('POL', td.DescItem)-2,2)) > 0 THEN#(lf)#(tab)#(tab)#(tab)#(tab)SUBSTRING(td.DescItem, CHARINDEX('POL', td.DescItem)-4,4)#(lf)#(tab)#(tab)#(tab)WHEN CHARINDEX('POL', td.DescItem) > 0 THEN#(lf)#(tab)#(tab)#(tab)#(tab)SUBSTRING(td.DescItem, CHARINDEX('POL', td.DescItem)-2,2)#(lf)#(tab)#(tab)#(tab)WHEN CHARINDEX('PTV', td.DescItem) > 0 THEN#(lf)#(tab)#(tab)#(tab)#(tab)SUBSTRING(td.DescItem, CHARINDEX('PTV', td.DescItem)+3,2)#(lf)#(tab)#(tab)#(tab)WHEN CHARINDEX('BTV', td.DescItem) > 0 THEN#(lf)#(tab)#(tab)#(tab)#(tab)SUBSTRING(td.DescItem, CHARINDEX('BTV', td.DescItem)+3,2)#(lf)#(tab)#(tab)#(tab)WHEN CHARINDEX('PH', td.DescItem) > 0 THEN#(lf)#(tab)#(tab)#(tab)#(tab)SUBSTRING(td.DescItem, CHARINDEX('PH', td.DescItem)+2,2)#(lf)#(tab)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END Polegada#(lf)#(tab)FROM (SELECT DISTINCT #(lf)#(tab)#(tab)#(tab)CodItem,#(lf)#(tab)#(tab)#(tab)REPLACE(DescItem, ' POL','POL') DescItem#(lf)#(tab)#(tab)FROM dbo.Dim_Item#(lf)#(tab)#(tab)WHERE (DescItem LIKE '%POL%'#(lf)#(tab)#(tab)#(tab)#(tab)OR DescItem LIKE '%PTV%'#(lf)#(tab)#(tab)#(tab)#(tab)OR DescItem LIKE '%BTV%'#(lf)#(tab)#(tab)#(tab)#(tab)OR DescItem LIKE '%TV PH%')#(lf)#(tab)#(tab)#(tab)AND (DescFamiliaComl LIKE '%TV%'#(lf)#(tab)#(tab)#(tab)#(tab)OR DescFamiliaComl LIKE '%TAB%')#(lf)#(tab)#(tab)#(tab)AND DescItem NOT LIKE '%PCI%'#(lf)#(tab)#(tab)#(tab)AND DescItem NOT LIKE '%INJETORA%'#(lf)#(tab)#(tab)#(tab)AND #(lf)#(tab)#(tab)#(tab)(DescItem LIKE 'DISPLAY%' #(lf)#(tab)#(tab)#(tab)OR DescItem LIKE 'TELA LCD%' #(lf)#(tab)#(tab)#(tab)OR DescItem LIKE 'TELA DE CRIST%' #(lf)#(tab)#(tab)#(tab)OR DescItem LIKE 'TELA DISPLAY%')#(lf)#(tab)#(tab))td#(lf)),#(lf)#(lf)-- Consulta Display#(lf)vDisplay AS(#(lf)#(tab)SELECT DISTINCT #(lf)#(tab)#(tab)it.CodItem,#(lf)#(tab)#(tab)MAX(#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN it.DescItem LIKE 'DISPLAY%' THEN 'DISPLAY'#(lf)#(tab)#(tab)  #(tab)WHEN it.DescItem LIKE 'TELA LCD%' THEN 'DISPLAY'#(lf)#(tab)#(tab)  #(tab)WHEN it.DescItem LIKE 'TELA DE CRIST%' THEN 'DISPLAY'#(lf)#(tab)#(tab)  #(tab)WHEN it.DescItem LIKE 'TELA DISPLAY%' THEN 'DISPLAY'#(lf)#(tab)#(tab)END#(lf)#(tab)#(tab))ValidaDisplay#(lf)#(tab)FROM DW.dbo.Dim_Item it WITH (NOLOCK)#(lf)#(tab)GROUP BY it.CodItem#(lf))#(lf)--#(lf)-- Tabela Principal#(lf)SELECT#(lf)    pdb.NumeroPedido,#(lf)    CAST(pdb.DataImplantacao AS DATE) DataImplantacao,#(lf)    pdb.NumeroOS,#(lf)    pdb.DataOS,#(lf)    pdb.NomeMatriz,#(lf)    pdb.Cidade,#(lf)    pdb.EstadoEntrega,#(lf)    pdb.CodItem,#(lf)    pdb.DescItem,#(lf)    pdb.NatOperacao,#(lf)    pdb.Denominacao,#(lf)    CAST(pdb.QuantidadeAtendida AS INT) AS QuantidadeAtendida,#(lf)    CAST(pdb.DtFaturamento AS DATE) DtFaturamento,#(lf)    pdb.Embarque,#(lf)    CAST(pdb.DataEmbarque AS DATE) DataEmbarque,#(lf)    CAST(pdb.DataSaida AS DATE) DataSaida,#(lf)    pdb.NotaFiscal,#(lf)    pdb.SerieNotaFiscal,#(lf)    pdb.EstabNotaFiscal,#(lf)    CAST(pdb.Inventario AS INT) AS Inventario,#(lf)    pdb.SitCreditoPed,#(lf)    pdb.CreditoPosto,#(lf)    pdb.PedidoCompleto,#(lf)    sp.DescSitPedido AS SitPedido, --pdb.SitPedido,#(lf)    CASE #(lf)        WHEN pdb.CreditoCliente NOT IN(2,4) THEN 'Sim'#(lf)        ELSE 'Não'#(lf)    END CreditoCliente,#(lf)    CASE#(lf)        WHEN UPPER(pdb.SitCredenciamento) = 'N' THEN 'Descredenciado'#(lf)        ELSE 'Credenciado'#(lf)    END SitCredenciamento,#(lf)    pdb.SitItem,#(lf)    pdb.SaldoAAT,#(lf)    pdb.SaldoREC,#(lf)#(tab)-- VALIDAÇÃO DISPLAY#(lf)#(tab)vd.ValidaDisplay,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN vd.ValidaDisplay IS NOT NULL AND td.Polegada IS NULL THEN '5'#(lf)#(tab)#(tab)ELSE td.Polegada#(lf)#(tab)END Polegada,#(lf)#(tab) --INDICE DE RECLAMAÇÃO DOS POSTOS#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPE' THEN '-Errado'#(lf)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPQ' THEN '-Qudebrado'#(lf)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPF' THEN '-Faltante'#(lf)#(tab)#(tab)ELSE NULL#(lf)#(tab)END IRP,#(lf)#(tab)-- CONSULTA LOG DE ERRO#(lf)#(tab)cl.LOG_ERRO,#(lf)#(tab)#(lf)#(tab)UPPER(pdb.Cidade) + ', ' + pdb.EstadoEntrega AS CidadeUF,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN RIGHT(UPPER(pdb.NumeroOS), 2) = 'EP' THEN 'SEM OS'#(lf)#(tab)#(tab)WHEN ISNULL(pdb.NumeroOS, '') <> '' THEN 'COM OS'#(lf)#(tab)#(tab)ELSE 'SEM OS'#(lf)#(tab)END PedidoOS#(lf)FROM #Filtered_PDB pdb#(lf)#(tab)LEFT JOIN vDisplay vd#(lf)#(tab)#(tab)ON pdb.CodItem = vd.CodItem#(lf)#(tab)LEFT JOIN tDisplay td#(lf)#(tab)#(tab)ON pdb.CodItem = td.CodItem#(lf)#(tab)LEFT JOIN dbo.Dim_SituacaoPedido sp WITH (NOLOCK)#(lf)#(tab)#(tab)ON pdb.SitPedido = sp.CodSitPed#(lf)#(tab)LEFT JOIN ConsLog cl WITH (NOLOCK)#(lf)#(tab)#(tab)ON FORMAT(pdb.DataSaida, 'yyyyMM') = cl.ANO_MES#(lf)#(tab)#(tab)#(tab)AND pdb.NumeroPedido + CAST(pdb.CodEmitente AS VARCHAR) = cl.ChvPedCliente#(lf)#(tab)--Desconsidera Notas Canceladas#(lf)#(tab)LEFT JOIN auditoria.Fato_CustosFrete_Faturamento acf WITH (NOLOCK)#(lf)#(tab)#(tab)ON pdb.NotaFiscal = acf.NumeroNotaFiscal#(lf)#(tab)#(tab)#(tab)AND pdb.SerieNotaFiscal = acf.SerieNotaFiscal#(lf)#(tab)#(tab)#(tab)AND acf.DataEmissaoNotaFiscal > @DataSaida#(lf)#(lf)WHERE acf.IdDataCancelamento IS NULL#(lf)-- Deleta Tabela Temp#(lf)DROP TABLE  #Filtered_PDB;"])
				in
