	partition d_Calendario = m
		mode: import
		source = ```
				let
				    Calendario_ = 
				        Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)#(tab)CAST(Data AS DATE) Calendario,#(lf)#(tab)DiaSemana,#(lf)#(tab)DiaSemanaNome,#(lf)#(tab)DiaSemanaAno,#(lf)#(tab)Mes,#(lf)#(tab)MesNome,#(lf)#(tab)Ano,#(lf)#(tab)MMYYYY MesAno#(lf)#(lf)FROM dbo.Dim_Data#(lf)WHERE Data >= DATEADD(DAY, 1, EOMONTH(DATEADD(MONTH, -4,CAST(GETDATE() AS DATE))))#(lf)"])
				in
				    Calendario_
				```

