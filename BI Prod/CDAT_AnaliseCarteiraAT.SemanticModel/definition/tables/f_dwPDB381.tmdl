	partition f_dwPDB381 = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataInicial DATE = EOMONTH(DATEADD(MONTH, -3,CAST(GETDATE() AS DATE)));#(lf)#(lf)-- Valida se tabela Temp existe e Deleta#(lf)IF OBJECT_ID('tempdb..#Filtered_PDB') IS NOT NULL#(lf)    DROP TABLE #Filtered_PDB;#(lf)#(lf)SELECT *#(lf)INTO #Filtered_PDB#(lf)FROM DW.logistica.Fato_PDB381 WITH (NOLOCK)#(lf)WHERE DataImplantacao > @DataInicial#(lf)#(tab)AND SitPedido IN('1','2','5')#(lf)#(tab)AND DataSaida IS NULL#(lf)#(tab)AND SerieNotaFiscal IN (5, 21, '');#(lf)#(lf)WITH UltimaDataCE AS (#(lf)    SELECT DISTINCT MAX(Data) AS MaxData#(lf)    FROM logistica.Fato_CE0919 WITH (NOLOCK)#(lf)    WHERE Data > DATEADD(DAY, -4, CAST(GETDATE() AS DATE))#(lf)),#(lf)GE_SldDcv AS (#(lf)#(tab)SELECT#(lf)#(tab)#(tab)CAST(DT.Data as Date) Data#(lf)#(tab)#(tab),I.CodItem#(lf)#(tab)#(tab),D.CodigoDeposito#(tab)#(lf)#(tab)#(tab),CAST(F.QuantidadeDisponivel AS INT) SldDcv#(lf)#(tab)#(tab),I.CodGrupoEstoque#(lf)#(tab)FROM [DW].[dbo].[Fato_SaldoEstoque] F WITH (NOLOCK)#(lf)#(tab)#(tab)JOIN [DW].[dbo].[Dim_Item] I WITH (NOLOCK) #(lf)#(tab)#(tab)#(tab)ON I.Id = F.IdItem#(lf)#(tab)#(tab)JOIN [DW].[dbo].[Dim_Localizacao] L WITH (NOLOCK) #(lf)#(tab)#(tab)#(tab)ON L.IdLocalizacao = F.IdLocalizacao#(lf)#(tab)#(tab)JOIN [DW].[dbo].[Dim_Deposito] D WITH (NOLOCK) #(lf)#(tab)#(tab)#(tab)ON D.IdDeposito = L.IdDeposito#(lf)#(tab)#(tab)JOIN [DW].[dbo].[Dim_Estabelecimento] Est WITH (NOLOCK) #(lf)#(tab)#(tab)#(tab)ON L.idEstab = Est.Id#(lf)#(tab)#(tab)JOIN [DW].[dbo].[Dim_Data] DT WITH (NOLOCK) #(lf)#(tab)#(tab)#(tab)ON DT.Id = F.IdData#(lf)#(tab)WHERE 1 = 1#(lf)#(tab)#(tab)AND I.CodGrupoEstoque IN ('0','1','2','7','14','16','19','27')#(lf)#(tab)#(tab)AND L.idEstab IN ('8')#(lf)#(tab)#(tab)AND D.CodigoDeposito = 'DCV'#(lf)#(tab)#(tab)AND Data = (SELECT MaxData FROM UltimaDataCE)#(lf)),#(lf)SaldoItem AS (#(lf)#(tab)SELECT DISTINCT DataImplantacao  #(lf)#(tab),NumeroPedido#(lf)#(tab),CodItem#(lf)#(tab),QuantidadePedida#(lf)#(tab),SUM(QuantidadePedida) OVER (PARTITION BY CodItem ORDER BY DataImplantacao ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW#(lf)    ) AS  QtTotalPedItem#(lf)#(tab)FROM #Filtered_PDB#(lf)),#(lf)QtdeItemOS AS (#(lf)#(tab)SELECT sub.NumeroOs,#(lf)#(tab)#(tab)COUNT(*) AS QtItemOs#(lf)#(tab)FROM (SELECT DISTINCT#(lf)#(tab)#(tab)#(tab)NumeroOS,#(lf)#(tab)#(tab)#(tab)CodItem#(lf)#(tab)#(tab)FROM #Filtered_PDB#(lf)#(tab)#(tab)WHERE NumeroOS <> ''#(lf)#(tab)) sub#(lf)#(tab)GROUP BY sub.NumeroOs#(lf)),#(lf)QtdPedOS AS (#(lf)#(tab)SELECT NumeroOs,#(lf)#(tab)#(tab)CodItem,#(lf)#(tab)#(tab)SUM(QuantidadePedida) AS QtPedOs#(lf)#(tab)FROM #Filtered_PDB#(lf)#(tab)WHERE NumeroOS <> ''#(lf)#(tab)GROUP BY #(lf)#(tab)#(tab)NumeroOs,#(lf)#(tab)#(tab)CodItem#(lf)),#(lf)SaldoPedOS AS (#(lf)#(tab)SELECT NumeroOs,#(lf)#(tab)#(tab)ROUND(AVG(SaldoAAT),0) AS SldPedOs#(lf)#(tab)FROM #Filtered_PDB#(lf)#(tab)WHERE NumeroOS <> ''#(lf)#(tab)GROUP BY #(lf)#(tab)#(tab)NumeroOs#(lf)),#(lf)SaldoMinOS AS (#(lf)#(tab)SELECT NumeroOs,#(lf)#(tab)#(tab)MIN(SaldoAAT) AS SldMinOs#(lf)#(tab)FROM #Filtered_PDB#(lf)#(tab)WHERE NumeroOS <> ''#(lf)#(tab)GROUP BY #(lf)#(tab)#(tab)NumeroOs#(lf)),#(lf)Filtro_PDB_2 AS(#(lf)#(tab)SELECT#(lf)#(tab)#(tab)pdb.NumeroPedido,#(lf)#(tab)#(tab)CAST(pdb.DataImplantacao AS DATE) DataImplantacao,#(lf)#(tab)#(tab)pdb.NumeroOS,#(lf)#(tab)#(tab)pdb.DataOS,#(lf)#(tab)#(tab)pdb.NomeMatriz,#(lf)#(tab)#(tab)pdb.Cidade,#(lf)#(tab)#(tab)pdb.EstadoEntrega,#(lf)#(tab)#(tab)pdb.CodItem,#(lf)#(tab)#(tab)pdb.DescItem,#(lf)#(tab)#(tab)pdb.NatOperacao,#(lf)#(tab)#(tab)pdb.Denominacao,#(lf)#(tab)#(tab)pdb.QuantidadePedida,#(lf)#(tab)#(tab)pdb.QuantidadeAtendida,#(lf)#(tab)#(tab)pdb.QuantidadeAlocada,#(lf)#(tab)#(tab)pdb.QuantidadeCarteira,#(lf)#(tab)#(tab)CAST(pdb.DtFaturamento AS DATE) DtFaturamento,#(lf)#(tab)#(tab)pdb.NumEmbarquePreFatur,#(lf)#(tab)#(tab)pdb.Embarque,#(lf)#(tab)#(tab)CAST(pdb.DataEmbarque AS DATE) DataEmbarque,#(lf)#(tab)#(tab)CAST(pdb.DataSaida AS DATE) DataSaida,#(lf)#(tab)#(tab)pdb.NotaFiscal,#(lf)#(tab)#(tab)pdb.SerieNotaFiscal,#(lf)#(tab)#(tab)pdb.EstabNotaFiscal,#(lf)#(tab)#(tab)pdb.DispPreFat,#(lf)#(tab)#(tab)pdb.Inventario,#(lf)#(tab)#(tab)pdb.SitCreditoPed,#(lf)#(tab)#(tab)pdb.CreditoPosto,#(lf)#(tab)#(tab)pdb.PedidoCompleto,#(lf)#(tab)#(tab)sp.DescSitPedido AS SitPedido, --pdb.SitPedido,#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN pdb.CreditoCliente NOT IN(2,4) THEN 'Sim'#(lf)#(tab)#(tab)#(tab)ELSE 'Não'#(lf)#(tab)#(tab)END CreditoCliente,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN UPPER(pdb.SitCredenciamento) = 'N' THEN 'Descredenciado'#(lf)#(tab)#(tab)#(tab)ELSE 'Credenciado'#(lf)#(tab)#(tab)END SitCredenciamento,#(lf)#(tab)#(tab)pdb.SitItem,#(lf)#(tab)#(tab)pdb.SaldoAAT,#(lf)#(tab)#(tab)pdb.SaldoREC,#(lf)#(tab)#(tab)COALESCE(gesd.SldDcv, 0) Saldo_DCV,#(lf)#(tab)#(tab)si.QtTotalPedItem,#(lf)#(tab)#(tab)qios.QtItemOs,#(lf)#(tab)#(tab)qpos.QtPedOs,#(lf)#(tab)#(tab)sldos.SldPedOs,#(lf)#(tab)#(tab)--'Pedido Não Parovado'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.SitCreditoPed <> 'Aprovado' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_PedidoAprovado,#(lf)#(tab)#(tab)--'Suspenso'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN sp.DescSitPedido = 'Suspenso' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_PedSuspenso,#(lf)#(tab)#(tab)--'Pedido Incompleto'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.PedidoCompleto <> 'Sim' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_PedCompleto,#(lf)#(tab)#(tab)--'Saldo Rec'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN ((COALESCE(gesd.SldDcv, 0) + pdb.SaldoAAT) < si.QtTotalPedItem)#(lf)#(tab)#(tab)#(tab)#(tab)AND (pdb.SaldoREC >= (si.QtTotalPedItem - (COALESCE(gesd.SldDcv, 0) + pdb.SaldoAAT))) THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_Rec,#(lf)#(tab)#(tab)--'Sem Saldo'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN ((pdb.SaldoAAT + pdb.SaldoREC) = 0 OR pdb.SaldoAAT + pdb.SaldoREC < si.QtTotalPedItem)#(lf)#(tab)#(tab)#(tab)#(tab)AND COALESCE(gesd.SldDcv, 0) < si.QtTotalPedItem THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_SemSaldo,#(lf)#(tab)#(tab)--'Inventario'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.Inventario = '1' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_Inventario,#(lf)#(tab)#(tab)--'Posto Bloqueado'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.CreditoPosto = 'Suspenso' OR pdb.CreditoPosto = 'Só Imprime Pedidos' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_PostoBloq,#(lf)#(tab)#(tab)--'Posto Sem Credito'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.CreditoCliente IN(2,4) THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_CreditoCliente,#(lf)#(tab)#(tab)--'Bloq Pre Fatura'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN UPPER(pdb.DispPreFat) <> 'SIM' THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_BloqPreFat,#(lf)#(tab)#(tab)--'DCV'#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN (pdb.SaldoAAT < si.QtTotalPedItem AND COALESCE(gesd.SldDcv, 0) >= si.QtTotalPedItem) THEN 1#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)END B_Dcv#(lf)#(tab)FROM #Filtered_PDB pdb#(lf)#(tab)#(tab)LEFT JOIN GE_SldDcv gesd#(lf)#(tab)#(tab)#(tab)ON pdb.CodItem = gesd.CodItem#(lf)#(tab)#(tab)LEFT JOIN dbo.Dim_SituacaoPedido sp#(lf)#(tab)#(tab)#(tab)ON pdb.SitPedido = sp.CodSitPed#(lf)#(tab)#(tab)LEFT JOIN SaldoItem si#(lf)#(tab)#(tab)#(tab)ON pdb.CodItem = si.CodItem#(lf)#(tab)#(tab)#(tab)#(tab)AND pdb.DataImplantacao = si.DataImplantacao#(lf)#(tab)#(tab)#(tab)#(tab)AND  pdb.NumeroPedido =si.NumeroPedido#(lf)#(tab)#(tab)LEFT JOIN QtdeItemOS qios #(lf)#(tab)#(tab)#(tab)ON pdb.NumeroOS = qios.NumeroOS#(lf)#(tab)#(tab)LEFT JOIN QtdPedOS qpos #(lf)#(tab)#(tab)#(tab)ON pdb.NumeroOS = qpos.NumeroOS#(lf)#(tab)#(tab)#(tab)#(tab)AND pdb.CodItem = qpos.CodItem#(lf)#(tab)#(tab)LEFT JOIN SaldoPedOS sldos #(lf)#(tab)#(tab)#(tab)ON pdb.NumeroOS = sldos.NumeroOS#(lf)#(tab)#(tab)LEFT JOIN SaldoMinOS sminos#(lf)#(tab)#(tab)#(tab)ON sminos.NumeroOS = pdb.NumeroOS#(lf))#(lf)SELECT *,#(lf)#(tab)(B_PedidoAprovado + B_PedSuspenso + B_PedCompleto + B_Rec + B_SemSaldo + #(lf)#(tab)#(tab)B_Inventario + B_PostoBloq + B_CreditoCliente + B_BloqPreFat + B_Dcv) AS SumBloq,#(lf)#(tab)CONCAT(#(lf)#(tab)#(tab)B_PedidoAprovado, B_PedSuspenso, B_PedCompleto, B_Rec, B_SemSaldo, #(lf)#(tab)#(tab)B_Inventario, B_PostoBloq, B_CreditoCliente, B_BloqPreFat, B_Dcv#(lf)#(tab)) AS ChvBloq,#(lf)#(tab)LEFT(#(lf)#(tab)#(tab)CONCAT(#(lf)#(tab)#(tab)#(tab)B_PedidoAprovado, B_PedSuspenso, B_PedCompleto, B_Rec, B_SemSaldo, #(lf)#(tab)#(tab)#(tab)B_Inventario, B_PostoBloq, B_CreditoCliente, B_BloqPreFat, B_Dcv#(lf)#(tab)#(tab)),#(lf)#(tab)#(tab)CHARINDEX('1', CONCAT(#(lf)#(tab)#(tab)#(tab)B_PedidoAprovado, B_PedSuspenso, B_PedCompleto, B_Rec, B_SemSaldo, #(lf)#(tab)#(tab)#(tab)B_Inventario, B_PostoBloq, B_CreditoCliente, B_BloqPreFat, B_Dcv#(lf)#(tab)#(tab)))#(lf)#(tab)) AS ChvBloqUnico#(lf)FROM Filtro_PDB_2#(lf)#(lf) DROP TABLE #Filtered_PDB"])
				in
				    Fonte

