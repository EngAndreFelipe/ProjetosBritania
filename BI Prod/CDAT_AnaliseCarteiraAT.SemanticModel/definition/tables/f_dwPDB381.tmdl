	column sBloqAcm = CALCULATE(SUM(f_dwPDB381[SumBloq]), ALLEXCEPT(f_dwPDB381, f_dwPDB381[NumeroOS]))
		formatString: 0
		lineageTag: 2364c764-bca8-4acb-bd9a-3fe2ea4d20bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ChvBloq_ = IF(f_dwPDB381[OS] = "COM OS" && f_dwPDB381[QtItemOs] > 1 && f_dwPDB381[sBloqAcm] > 0, CONCATENATE(f_dwPDB381[ChvBloq],1), CONCATENATE(f_dwPDB381[ChvBloq],0))
		lineageTag: 1c8061b1-fdff-4e06-b2fa-f72d5a128230
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ChvBloqUnico_ = ```
			VAR Pos = SEARCH("1", f_dwPDB381[ChvBloq_], 1, 0)
			RETURN
			    IF(
			        Pos > 0,
			        LEFT(f_dwPDB381[ChvBloq_], SEARCH("1", f_dwPDB381[ChvBloq_], 1, 0)) ,
			        BLANK() 
			    )
			```
		lineageTag: aa41e29f-811a-4424-8b03-0ce749d6e0f7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

