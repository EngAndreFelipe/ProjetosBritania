	measure 'Frete Fixo Total' = ```
			
			VAR TabelaRotaUnica = 
			    SUMMARIZE(
			        'Tabelas_Transportadoras',
			        'Tabelas_Transportadoras'[Cod_Transportadora],
			        'Tabelas_Transportadoras'[Num_Tabela],
			        'Tabelas_Transportadoras'[Num_Rota],
			        'Tabelas_Transportadoras'[Cod_Faixa],
			        'Tabelas_Transportadoras'[Cod_Componente]
			    )
			
			RETURN
			SUMX(
			    TabelaRotaUnica,
			    VAR Transp = 'Tabelas_Transportadoras'[Cod_Transportadora]
			    VAR Comp = 'Tabelas_Transportadoras'[Cod_Componente]
			    
			    -- O CALCULATE(MAX(...)) aqui dentro é o que impede a soma pelas cidades
			    RETURN
			    SWITCH( TRUE(),
			        -- REGRA TRANSPORTADORA 111957
			        Transp = "111957" && Comp = "FRETE VOLUME", CALCULATE(MAX('Tabelas_Transportadoras'[Valor_Fixo])),
			        Transp = "111957" && Comp = "PEDAGIO",      CALCULATE(MAX('Tabelas_Transportadoras'[Valor_Unitario])),
			        
			        -- REGRA GERAL (Demais Transportadoras)
			        Transp <> "111957" && Comp = "FRETE UNIDADE", CALCULATE(MAX('Tabelas_Transportadoras'[Valor_Fixo])),
			        Transp <> "111957" && Comp = "TAXA CTRC",     CALCULATE(MAX('Tabelas_Transportadoras'[Valor_Fixo])),
			        Transp <> "111957" && Comp = "PEDAGIO",       CALCULATE(MAX('Tabelas_Transportadoras'[Valor_Fixo])),
			        
			        0
			    )
			)
			```
		lineageTag: 9653df64-dd6a-4750-b2d2-7393c5125f81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtro Faixa Automatica' = ```
			
			-- Captura o que você digitou na caixinha
			VAR PesoDigitado = [Valor Peso_Simulados] 
			
			-- Identifica a faixa de peso da linha atual
			VAR FaixaDaLinha = SELECTEDVALUE('Tabelas_Transportadoras'[Limite_Peso_Faixa])
			
			-- Descobre qual é a menor faixa cadastrada que ainda suporta o peso digitado
			VAR FaixaAlvo = 
			    MINX(
			        FILTER(
			            ALL('Tabelas_Transportadoras'),
			            'Tabelas_Transportadoras'[Limite_Peso_Faixa] >= PesoDigitado
			        ),
			        'Tabelas_Transportadoras'[Limite_Peso_Faixa]
			    )
			
			RETURN
			-- Se a faixa da linha for a faixa que o cálculo escolheu, retorna 1
			IF(FaixaDaLinha = FaixaAlvo, 1, 0)
			```
		formatString: 0
		lineageTag: 456a92e3-8208-44c3-95fd-276a0bf0e736

	measure '% QtFaturada por TipoProduto' =
			
			DIVIDE(
			    SUM(Fato_Itens_Cobrados[QtFaturadaItem]),
			    CALCULATE(
			        SUM(Fato_Itens_Cobrados[QtFaturadaItem]),
			        ALL(Fato_Itens_Cobrados[TipoProduto])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e4522bf0-d416-40c8-9e93-38520e998fd7

