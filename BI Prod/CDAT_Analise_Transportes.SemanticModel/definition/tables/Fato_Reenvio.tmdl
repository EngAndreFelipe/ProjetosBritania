		sourceColumn: TipoReenvio

		annotation SummarizationSetBy = Automatic

	partition Fato_Reenvio = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf)      [NumeroPedido],#(lf)      [NumeroPedidoRepres],#(lf)      [DataImplantacao],#(lf)      [NumeroOS],#(lf)     #(lf)      [CodEmitente],#(lf)      [NomeMatriz],#(lf)      [Cidade],#(lf)      [EstadoEntrega],#(lf)      [CodItem],#(lf)      [DescItem],#(lf)    #(lf)      [NatOperacao],#(lf)      [Denominacao],#(lf)#(lf)      FORMAT([QuantidadePedida], 'N2', 'pt-BR') AS QuantidadePedida,#(lf)      FORMAT([QuantidadeAtendida], 'N2', 'pt-BR') AS QuantidadeAtendida,#(lf)      FORMAT([QuantidadeAlocada], 'N2', 'pt-BR') AS QuantidadeAlocada,#(lf)      FORMAT([QuantidadeCarteira], 'N2', 'pt-BR') AS QuantidadeCarteira,#(lf)#(lf)      [DtFaturamento],#(lf)      #(lf)      [Embarque],#(lf)      [DataEmbarque],#(lf)      [DataSaida],#(lf)      [NotaFiscal],#(lf)      [SerieNotaFiscal],#(lf)      #(lf)      #(lf)#(lf)      CASE#(lf)          WHEN NumeroPedido LIKE '%RPD' THEN 'Defeito'#(lf)          WHEN NumeroPedido LIKE '%RPE' THEN 'Errada'#(lf)          WHEN NumeroPedido LIKE '%RPF' THEN 'Faltando'#(lf)          WHEN NumeroPedido LIKE '%RPI' THEN 'Identificação'#(lf)          WHEN NumeroPedido LIKE '%RPO' THEN 'Outros'#(lf)          WHEN NumeroPedido LIKE '%RPQ' THEN 'Quebrado'#(lf)          WHEN NumeroPedido LIKE '%RPT' THEN 'Transportadora'#(lf)          ELSE NULL#(lf)      END AS TipoReenvio#(lf)#(lf)  FROM [DW].[logistica].[Fato_PDB381]#(lf)#(lf)  WHERE DataImplantacao BETWEEN '2025-01-01' AND getdate()#(lf)    AND (#(lf)         NumeroPedido LIKE '%RPD' OR#(lf)         NumeroPedido LIKE '%RPE' OR#(lf)         NumeroPedido LIKE '%RPF' OR#(lf)         NumeroPedido LIKE '%RPI' OR#(lf)         NumeroPedido LIKE '%RPO' OR#(lf)         NumeroPedido LIKE '%RPQ' OR#(lf)         NumeroPedido LIKE '%RPT'#(lf)    )"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

