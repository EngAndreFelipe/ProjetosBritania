	partition Fato_Itens_Cobrados = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT  #(lf)    F.[SerieNotaFiscal],#(lf)    F.[NumeroNotaFiscal],#(lf)    F.[DataEmissaoNotaFiscal],#(lf)    NE.[qt-volumes] AS QtVolumes,#(lf)#(lf)    -- ITEM VINDO DA GWM#(lf)    gwm.GWM_ITEM AS CodItem,#(lf)#(lf)    I.[DescItem],#(lf)    I.[CodFamiliaComl],#(lf)    FC.[DESCRICAO] AS DescFamiliaComercial,#(lf)#(lf)    CASE #(lf)        WHEN NE.[qt-volumes] IS NULL OR NE.[qt-volumes] = 0 THEN 'Complemento'#(lf)        ELSE 'Master'#(lf)    END AS TipoNota,#(lf)   #(lf)    N.[NatOperacao],#(lf)    N.[Denominacao],#(lf)    F.TipoFrete,#(lf)    #(lf)    R.[NomeAbrev] AS Representante,#(lf)    UPPER(CAST(CidadeDestino AS VARCHAR(100)) COLLATE Latin1_General_CI_AI) AS Cidade,#(lf)    F.[EstadoDestino],#(lf)   #(lf)    F.[VlFretePrevisto],#(lf)    F.[VlFretePago],#(lf)    F.[TotalNota],#(lf)    F.[QuantidadeFaturada] AS QtdeFaturadaNota,#(lf)   #(lf)    F.[NumeroRomaneio],#(lf)    F.[SituacaoCalculo],#(lf)    F.[UsuarioCalculo],#(lf)    F.[VolumeM3] * 167 AS PesoCubico,#(lf)    F.[PesoBruto],#(lf)  #(lf)    F.[ChaveNFe],#(lf)#(lf)    -- CLASSIFICAÇÃO DO PRODUTO (SEM LINHA PREMIUM)#(lf)    CASE #(lf)        WHEN LEFT(gwm.GWM_ITEM, 2) IN ('03', '05', '06', '09', '10') THEN 'PRODUTO ACABADO'#(lf)        WHEN UPPER(LEFT(LTRIM(I.DescItem), CHARINDEX(' ', LTRIM(I.DescItem) + ' ') - 1)) IN ('TELA', 'DISPLAY') #(lf)             AND I.CodFamiliaComl = '07672' THEN 'DISPLAY'#(lf)        ELSE 'PEÇA'#(lf)    END AS TipoProduto,#(lf)#(lf)    UPPER(LEFT(LTRIM(I.DescItem), CHARINDEX(' ', LTRIM(I.DescItem) + ' ') - 1)) AS Produto,#(lf)#(lf)    F.[NomeTransportadoraNF],#(lf)    F.[DataCarga],#(lf)#(lf)    -- CAMPOS DA GWM#(lf)    gwm.GWM_CDTRP,#(lf)    gwm.GWM_SERDOC,#(lf)    gwm.GWM_NRDOC,#(lf)    gwm.GWM_SEQGW8,#(lf)    gwm.GWM_ITEM,#(lf)    gwm.GWM_CDTPDC,#(lf)    gwm.GWM_VLFRE1,#(lf)#(lf)    -- QT FATURADA DO TOT FORMATADA#(lf)    CAST(itnf.qtFaturada AS INT) AS QtFaturadaItem#(lf),#(lf)#(lf)    CASE #(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%correi%' THEN 'CORREIOS'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%braspre%' THEN 'BRASPRESS'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%expresso%' THEN 'PRINCESA'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%rodonav%' THEN 'RODONAVES'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%berto%' THEN 'BERTOLINI'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%icar%' THEN 'ICARO'#(lf)        WHEN F.[NomeMatrizTransportador] COLLATE Latin1_General_CI_AI LIKE '%solist%' THEN 'SOLISTICA'#(lf)        ELSE F.[NomeMatrizTransportador]#(lf)    END AS NomeMatrizTransportador,#(lf)#(lf)    F.[CodigoFrete],#(lf)    F.[DataEnvioFinanceiro]#(lf)  #(lf)FROM [DW].[auditoria].[Fato_CustosFrete_Faturamento] F#(lf)#(lf)LEFT JOIN [DW].[dbo].[Dim_Natureza] N#(lf)    ON F.[IdNatureza] = N.[IdNatureza]#(lf)#(lf)LEFT JOIN [DW].[dbo].[Dim_Representante] R#(lf)    ON F.[IdRepresentante] = R.[Id]#(lf)#(lf)LEFT JOIN [STAGE].[tot].[NotaEmbal] NE#(lf)    ON F.[SerieNotaFiscal] = NE.[serie]#(lf)   AND F.[NumeroNotaFiscal] = NE.[nr-nota-fis]#(lf)#(lf)-- GWM (ITEM, SEQ, FRETE, ETC.)#(lf)LEFT JOIN STAGE.gfe.GWM gwm#(lf)    ON F.SerieNotaFiscal = gwm.GWM_SERDC#(lf)   AND F.NumeroNotaFiscal = gwm.GWM_NRDC#(lf)   AND gwm.GWM_TPDOC = '2'#(lf)   AND gwm.GWM_CDTPDC LIKE 'NFS%'#(lf)#(lf)-- DIM_ITEM PELO ITEM DA GWM#(lf)LEFT JOIN [DW].[dbo].[Dim_Item] I#(lf)    ON gwm.GWM_ITEM = I.[CodItem]  #(lf)#(lf)-- IT NOTA FISC (QT FATURADA)#(lf)LEFT JOIN [STAGE].[tot].[ItNotaFisc] itnf#(lf)    ON itnf.[serie] = F.[SerieNotaFiscal]#(lf)   AND itnf.[nr-nota-fis] = F.[NumeroNotaFiscal]#(lf)   AND itnf.[nr-seq-fat] = gwm.[GWM_SEQGW8]#(lf)   AND itnf.[it-codigo] = gwm.[GWM_ITEM]#(lf)#(lf)LEFT JOIN STAGE.gfe.GWH nrclc#(lf)    ON F.SerieNotaFiscal = nrclc.GWH_SERDC #(lf)   AND F.NumeroNotaFiscal = nrclc.GWH_NRDC#(lf)#(lf)LEFT JOIN STAGE.gfe.GWG gwgchv#(lf)    ON nrclc.GWH_NRCALC = gwgchv.GWG_NRCALC#(lf)#(lf)LEFT JOIN STAGE.gfe.GV6 GV6#(lf)    ON gwgchv.GWG_NRTAB = GV6.GV6_NRTAB#(lf)   AND gwgchv.GWG_NRNEG = GV6.GV6_NRNEG#(lf)   AND gwgchv.GWG_CDFXTV = GV6.GV6_CDFXTV#(lf)   AND gwgchv.GWG_NRROTA = GV6.GV6_NRROTA#(lf)   AND gwgchv.GWG_CDEMIT = GV6.GV6_CDEMIT#(lf)#(lf)LEFT JOIN [STAGE].[tot].[FamComer] FC#(lf)    ON CAST(I.[CodFamiliaComl] AS VARCHAR) = CAST(FC.[fm-cod-com] AS VARCHAR)#(lf)   AND FC.[EMPRESA] = '15'#(lf)   AND FC.[STATUS_REGISTRO] = 1#(lf)#(lf)WHERE F.[IdEstab] = 8#(lf)  AND F.[DataEnvioFinanceiro] >= '2024-01-01'#(lf)  #(lf)#(lf)  AND F.[IdDataCancelamento] IS NULL#(lf)  AND nrclc.D_E_L_E_T_ = ''#(lf)  AND GV6.D_E_L_E_T_ = ''#(lf)  AND F.[CodigoFrete] = 23210"]),
				    #"Duplicatas Removidas" = Table.Distinct(Fonte)
				in
				    #"Duplicatas Removidas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

