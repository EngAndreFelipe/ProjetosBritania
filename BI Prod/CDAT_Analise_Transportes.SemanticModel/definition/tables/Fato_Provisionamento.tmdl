	column StatusPagamento
		dataType: string
		lineageTag: 8bf64926-4787-4c9b-ae9e-6a88e9236818
		summarizeBy: none
		sourceColumn: StatusPagamento

		annotation SummarizationSetBy = Automatic

	partition Fato_Provisionamento = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "Stage", [Query="WITH FaturamentoDetalhado AS (#(lf)    SELECT #(lf)        f.[SerieNotaFiscal],#(lf)        f.[NumeroNotaFiscal],#(lf)        f.[CidadeDestino],#(lf)        f.[EstadoDestino],#(lf)        f.VlFretePrevisto,#(lf)        f.[TotalNota],#(lf)        f.[DataEmissaoNotaFiscal],#(lf)        f.[PesoBruto],#(lf)        f.[NomeMatrizTransportador],#(lf)        f.[DataEnvioFinanceiro],#(lf)        f.CodigoFrete,#(lf)        f.[QuantidadeFaturada],#(lf)        CASE #(lf)            WHEN ne.[qt-volumes] IS NULL OR ne.[qt-volumes] = 0 THEN 'COMPLEMENTO'#(lf)            ELSE 'MASTER'#(lf)        END AS TipoNota,#(lf)        nf.[cdd-embarq],#(lf)        gw3.[GW3_NRDF] AS NumCTE,#(lf)        gw3.[GW3_VLDF] AS ValorCTE,#(lf)        gw3.[GW3_NRFAT] AS NumFatura,#(lf)        gw3.[GW3_EMIFAT] AS EmpresaFatura,#(lf)        FORMAT(CONVERT(DATE, gw3.[GW3_DTEMFA]), 'dd/MM/yyyy') AS DataFatura,#(lf)        gw3.[GW3_PESOR] AS PesoReal,#(lf)        CASE #(lf)            WHEN nf.[cdd-embarq] IS NOT NULL AND nf.[cdd-embarq] <> 0 THEN #(lf)                (SELECT COUNT(*) #(lf)                 FROM [stage].[tot].[NotaFiscal] nf2#(lf)                 WHERE nf2.[cdd-embarq] = nf.[cdd-embarq])#(lf)            ELSE NULL#(lf)        END AS [NF/Embarque]#(lf)    FROM [DW].[auditoria].[Fato_CustosFrete_Faturamento] f#(lf)    LEFT JOIN [stage].[tot].[NotaEmbal] ne#(lf)        ON f.[NumeroNotaFiscal] = ne.[nr-nota-fis]#(lf)       AND f.[SerieNotaFiscal] = ne.[serie]#(lf)    LEFT JOIN [stage].[tot].[NotaFiscal] nf#(lf)        ON f.[NumeroNotaFiscal] = nf.[nr-nota-fis]#(lf)       AND f.[SerieNotaFiscal] = nf.[serie]#(lf)    LEFT JOIN [gfe].[gw4] gw4#(lf)        ON f.[NumeroNotaFiscal] = gw4.[GW4_NRDC]#(lf)       AND f.[SerieNotaFiscal] = gw4.[GW4_SERDC]#(lf)    LEFT JOIN [gfe].[gw3] gw3#(lf)        ON gw4.EMPRESA    = gw3.EMPRESA#(lf)       AND gw4.GW4_FILIAL = gw3.GW3_FILIAL#(lf)       AND gw4.GW4_EMISDF = gw3.GW3_EMISDF#(lf)       AND gw4.GW4_SERDF  = gw3.GW3_SERDF#(lf)       AND gw4.GW4_NRDF   = gw3.GW3_NRDF#(lf)       AND gw4.GW4_DTEMIS = gw3.GW3_DTEMIS#(lf)    WHERE f.[CodigoFrete] = '23210'#(lf)      AND SerieNotaFiscal IN ('5','21')#(lf)      AND f.[DataEmissaoNotaFiscal] BETWEEN '2025-01-01' AND GETDATE()#(lf)      AND (#(lf)        f.[NomeMatrizTransportador] NOT LIKE 'Corre%'#(lf)        AND f.[NomeMatrizTransportador] NOT LIKE 'J.J.%'#(lf)      )     #(lf))#(lf)SELECT#(lf)    SerieNotaFiscal,#(lf)    NumeroNotaFiscal,#(lf)    QuantidadeFaturada,#(lf)    CidadeDestino,#(lf)    EstadoDestino,#(lf)    VlFretePrevisto,#(lf)    TotalNota,#(lf)    DataEmissaoNotaFiscal,#(lf)    PesoBruto,#(lf)    NomeMatrizTransportador,#(lf)    DataEnvioFinanceiro,#(lf)    TipoNota,#(lf)    [cdd-embarq],#(lf)    NumCTE,#(lf)    ValorCTE,#(lf)    NumFatura,#(lf)    EmpresaFatura,#(lf)    DataFatura,#(lf)    PesoReal,#(lf)    CASE #(lf)        WHEN NumFatura IS NULL OR NumFatura = '' THEN 'SemFatura'#(lf)        ELSE 'ComFatura'#(lf)    END AS StatusPagamento#(lf)FROM FaturamentoDetalhado#(lf)WHERE DataEnvioFinanceiro IS NULL#(lf)  AND TipoNota = 'MASTER'"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

