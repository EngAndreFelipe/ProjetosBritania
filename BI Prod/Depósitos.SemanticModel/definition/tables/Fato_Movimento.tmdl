table Fato_Movimento
	lineageTag: 9f346bc6-85f3-4b32-8940-a9440dcac118

	measure 'DT ULT SAÍDA' = CALCULATE(Max(Fato_Movimento[dtTrans]),FILTER(Fato_Movimento,Fato_Movimento[descTrans]="Saida"))
		formatString: Short Date
		lineageTag: a26065db-b4a5-4aef-80c6-747a65b43b61

		changedProperty = FormatString

	measure 'QT DIAS' = DATEDIFF([DT ULT SAÍDA],TODAY(),DAY)
		formatString: 0
		lineageTag: 6189c948-39ef-44ef-845c-4c893b1e6ee9

	measure 'DT ULT_ENTRADA' = CALCULATE(MAX(Fato_Movimento[DtTrans]),FILTER(Fato_Movimento,Fato_Movimento[DescTrans] ="Entrada"))
