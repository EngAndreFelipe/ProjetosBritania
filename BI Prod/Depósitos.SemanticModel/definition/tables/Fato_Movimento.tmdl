	partition Fato_Movimento-c7e70d78-611d-4e3f-a320-15aaf0a55721 = m
		mode: import
		queryGroup: NOVO
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT EspDocto,#(lf)       CONVERT(DATE, DtTrans) AS DtTrans,#(lf)       DescTrans,#(lf)       CAST(Quantidade AS BIGINT) AS Quantidade,#(lf)       CodDepos,#(lf)       CodEstabel,#(lf)       ItCodigo,#(lf)       REPLACE(CONVERT(VARCHAR(10), DtTrans, 112), '/', '') AS DataInt#(lf)FROM dbo.Fato_Movimento WITH (NOLOCK)#(lf)WHERE DtTrans >= DATEADD(MONTH, -12, GETDATE())"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"DtTrans", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

