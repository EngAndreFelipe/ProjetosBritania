	partition Date-57d1491f-891e-4948-b6e7-55053c9cba82 = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				CALENDAR ((today()-365), (today())),
				"DateInt", FORMAT ( [Date], "DDMMYYYY" ),
				"Year", YEAR ( [Date] ),
				"Month", MONTH ( [Date] ),
				"AnoMM", FORMAT([Date],"YYYYMM"),
				"AnoMes", FORMAT([Date],"YYYY-MMM")
				)

