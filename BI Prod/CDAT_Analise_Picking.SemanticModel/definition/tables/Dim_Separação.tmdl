	column PercentualRUA
		dataType: double
		lineageTag: 9a6a36d7-f9c4-4671-a60d-b96c61c19835
		summarizeBy: sum
		sourceColumn: PercentualRUA

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Dim_Separação = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)    YEAR(M.[DataImplantacao]) AS Ano,#(lf)    FORMAT(M.[DataImplantacao], 'MMM', 'pt-BR') AS Mes,#(lf)    MONTH(M.[DataImplantacao]) AS Mes,#(lf)    COUNT(DISTINCT M.IdMovto) AS TotalSeparacoes,#(lf)    COUNT(DISTINCT CASE WHEN E.[cod-bloco] = 'PCK' THEN M.IdMovto END) AS SeparacoesPCK,#(lf)    COUNT(DISTINCT CASE WHEN E.[cod-bloco] NOT LIKE 'PCK' THEN M.IdMovto END) AS SeparacoesRUA,#(lf)    CAST(#(lf)        COUNT(DISTINCT CASE WHEN E.[cod-bloco] = 'PCK' THEN M.IdMovto END) * 1.0#(lf)        / NULLIF(COUNT(DISTINCT M.IdMovto), 0) #(lf)        AS DECIMAL(5,4)#(lf)    ) AS PercentualPCK,#(lf)    CAST(#(lf)        COUNT(DISTINCT CASE WHEN E.[cod-bloco] NOT LIKE 'PCK' THEN M.IdMovto END) * 1.0#(lf)        / NULLIF(COUNT(DISTINCT M.IdMovto), 0) #(lf)        AS DECIMAL(5,4)#(lf)    ) AS PercentualRUA#(lf)FROM dw.logistica.Fato_Mov_Estoque_PA_AT AS M#(lf)LEFT JOIN STAGE.tot.WmBox AS E #(lf)    ON M.IdEndereco = E.[id-box]#(lf)LEFT JOIN DW.dbo.Dim_Item AS I #(lf)    ON I.CodItem = M.Item#(lf)WHERE M.Origem = 'Consolidação'#(lf)  AND M.Local = 'aat'#(lf)  AND M.Movimento = 'Saida'#(lf)  AND M.Situacao = 'Atualizado'#(lf)  AND CAST(M.[DataImplantacao] AS DATE) >= '2025-01-01'#(lf)  AND E.[cod-local] = 'aat'#(lf)  AND I.DescFamMaterial NOT LIKE 'DISPLAY LCD/LED/PLASMA'#(lf)  AND M.NumeroDocumento NOT LIKE 'PUR%'#(lf)GROUP BY #(lf)    YEAR(M.[DataImplantacao]),#(lf)    MONTH(M.[DataImplantacao]),#(lf)    FORMAT(M.[DataImplantacao], 'MMM', 'pt-BR')#(lf)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

