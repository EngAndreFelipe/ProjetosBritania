table Fato_Serial
	lineageTag: 45210419-c009-4f50-848e-d5375dd03e3a

	measure QtdEtiquetasPorBox =
			
			CALCULATE (
			    DISTINCTCOUNT ( Fato_Serial[id-etiqueta] ),
			    ALLEXCEPT ( Fato_Serial, Fato_Serial[id-box] ),
			    NOT ISBLANK ( Fato_Serial[id-etiqueta] )
			)
		formatString: 0
		lineageTag: 5baace91-3177-4844-8641-8da59fe5ce1b

	measure ContagemIdBox = DISTINCTCOUNT(Fato_Serial[id-box])
		formatString: 0
		lineageTag: 461c8394-69bc-4603-a12e-50f6adc7130d

