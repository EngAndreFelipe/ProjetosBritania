	partition Fato_Serial = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "STAGE", [Query="SELECT BoxSaldo.[cod-local],#(lf)#(tab)   BoxSaldo.[id-box],#(lf)#(tab)   BoxSaldo.[cod-item],#(lf)#(tab)   IT.[desc-item],#(lf)#(tab)   BoxSaldo.[id-saldo],#(lf)#(tab)   BoxSaldo.[id-docto],#(lf)#(tab)   DOCS.Usuario,#(lf)#(tab)   CAST(BoxSaldo.[qtd-item] - BoxSaldo.[qtd-item-bloq] AS INT) AS Saldo,#(lf)#(tab)   BoxSaldo.[ind-status-saldo],#(lf)#(tab)   CASE BoxSaldo.[ind-status-saldo]#(lf)#(tab)   WHEN '2' THEN 'Destinado'#(lf)#(tab)   WHEN '3' THEN 'Liberado'#(lf)#(tab)   ELSE 'Outro'#(lf)#(tab)   END AS [desc-status-saldo],#(lf)#(tab)   Box.[cod-bloco],#(lf)#(tab)   Box.[cod-rua],#(lf)#(tab)   Box.[cod-nivel],#(lf)#(tab)   Box.[cod-coluna],#(lf)#(tab)   Box.[cdn-tipo-box],#(lf)#(tab)   BoxSaldoEtiqueta.[id-etiqueta],#(lf)#(tab)   CAST(BoxSaldoEtiqueta.[dt-ent-saldo] AS DATE) AS DataEtiqueta,#(lf)#(tab)   BoxSaldoEtiqueta.DataCarga#(lf)FROM STAGE.tot.WmBoxSaldo AS BoxSaldo#(lf)LEFT JOIN STAGE.tot.WmBox AS Box#(lf)ON Box.[id-box] = BoxSaldo.[id-box]#(lf)AND Box.[cod-local] = BoxSaldo.[cod-local]#(lf)LEFT JOIN STAGE.tot.WmBoxSaldoEtiqueta AS BoxSaldoEtiqueta#(lf)ON BoxSaldoEtiqueta.[id-box] = BoxSaldo.[id-box]#(lf)AND BoxSaldoEtiqueta.[cod-local] = BoxSaldo.[cod-local]#(lf)AND BoxSaldoEtiqueta.[id-saldo] = BoxSaldo.[id-saldo]#(lf)LEFT JOIN (#(lf)    SELECT #(lf)        Documento, #(lf)        Item, #(lf)        IdEndereco, #(lf)        MAX(Usuario2) AS Usuario#(lf)    FROM DW.logistica.Fato_Mov_Estoque_PA_AT#(lf)    GROUP BY Documento, Item, IdEndereco#(lf)) AS DOCS#(lf)ON DOCS.Documento = BoxSaldo.[id-docto]#(lf)AND DOCS.Item = BoxSaldo.[cod-item]#(lf)AND DOCS.IdEndereco = BoxSaldo.[id-box]#(lf)LEFT JOIN (#(lf)    SELECT [it-codigo], MAX([desc-item]) AS [desc-item]#(lf)    FROM STAGE.tot.Item#(lf)    GROUP BY [it-codigo]#(lf)) AS IT#(lf)ON IT.[it-codigo] = BoxSaldo.[cod-item]#(lf)WHERE BoxSaldo.[cod-local] = 'AAT'"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"cod-local", type text}, {"id-box", Int64.Type}, {"cod-item", type text}, {"id-saldo", Int64.Type}, {"id-docto", Int64.Type}, {"Usuario", type text}, {"Saldo", Int64.Type}, {"ind-status-saldo", Int64.Type}, {"desc-status-saldo", type text}, {"cod-bloco", type text}, {"cod-rua", type text}, {"cod-nivel", type text}, {"cod-coluna", type text}, {"cdn-tipo-box", Int64.Type}, {"id-etiqueta", Int64.Type}, {"DataCarga", type datetime}, {"DataEtiqueta", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

