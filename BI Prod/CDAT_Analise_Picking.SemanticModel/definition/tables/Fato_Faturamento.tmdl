table Fato_Faturamento
	lineageTag: dbbd9e0b-14dd-475e-9387-171bea6e99c1

	measure TotalPeças = SUM('Fato_Faturamento'[QuantidadeFat])
		formatString: 0
		lineageTag: d8bb1697-bdef-4974-af48-2c79ff28deb7

	measure HOJE = TODAY()
		formatString: General Date
		lineageTag: b600ac97-ef9a-49da-85bd-41f1a6e813cc

	measure ItensTotais =
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_Faturamento[CodItem]),
			    FILTER(
			        Fato_Faturamento,
			        Fato_Faturamento[RepetiçõesItem] > 20
			    )
			)
		formatString: 0
		lineageTag: ece7defd-8d55-4bed-959f-05882cde9a6c

