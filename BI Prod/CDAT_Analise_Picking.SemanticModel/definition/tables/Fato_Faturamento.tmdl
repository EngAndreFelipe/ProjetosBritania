		sourceColumn: CodigoDeposito

		annotation SummarizationSetBy = Automatic

	column DataEmissaoMaisRecente =
			
			CALCULATE (
			    MAX ( Fato_Faturamento[DataEmissao] ),
			    ALLEXCEPT ( Fato_Faturamento, Fato_Faturamento[CodItem] )
			)
		formatString: General Date
		lineageTag: f43ac385-ddd2-479d-a962-8da2adc87989
		summarizeBy: none

		variation Variation
			isDefault
			relationship: ad4e7d57-ee16-4a60-a2e6-a08008507e4b
			defaultHierarchy: LocalDateTable_50d6d661-8099-4fb8-a4ef-7bd3ffb963ed.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column DiasUltimoFaturamento = [HOJE] - Fato_Faturamento[DataEmissaoMaisRecente]
		dataType: int64
		formatString: 0
		lineageTag: b5397b0f-908b-42d3-9dc1-0554c5db9f6d
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column FaixaDiasUltimoFat =
			
			SWITCH (
			    TRUE(),
			    Fato_Faturamento[DiasUltimoFaturamento] < 30, "1 mês",
			    Fato_Faturamento[DiasUltimoFaturamento] < 60, "2 meses", Fato_Faturamento[DiasUltimoFaturamento] < 90, "3 meses",
			    Fato_Faturamento[DiasUltimoFaturamento] < 180, "6 meses",
			    Fato_Faturamento[DiasUltimoFaturamento] < 365, "Até um ano",
			    Fato_Faturamento[DiasUltimoFaturamento] < 730, "Mais de 1 ano",
			    "Mais de 2 anos"
			)
		lineageTag: 5defdf08-1fd7-4830-b090-4fdc5b9db58a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column RepetiçõesItem = ```
			COUNTROWS(
			    FILTER(
			        Fato_Faturamento,
			        Fato_Faturamento[IdItem] = EARLIER(Fato_Faturamento[IdItem])
			    )
			)
			
			```
		formatString: 0
		lineageTag: 868746bd-0ed7-4756-b0fb-0446ca9dac6a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column StatusCadastro = IF(COUNTROWS(FILTER(Dim_ItemXPicking, Dim_ItemXPicking[Item] = Fato_Faturamento[CodItem])) > 0, "Cadastrado", "Não Cadastrado")
		lineageTag: ad588197-79c9-4827-952f-d85718f4d180
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fato_Faturamento = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT F.[IdData]#(lf)      ,CAST(D.[Data] AS DATE) AS Data#(lf)      ,F.[IdEstab]#(lf)      ,E.CodEstab#(lf)      ,F.[IdItem]#(lf)      ,I.CodItem#(lf)      ,F.[IdEmitente]#(lf)      ,F.[NumeroNotaFiscal]#(lf)      ,F.[SerieNotaFiscal]#(lf)      ,F.[NumeroPedido]#(lf)      ,CAST(F.[DataEmissaoNotaFiscal] AS DATE) AS DataEmissao#(lf)      ,CAST(F.[DataSaida] AS DATE) AS DataSaida#(lf)      ,CAST(F.[QuantidadeFaturada] AS INT) AS QuantidadeFat#(lf)      ,F.[IdDeposito]#(lf)      ,DE.CodigoDeposito#(lf)#(lf)#(lf)  FROM [DW].[dbo].[Fato_Faturamento] AS F#(lf)  LEFT JOIN DW.dbo.Dim_Item AS I ON I.Id = F.IdItem#(lf)  LEFT JOIN DW.dbo.Dim_Data AS D ON D.Id = F.IdData#(lf)  LEFT JOIN DW.dbo.Dim_Estabelecimento AS E ON E.Id = F.IdEstab#(lf)  LEFT JOIN DW.dbo.Dim_Deposito AS DE ON DE.IdDeposito = F.IdDeposito#(lf)  WHERE CodEstab = '15'#(lf)  AND SerieNotaFiscal IN ('5','21')#(lf)  AND Cancelado = 0#(lf)  AND DataSaida IS NOT NULL#(lf)  AND CAST(F.[DataEmissaoNotaFiscal] AS DATE) >= DATEADD(DAY, -730, GETDATE())#(lf)  AND CAST(F.[QuantidadeFaturada] AS INT) <= 10#(lf)  AND F.[IdDeposito] = '4'#(lf)ORDER BY DataEmissaoNotaFiscal ASC#(lf)"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Data", type date}, {"DataEmissao", type date}, {"DataSaida", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

