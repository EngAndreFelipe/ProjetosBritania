	partition 'Depósito Aging' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf)#(tab)Serial,#(lf)#(tab)Item,#(lf)#(tab)CodFamMaterial,#(lf)#(tab)DescFamMaterial,#(lf)#(tab)CodFamiliaComl,#(lf)#(tab)DescFamiliaComl,#(lf)#(tab)CodGrupoEstoque,#(lf)#(tab)DescGrupoEstoque,#(lf)#(tab)Descrição,#(lf)#(tab)Classe,#(lf)#(tab)Bloco,#(lf)#(tab)Rua,#(lf)#(tab)Nivel,#(lf)#(tab)Coluna,#(lf)#(tab)Embalagem,#(lf)#(tab)Bloq,#(lf)#(tab)Total,#(lf)#(tab)Documento,#(lf)#(tab)Turno,#(lf)#(tab)DiasParados,#(lf)#(tab)DataHora,#(lf)#(tab)Hoje,#(lf)#(tab)case when DiasParados = 0 then 'Informado'#(lf)#(tab)#(tab)when DiasParados = 1 then 'Informado'#(lf)#(tab)#(tab)when DiasParados = 2 then 'Informado'#(lf)#(tab)#(tab)when DiasParados = 3 then 'Atenção'#(lf)#(tab)#(tab)else 'Crítico'#(lf)#(tab)#(tab)end 'Status',#(lf)#(tab)#(tab)Bloco+'/'+Rua+'/'+Nivel+'/'+Coluna [Blq/Rua/Nvl/Col]#(lf)FROM logistica.Fato_DepositosAging"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Serial", Int64.Type}})
				in
				    #"Tipo Alterado"

