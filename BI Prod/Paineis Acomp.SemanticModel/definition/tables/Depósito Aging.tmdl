table 'Depósito Aging'
	lineageTag: c91746a0-549a-47bc-b4fe-addc887f3778

	measure '- Turno A' =
			
			var c = CALCULATE(SUM('Depósito Aging'[Total]),
			FILTER('Depósito Aging','Depósito Aging'[Turno] = "Turno A"))
			return IF(ISBLANK(c),0,c)
		formatString: #,0
