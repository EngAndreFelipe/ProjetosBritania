	column StatusValida = IF(COUNTROWS(FILTER(Dim_Cancelados, Dim_Cancelados[ChaveItem] = InvCiclico2026[ChaveItem])) > 0, "Cancelado", "Válido")
		lineageTag: f2e9529c-f4fb-4cf6-80a1-e93538c857a1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ChaveItem =
			
