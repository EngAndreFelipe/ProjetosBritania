table InvCiclico2026
	lineageTag: f35af7d0-9f7f-49e1-a803-f9d0af5947c5

	measure AcuraciaPorDia =
			
			VAR TotalIdBoxItemDia =
			    COUNTROWS (
			        SUMMARIZE (
			            InvCiclico2026,
			            InvCiclico2026[DataInventario],
			            InvCiclico2026[IdBox],
			            InvCiclico2026[Item]
			        )
			    )
			VAR IdBoxItemCorretosDia =
			    COUNTROWS (
			        FILTER (
			            SUMMARIZE (
			                InvCiclico2026,
			                InvCiclico2026[DataInventario],
			                InvCiclico2026[IdBox],
			                InvCiclico2026[Item],
			                InvCiclico2026[AcuraciaPorPosicao]
			            ),
			            InvCiclico2026[AcuraciaPorPosicao] = "Correto"
			        )
			    )
			RETURN
			DIVIDE ( IdBoxItemCorretosDia, TotalIdBoxItemDia, 0 )
		formatString: 0
		lineageTag: 73d95633-676f-4421-a9ad-bede8736dc78

	measure Zero = VALUE("0")
		lineageTag: afddd234-af17-4543-b88d-56dbd1274b15

