	partition InvCiclico2026 = calculated
		mode: import
		source =
				
				UNION (
				    SELECTCOLUMNS (
				        FILTER (
				            Fato_InvPrimeiroCiclo,
				            Fato_InvPrimeiroCiclo[EquipeContagem] = "INV-CICLICO"
				        ),
				        "IdBox", Fato_InvPrimeiroCiclo[IdBox],
				        "Bloco", Fato_InvPrimeiroCiclo[Bloco],
				        "Rua", Fato_InvPrimeiroCiclo[Rua],
				        "Nivel", Fato_InvPrimeiroCiclo[Nivel],
				        "Coluna", Fato_InvPrimeiroCiclo[Coluna],
				        "DataInventario", Fato_InvPrimeiroCiclo[DataInventario],
				        "NumeroInventario", Fato_InvPrimeiroCiclo[NumeroInventario],
				        "Item", Fato_InvPrimeiroCiclo[Item],
				        "Descrição", Fato_InvPrimeiroCiclo[DescItem],
				        "Saldo", Fato_InvPrimeiroCiclo[Saldo],
				        "QtdApurada1", Fato_InvPrimeiroCiclo[QtdApurada1],
				        "QtdApurada2", Fato_InvPrimeiroCiclo[QtdApurada2],
				        "QtdApurada3", Fato_InvPrimeiroCiclo[QtdApurada3],
				        "Usuario1", Fato_InvPrimeiroCiclo[Usuario1],
				        "Usuario2", Fato_InvPrimeiroCiclo[Usuario2],
				        "Usuario3", Fato_InvPrimeiroCiclo[Usuario3],
				        "Acuracia", Fato_InvPrimeiroCiclo[Acuracidade],
				        "AcuraciaPorPosicao", Fato_InvPrimeiroCiclo[AcuracidadePorPosicao],
				        "Chave", Fato_InvPrimeiroCiclo[ChaveDocumento]
				    ),
				    SELECTCOLUMNS (
				        FILTER (
				            Fato_InvSegundoCiclo,
				            Fato_InvSegundoCiclo[EquipeContagem] = "INV-CICLICO"
				        ),
				        "IdBox", Fato_InvSegundoCiclo[IdBox],
				        "Bloco", Fato_InvSegundoCiclo[Bloco],
				        "Rua", Fato_InvSegundoCiclo[Rua],
				        "Nivel", Fato_InvSegundoCiclo[Nivel],
				        "Coluna", Fato_InvSegundoCiclo[Coluna],
				        "DataInventario", Fato_InvSegundoCiclo[DataInventario],
				        "NumeroInventario", Fato_InvSegundoCiclo[NumeroInventario],
				        "Item", Fato_InvSegundoCiclo[Item],
				        "Descrição", Fato_InvSegundoCiclo[DescItem],
				        "Saldo", Fato_InvSegundoCiclo[Saldo],
				        "QtdApurada1", Fato_InvSegundoCiclo[QtdApurada1],
				        "QtdApurada2", Fato_InvSegundoCiclo[QtdApurada2],
				        "QtdApurada3", Fato_InvSegundoCiclo[QtdApurada3],
				        "Usuario1", Fato_InvSegundoCiclo[Usuario1],
				        "Usuario2", Fato_InvSegundoCiclo[Usuario2],
				        "Usuario3", Fato_InvSegundoCiclo[Usuario3],
				        "Acuracia", Fato_InvSegundoCiclo[Acuracidade],
				        "AcuraciaPorPosicao", Fato_InvSegundoCiclo[AcuracidadePorPosicao],
				        "Chave", Fato_InvSegundoCiclo[ChaveDocumento]
				    )
				)

	annotation PBI_Id = 59435bf22ef8458db8e5c26f48875f75

