	column FaixaHora =
			
			VAR Hora = HOUR(Produtividade_Usuarios[HoraLeitura])
			RETURN
			FORMAT(Hora, "00") & " as " & FORMAT(Hora + 1, "00")
		lineageTag: 8ed8b7c6-c25e-452a-b359-ce5c5e4afc03
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EquipeContagem =
			
			VAR DataInv = Produtividade_Usuarios[DataInventario]
			VAR Usuario = Produtividade_Usuarios[Usuario]
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(Dim_Usuarios[Equipe]),
			        FILTER(
			            Dim_Usuarios,
			            Dim_Usuarios[Usuario] = Usuario &&
			            DataInv >= Dim_Usuarios[De] &&
			            DataInv <= Dim_Usuarios[Até]
			        )
			    )
		lineageTag: 4b836645-13fb-4003-a886-8e87ac89d258
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Produtividade_Usuarios = calculated
		mode: import
		source =
				
				FILTER(
				    UNION(
				        SELECTCOLUMNS(
				            Fato_InvSegundoCiclo,
				            "Usuario", Fato_InvSegundoCiclo[Usuario1],
				            "Qtd_Pecas", Fato_InvSegundoCiclo[QtdApurada1],
				            "Item", Fato_InvSegundoCiclo[Item],
				            "Endereco", Fato_InvSegundoCiclo[IdBox],
				            "DataInventario", Fato_InvSegundoCiclo[DataInventario],
				            "NumeroInventario", Fato_InvSegundoCiclo[NumeroInventario],
				            "Bloco", Fato_InvSegundoCiclo[Bloco],
				            "Rua", Fato_InvSegundoCiclo[Rua],
				            "Nivel", Fato_InvSegundoCiclo[Nivel],
				            "Coluna", Fato_InvSegundoCiclo[Coluna],
				            "SituacaoEnd", Fato_InvSegundoCiclo[SituacaoEnd], "HoraLeitura", Fato_InvSegundoCiclo[HoraLeitura1]
				        ),
				        SELECTCOLUMNS(
				            Fato_InvSegundoCiclo,
				            "Usuario", Fato_InvSegundoCiclo[Usuario2],
				            "Qtd_Pecas", Fato_InvSegundoCiclo[QtdApurada2],
				            "Item", Fato_InvSegundoCiclo[Item],
				            "Endereco", Fato_InvSegundoCiclo[IdBox],
				            "DataInventario", Fato_InvSegundoCiclo[DataInventario],
				            "NumeroInventario", Fato_InvSegundoCiclo[NumeroInventario],
				            "Bloco", Fato_InvSegundoCiclo[Bloco],
				            "Rua", Fato_InvSegundoCiclo[Rua],
				            "Nivel", Fato_InvSegundoCiclo[Nivel],
				            "Coluna", Fato_InvSegundoCiclo[Coluna],
				            "SituacaoEnd", Fato_InvSegundoCiclo[SituacaoEnd], "HoraLeitura", Fato_InvSegundoCiclo[HoraLeitura2]
				        ),
				        SELECTCOLUMNS(
				            Fato_InvSegundoCiclo,
				            "Usuario", Fato_InvSegundoCiclo[Usuario3],
				            "Qtd_Pecas", Fato_InvSegundoCiclo[QtdApurada3],
				            "Item", Fato_InvSegundoCiclo[Item],
				            "Endereco", Fato_InvSegundoCiclo[IdBox],
				            "DataInventario", Fato_InvSegundoCiclo[DataInventario],
				            "NumeroInventario", Fato_InvSegundoCiclo[NumeroInventario],
				            "Bloco", Fato_InvSegundoCiclo[Bloco],
				            "Rua", Fato_InvSegundoCiclo[Rua],
				            "Nivel", Fato_InvSegundoCiclo[Nivel],
				            "Coluna", Fato_InvSegundoCiclo[Coluna],
				            "SituacaoEnd", Fato_InvSegundoCiclo[SituacaoEnd], "HoraLeitura", Fato_InvSegundoCiclo[HoraLeitura3]
				        )
				    ),
				    FORMAT([Qtd_Pecas], "0") <> "?"
				)

	annotation PBI_Id = 91761adc92dd4e91aa2e723da7acbab0

