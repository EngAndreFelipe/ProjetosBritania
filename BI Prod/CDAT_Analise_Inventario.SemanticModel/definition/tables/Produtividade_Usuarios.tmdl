		lineageTag: 09449679-e4e5-4256-a672-8fc607932a17

	measure ContagemEndRUA = COALESCE(CALCULATE(DISTINCTCOUNT(Produtividade_Usuarios[Endereco]),Produtividade_Usuarios[Bloco] <> "PCK"),0)
