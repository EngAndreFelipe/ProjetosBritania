		annotation SummarizationSetBy = Automatic

	column UsuarioUltimaMov
		dataType: string
		lineageTag: 10e05c1b-d6bc-41b1-a5cc-0a9dc5d9476a
		summarizeBy: none
		sourceColumn: UsuarioUltimaMov

		annotation SummarizationSetBy = Automatic

	partition Dim_DCV = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="WITH UltMov AS (#(lf)    SELECT #(lf)        M.[it-codigo],#(lf)        M.[usuario],#(lf)        M.[dt-trans],#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY M.[it-codigo] #(lf)            ORDER BY M.[dt-trans] DESC#(lf)        ) AS rn#(lf)    FROM [STAGE].[tot].[MovtoEstoq] M#(lf)    WHERE M.[cod-depos] = 'dcv'#(lf)      AND M.[tipo-trans] = '1'#(lf)      AND M.[esp-docto] = '33'#(lf))#(lf)SELECT#(lf)    S.[it-codigo] AS Item,#(lf)    I.[DescItem] AS Descrição,#(lf)    CONVERT(INT, S.[qtidade-atu], 0) AS Quantidade,#(lf)    UPPER(S.[cod-depos]) AS Depósito,#(lf)    -- Primeira movimentação#(lf)    CAST(MIN(MovCon.[dt-trans]) AS DATE) AS PrimeiraEntDCV,#(lf)    -- Última movimentação#(lf)    CAST(MAX(MovCon.[dt-trans]) AS DATE) AS UltimaEntDCV,#(lf)    U.[usuario] AS UsuarioUltimaMov#(lf)FROM STAGE.tot.SaldoEstoq AS S#(lf)LEFT JOIN DW.dbo.Dim_Item AS I #(lf)       ON S.[it-codigo] = I.[CodItem]#(lf)LEFT JOIN [STAGE].[tot].[MovtoEstoq] AS MovCon #(lf)       ON MovCon.[it-codigo] = S.[it-codigo]#(lf)      AND MovCon.[cod-depos] = 'dcv'#(lf)      AND MovCon.[tipo-trans] = '1'#(lf)      AND MovCon.[esp-docto] = '33'#(lf)LEFT JOIN UltMov U#(lf)       ON U.[it-codigo] = S.[it-codigo]#(lf)      AND U.rn = 1#(lf)WHERE S.[cod-depos] = 'dcv' #(lf)  AND S.[cod-estabel] = '15' #(lf)  AND S.[qtidade-atu] <> 0#(lf)GROUP BY #(lf)    S.[it-codigo], #(lf)    I.[DescItem], #(lf)    S.[qtidade-atu], #(lf)    S.[cod-depos], #(lf)    U.[usuario];"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"UltimaEntDCV", type date}, {"PrimeiraEntDCV", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

