table Dim_DCV
	lineageTag: ba0f5da4-14c9-4676-9b5f-75f4e55e419c

	measure TotalPreçoDCV =
			
			SUMX(Dim_DCV, Dim_DCV[Quantidade] * [PrecoPecaMedida])
		lineageTag: d9067be8-c067-4e10-b0e4-92e85cea51f0

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ContagemItensDCV = DISTINCTCOUNT(Dim_DCV[Item])
		formatString: 0
		lineageTag: 2b6c6104-d900-4cb6-8c42-932745b0a30e

	measure QuantidadePecasDCV = SUM(Dim_DCV[Quantidade])
		formatString: 0
		lineageTag: 1fb96278-fc64-4734-ae73-57a432d71b40

	measure PrecoPecaMedida =
			
			CALCULATE(
			    SUM(Dim_Precos[Custo]),
			    USERELATIONSHIP(Dim_Precos[Item], Dim_DCV[Item])
			)
		lineageTag: 2bf00a62-1641-44bb-8ae2-0e78772cc184

		annotation PBI_FormatHint = {"isGeneralNumber":true}

