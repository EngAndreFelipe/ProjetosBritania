	column FaixaDias = ```
			
			SWITCH(
			    TRUE(),
			    Dim_DCV[DiasEmDCV] < 10, "Até 10 dias",
			    Dim_DCV[DiasEmDCV] < 90, "Até 90 dias", Dim_DCV[DiasEmDCV] = 90, "Até 90 dias",
			    Dim_DCV[DiasEmDCV] = 91, "Maior que 90 dias", Dim_DCV[DiasEmDCV] > 91, "Maior que 90 dias"
			)
			
			```
		lineageTag: fd2354d2-7d49-4dde-bcb3-e12690dca3e0
