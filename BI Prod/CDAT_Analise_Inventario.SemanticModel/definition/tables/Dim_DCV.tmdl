	column FaixaPreco = ```
			
			SWITCH(
			    TRUE(),
			    Dim_DCV[Quantidade] * [PrecoPecaMedida] < 25, "Abaixo de R$25",
			    Dim_DCV[Quantidade] * [PrecoPecaMedida] < 300, "Entre R$26 - R$300",
			    Dim_DCV[Quantidade] * [PrecoPecaMedida] > 300, "Maior que R$300"
			)
			
			```
		lineageTag: d3e6f9f2-54ce-410f-80b9-bd48efd61dc6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TipoPeça =
			
			VAR TextoLimpo = TRIM(Dim_DCV[Descrição])
			VAR TextoSeparado = SUBSTITUTE(TextoLimpo, " ", "|")
			RETURN PATHITEM(TextoSeparado, 1)
		lineageTag: eb2faf2e-2501-4d52-9644-2d3771089415
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

