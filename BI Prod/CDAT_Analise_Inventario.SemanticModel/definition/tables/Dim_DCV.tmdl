	column DiasEmDCV = [HOJE] - Dim_DCV[UltimaEntDCV]
		dataType: int64
		lineageTag: 40e38f3b-19cb-4b08-99fd-4ec2b1c36117
		summarizeBy: sum

		changedProperty = DataType

