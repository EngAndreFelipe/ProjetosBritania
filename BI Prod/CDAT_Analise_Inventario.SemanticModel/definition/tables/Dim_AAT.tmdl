	partition Dim_AAT = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)  S.[it-codigo] AS 'Item',#(lf)  I.[DescItem] AS 'Descrição',#(lf)  SUM(CONVERT(INT,S.[qtidade-atu],0)) AS 'Quantidade',#(lf)  UPPER(S.[cod-depos]) AS 'Depósito'#(lf)FROM #(lf)  STAGE.tot.SaldoEstoq AS S#(lf)LEFT JOIN #(lf)  DW.dbo.Dim_Item AS I ON S.[it-codigo] = I.[CodItem]#(lf)WHERE #(lf)  S.[cod-depos] = 'aat'#(lf)  AND S.[cod-estabel] = '15' #(lf)  AND S.[qtidade-atu] <> 0#(lf)  AND CodItem NOT LIKE ''#(lf)#(lf)GROUP BY S.[it-codigo], I.[DescItem], S.[cod-depos]#(lf)#(lf)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

