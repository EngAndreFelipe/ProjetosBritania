	partition Fato_DocumentoObs = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT Documento,#(lf)       NumeroDocumento,#(lf)       Local,#(lf)       CAST(DataImplantacao AS DATE) AS DataImplantacao,#(lf)       Usuario,#(lf)       Origem,#(lf)       Item,#(lf)       QtdItem,#(lf)       IdEndereco,#(lf)       Endereco,#(lf)       CAST(DataCarga AS datetime) AS DataCarga#(lf)FROM DW.logistica.Fato_Mov_Estoque_PA_AT#(lf)WHERE [Local] LIKE 'AAT'#(lf)  AND DataCarga IS NOT NULL#(lf)  AND (NumeroDocumento LIKE 'DESC%'#(lf)       OR NumeroDocumento LIKE 'NEXT%'#(lf)       OR NumeroDocumento LIKE '%RNC%')#(lf)  AND DataImplantacao >= '2025-01-01'#(lf)  AND Item IS NOT NULL;"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

