				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataInicial DATE = DATEFROMPARTS(YEAR(GETDATE()) - 2, 1, 1);#(lf)DECLARE @DataFinal DATE = DATEFROMPARTS(YEAR(GETDATE()), 12, 31);#(lf)SELECT #(lf)#(tab)CAST(Data AS DATE) Calendario,#(lf)#(tab)DiaSemana,#(lf)#(tab)DiaSemanaNome,#(lf)#(tab)DiaSemanaAno,#(lf)#(tab)Mes,#(lf)#(tab)MesNome,#(lf)#(tab)Ano,#(lf)#(tab)MMYYYY MesAno,#(lf)#(tab)CAST(DiaUtil AS INT) AS DiaUtil#(lf)FROM dbo.Dim_Data#(lf)WHERE data BETWEEN @DataInicial AND @DataFinal;"])
