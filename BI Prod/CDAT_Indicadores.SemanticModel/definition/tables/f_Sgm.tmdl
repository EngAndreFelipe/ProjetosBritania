				    #"Colunas Removidas" = Table.RemoveColumns(#"Linhas Filtradas",{"SetorId", "MetaIndicador", "RealizadoDenominador", "RealizadoNumerador", "_RealizadoNumerador", "_RealizadoDenominador", "_DiasUteis"}),
