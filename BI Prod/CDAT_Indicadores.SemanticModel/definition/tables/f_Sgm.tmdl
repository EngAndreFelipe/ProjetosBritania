	column FiltroIndicadores = ```
			
			 VAR codId = FORMAT(f_Sgm[IdIndicador]*1, "0000") & " - " 
			 VAR caract = LEN(f_Sgm[NomeIndicador])
			 VAR nomeId = f_Sgm[NomeIndicador]
			 VAR esq = LEFT(nomeId, 15)
			 VAR dir = RIGHT(nomeId, 15)
			 RETURN
			    IF(caract > 30, codId & esq & " ... " & dir,
			        codId & nomeId
			    )
			```
		lineageTag: ed9c8de4-3fa4-4a07-8df3-60295415d068
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Indicadores = ```
			
			 VAR codId = FORMAT(f_Sgm[IdIndicador]*1, "0000") & " - " 
			 VAR nomeId = f_Sgm[NomeIndicador]
			 RETURN
			    codId & nomeId
			```
		lineageTag: 5f55eb27-14c3-4ce2-a94a-602b17f5e5a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FormtMesAno = FORMAT(f_Sgm[MesAno], "mmm"&"/"&"yyyy")
		lineageTag: 0836aad2-0bfa-4d75-8b89-9a3770981020
		summarizeBy: none

