	column Meta_Indicador
		dataType: double
		formatString: 0.00
		lineageTag: 9c998a0f-65fb-4e78-8e29-cbbe05d4b49a
		summarizeBy: sum
		sourceColumn: Meta_Indicador

		annotation SummarizationSetBy = Automatic

	column %_AtingReal =
			
			VAR div = IF(f_Sgm[Format] = "#,#0.00", 1, 100)
			VAR cima  = DIVIDE(f_Sgm[Realizado], (f_Sgm[Meta_Indicador]/div))
			VAR baixo = (DIVIDE(f_Sgm[Realizado], (f_Sgm[Meta_Indicador]/div))*-1)+2
			VAR fcima = FORMAT(cima, "0.##")
			VAR fbaixo = FORMAT(baixo, "0.##")
			RETURN
			    IF(ISBLANK(f_Sgm[Realizado]), BLANK(),
			        IF(f_Sgm[TpIndicador] = "Para baixo", fbaixo, fcima)
			    )
		dataType: double
		lineageTag: ad81d4d7-4257-4198-9f79-4b86deee4c67
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MetaIndicadorAcumulado
		dataType: double
		lineageTag: 5d09dc0e-55bc-4ec0-8230-ec40b911743c
		summarizeBy: sum
		sourceColumn: MetaIndicadorAcumulado

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column %_AtingAcm =
			
			VAR div = IF(f_Sgm[Format] = "#,#0.00", 1, 100)
			VAR cima  = DIVIDE(f_Sgm[RealizadoAcm], (f_Sgm[MetaIndicadorAcumulado]/div))
			VAR baixo = (DIVIDE(f_Sgm[RealizadoAcm], (f_Sgm[MetaIndicadorAcumulado]/div))*-1)+2
			VAR fcima = FORMAT(cima, "0.####")
			VAR fbaixo = FORMAT(baixo, "0.####")
			RETURN
			    IF(ISBLANK(f_Sgm[Realizado]), BLANK(),
			        IF(f_Sgm[TpIndicador] = "Para baixo", fbaixo, fcima)
			    )
		dataType: double
		lineageTag: 1fa61190-878f-42f4-a4ef-b1d5140d0254
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column RealizadoAcm =
			
			VAR real = DIVIDE(f_Sgm[NumAcumulado], f_Sgm[DenAcumulado], 0)
			VAR frt = FORMAT(real, "0.####")
			RETURN
			    IF(ISBLANK(f_Sgm[RealNumerador]), BLANK(), frt)
		dataType: double
		lineageTag: 1c5322f9-65c6-46c7-9723-4e31e253be3c
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

