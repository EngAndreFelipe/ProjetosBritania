table Medidas
	lineageTag: 03b7af66-0c5b-495c-8482-0931c5a3c66c

	measure 'Notas Conferidas' =
			
			COUNTROWS(
			    VALUES(ESWM0028[NumeroDocumento])
			)
		formatString: #,0
		lineageTag: da14ba1a-e178-4385-bf03-bbdfac333e50

	measure 'Itens conferidos' = sum(ESWM0028[QuantidadeRecebimento])
		formatString: #,0
		lineageTag: 94886a59-6538-4158-8a7c-2af597423caa

	measure 'Qtd Conferentes' = DISTINCTCOUNT(ESWM0028[Usuario])
		formatString: 0
		lineageTag: 08013f81-1c42-433c-a870-c66244232e6a

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

