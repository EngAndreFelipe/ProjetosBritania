	partition f_dwMovEstoqueAT = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DtImpPedidoPDB DATE = CAST(DATEADD(DAY, -90, GETDATE()) AS DATE);#(lf)DECLARE @DtImpDocOnda DATE = CAST(DATEADD(DAY, -10, GETDATE()) AS DATE);#(lf)#(lf)-- Tab Busca Número Onda da STAGE#(lf)WITH DocOnda AS (#(lf)#(tab)SELECT doc,#(lf)#(tab)#(tab)num_onda#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT  #(lf)#(tab)#(tab)#(tab)CAST([id-docto] AS INT) doc,#(lf)#(tab)#(tab)#(tab)[num-docto] num_onda#(lf)#(tab)#(tab)FROM STAGE.tot.WmsDoctoItemAgru WITH (NOLOCK)#(lf)#(tab)#(tab)WHERE  [dt-implan-docto] >= @DtImpDocOnda#(lf)#(lf)#(tab)#(tab)UNION  -- UNION Documento + Documento Original e Número da ONDA#(lf)#(tab)#(tab)#(lf)#(tab)#(tab)SELECT  #(lf)#(tab)#(tab)#(tab)CAST([id-docto-orig] AS INT) doc,#(lf)#(tab)#(tab)#(tab)[num-docto] num_onda#(lf)#(tab)#(tab)FROM STAGE.tot.WmsDoctoItemAgru WITH (NOLOCK)#(lf)#(tab)#(tab)WHERE [dt-implan-docto] >= @DtImpDocOnda#(lf)#(tab)#(tab)) AS tb_onda#(lf)),#(lf)Consultas AS(#(lf)#(tab)SELECT  DISTINCT#(lf)#(tab)#(tab)pdb.Embarque,#(lf)#(tab)#(tab)pdb.NotaFiscal,#(lf)#(tab)#(tab)pdb.SerieNotaFiscal,#(lf)#(tab)#(tab)ft.NumeroRomaneio,#(lf)#(tab)#(tab)pdb.DataSaida,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN pdb.NotaFiscal IS NULL OR pdb.NotaFiscal = '' THEN 'NÃO'#(lf)#(tab)#(tab)#(tab)ELSE 'SIM'#(lf)#(tab)#(tab)END StsNotaFiscal,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)WHEN ft.NumeroRomaneio IS NULL OR ft.NumeroRomaneio = '' THEN 'NÃO'#(lf)#(tab)#(tab)#(tab)ELSE 'SIM'#(lf)#(tab)#(tab)END StsNumeroRomaneio#(lf)#(tab)FROM logistica.Fato_PDB381 pdb WITH (NOLOCK)#(lf)#(tab)#(tab)LEFT JOIN (#(lf)#(tab)#(tab)#(tab)SELECT DISTINCT#(lf)#(tab)#(tab)#(tab)#(tab)NumeroNotaFiscal,#(lf)#(tab)#(tab)#(tab)#(tab)SerieNotaFiscal,#(lf)#(tab)#(tab)#(tab)#(tab)NumeroRomaneio#(lf)#(tab)#(tab)#(tab)FROM auditoria.Fato_CustosFrete_Faturamento ft WITH (NOLOCK)#(lf)#(tab)#(tab)#(tab)WHERE IdEstab = '8'#(lf)#(tab)#(tab)#(tab)#(tab)AND SerieNotaFiscal IN('5','21')#(lf)#(tab)#(tab)#(tab)#(tab)AND DataEmissaoNotaFiscal >= @DtImpPedidoPDB#(lf)#(tab)#(tab))ft #(lf)#(tab)#(tab)#(tab)ON pdb.NotaFiscal = ft.NumeroNotaFiscal#(lf)#(tab)#(tab)#(tab)#(tab)AND pdb.SerieNotaFiscal = ft.SerieNotaFiscal#(lf)#(tab)WHERE DataImplantacao >= @DtImpPedidoPDB#(lf)#(tab)#(tab)AND pdb.EstabNotaFiscal = '15'#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal IN('5','21')#(lf)#(tab)#(tab)--AND Embarque = '3404663'#(lf)),#(lf)validacao AS(#(lf)#(tab)SELECT DISTINCT#(lf)#(tab)#(tab)Embarque,#(lf)#(tab)#(tab)StsNotaFiscal,#(lf)#(tab)#(tab)StsNumeroRomaneio,#(lf)#(tab)#(tab)DataSaida#(lf)#(tab)FROM Consultas#(lf))#(lf)SELECT  #(lf)#(tab)COALESCE(do.num_onda, 'SEM DOC') ONDA,#(lf)#(tab)est.NumeroDocumento,#(lf)#(tab)est.DataImplantacao,#(lf)#(tab)est.Movimento,#(lf)#(tab)est.Item,#(lf)#(tab)est.DescItem,#(lf)#(tab)est.QtdeItemMov,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN est.Origem = 'Consolidação' THEN 'Separação'#(lf)#(tab)#(tab)WHEN est.Origem = 'Pré-Faturamento' THEN 'Conferência'#(lf)#(tab)END TipoOperacao,#(lf)#(tab)est.Situacao,#(lf)#(tab)est.SituacaoItem,#(lf)#(tab)est.Endereco,#(lf)#(tab)est.DtInicioTarefa,#(lf)#(tab)est.DtFimTarefa,#(lf)#(tab)est.Usuario2,#(lf)#(tab)vl.Embarque,#(lf)#(tab)vl.StsNumeroRomaneio,#(lf)#(tab)vl.StsNotaFiscal,#(lf)#(tab)CASE#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN vl.StsNumeroRomaneio = 'SIM' THEN 'Em Romaneio'#(lf)#(tab)#(tab)#(tab)WHEN vl.StsNotaFiscal = 'SIM' THEN 'Nota Fiscal'#(lf)#(tab)#(tab)#(tab)WHEN est.Origem = 'Pré-Faturamento' AND est.SituacaoItem <> 'Concluído' THEN est.SituacaoItem#(lf)#(tab)#(tab)#(tab)WHEN est.Origem = 'Pré-Faturamento' THEN est.SituacaoItem#(lf)#(tab)#(tab)#(tab)WHEN est.Origem = 'Consolidação' AND est.Usuario2 <> '' AND est.DtInicioTarefa IS NOT NULL THEN 'Em Processo'#(lf)#(tab)#(tab)#(tab)WHEN est.Origem = 'Consolidação' AND est.Usuario2 <> '' AND est.DtInicioTarefa IS NULL THEN 'Iniciado'#(lf)#(tab)#(tab)#(tab)ELSE 'Pendente'#(lf)#(tab)#(tab)END#(lf)#(tab)#(tab)WHEN 'Em Romaneio' THEN 'Em Romaneio'#(lf)#(tab)#(tab)WHEN 'Nota Fiscal' THEN 'Nota Fiscal'#(lf)#(tab)#(tab)WHEN 'Pendente' THEN 'Separação'#(lf)#(tab)#(tab)WHEN est.SituacaoItem THEN 'Conferência'#(lf)#(tab)#(tab)ELSE 'Separação'#(lf)#(tab)END TipoOpAlterado,#(lf)#(tab)CASE #(lf)#(tab)#(tab)WHEN vl.StsNumeroRomaneio = 'SIM' THEN 'Em Romaneio'#(lf)#(tab)#(tab)WHEN vl.StsNotaFiscal = 'SIM' THEN 'Nota Fiscal'#(lf)#(tab)#(tab)WHEN est.Origem = 'Pré-Faturamento' AND est.SituacaoItem <> 'Concluído' THEN est.SituacaoItem#(lf)#(tab)#(tab)WHEN est.Origem = 'Pré-Faturamento' THEN est.SituacaoItem#(lf)#(tab)#(tab)WHEN est.Origem = 'Consolidação' AND est.Usuario2 <> '' AND est.DtInicioTarefa IS NOT NULL THEN 'Em Processo'#(lf)#(tab)#(tab)WHEN est.Origem = 'Consolidação' AND est.Usuario2 <> '' AND est.DtInicioTarefa IS NULL THEN 'Iniciado'#(lf)#(tab)#(tab)ELSE 'Pendente'#(lf)#(tab)END StatusItem#(lf)FROM logistica.VW_Fato_Mov_Estoque_PA_AT est WITH (NOLOCK)#(lf)#(tab)LEFT JOIN DocOnda do  #(lf)#(tab)#(tab)ON est.Documento = do.doc #(lf)#(tab)LEFT JOIN validacao vl#(lf)#(tab)#(tab)ON CAST(vl.Embarque AS VARCHAR) = est.NumeroDocumento#(lf)WHERE est.Local = 'AAT'#(lf)#(tab)AND est.NumeroDocumento <> 'SALDO'#(lf)#(tab)AND do.num_onda <> 'SEM DOC'#(lf)#(tab)AND est.Origem IN('Pré-Faturamento','Consolidação')#(lf)#(tab)AND NOT (est.Origem = 'Consolidação' AND est.SituacaoItem = 'Concluído' AND  Situacao = 'Atualizado')#(lf)#(tab)AND Movimento = 'Saida'#(lf)#(tab)AND vl.DataSaida IS NULL#(lf)#(tab)AND DataImplantacao >= @DtImpDocOnda;"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

