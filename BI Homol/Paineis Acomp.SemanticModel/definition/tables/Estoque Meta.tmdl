	partition 'Estoque Meta-439eec11-d1fa-452e-ac2e-60bd75714e5f' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf)#(tab)em.[IdData],#(lf)#(tab)DDT.DataMascara AS 'Data',#(lf)#(tab)em.[IdItem],#(lf)#(tab)DI.CodItem,#(lf)#(tab)DI.DescItem,#(lf)#(tab)em.[IdEstabelec],#(lf)#(tab)de.CodEstab,#(lf)#(tab)de.Empresa,#(lf)#(tab)em.[IdDeposito],#(lf)#(tab)UPPER(DD.CodigoDeposito) AS 'Deposito',#(lf)#(tab)em.[DiasMeta],#(lf)#(tab)cast(em.[SaldoFinalAtual] as float) SaldoFinalAtual,#(lf)#(tab)cast(em.[SaldoInicial] as float) SaldoInicial,   #(lf)#(tab)cast(em.[EntradasPeriodo] as float) EntradasPeriodo,#(lf)#(tab)cast(em.[SaidasPeriodo] as float) SaidasPeriodo,     #(lf)#(tab)cast(em.[SaldoForaMeta]#(tab)as float) SaldoForaMeta,    #(lf)#(tab)cast(em.[SaldoDentroMeta] as float) SaldoDentroMeta,#(lf)#(tab)cast(em.[Custo]#(tab)as float) Custo,     #(lf)#(tab)cast(em.[ValorForaMeta] as float) ValorForaMeta,    #(lf)#(tab)cast(em.[ValorDentroMeta] as float) ValorDentroMeta,#(lf)#(tab)em.[Setor],#(lf)#(tab)em.[Responsavel]#(lf)from Fato_EstoqueMeta EM#(lf)left join Dim_Data DDT ON DDT.Id = EM.IdData#(lf)left join Dim_Item DI ON DI.Id = EM.IdItem#(lf)left join Dim_Deposito DD ON  DD.IdDeposito = EM.IdDeposito#(lf)left join Dim_Estabelecimento DE ON DE.Id = EM.IdEstabelec#(lf)WHERE EM.IdEstabelec = '5'#(lf)AND EM.SaldoDentroMeta > 0#(lf)AND EM.SaldoForaMeta > 0"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Data", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

