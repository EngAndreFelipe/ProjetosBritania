	measure '2950 / Indicador' =
			
			CALCULATE(DIVIDE(SUM('Estoque Meta'[SaldoForaMeta]),1),
			ENDOFMONTH('Calendario'[Data]))
		formatString: 0
		lineageTag: 89b99723-adf3-43f5-a023-022357e0e065

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '- FM' = SUM('Estoque Meta'[SaldoForaMeta])
		formatString: 0
		lineageTag: dbc91ddb-9645-4afd-8147-4e046b22b3e5

	measure '- DM' = SUM('Estoque Meta'[SaldoDentroMeta])
		formatString: 0
		lineageTag: fbbb001d-8182-4c8a-979b-650f2d1acfe3

	measure '- %' =
			
			var soma = [- DM]+[- FM]
			return [- DM]/soma
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a62def7d-cd97-4675-9cf2-f77b7ae814b9

