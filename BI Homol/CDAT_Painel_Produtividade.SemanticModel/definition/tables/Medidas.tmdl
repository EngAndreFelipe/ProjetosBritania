	measure Ressup_Pend_Itens = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_Ressup_Origem[Item]),
			    Fato_Ressup_Origem[SituacaoItem] = "Não Iniciado",
			    FILTER(
			        Fato_Ressup_Origem,
			        Fato_Ressup_Origem[Endereco] <> BLANK() &&
			        NOT (
			            CONTAINSSTRING(Fato_Ressup_Origem[Endereco], "RAS") ||
			            CONTAINSSTRING(Fato_Ressup_Origem[Endereco], "TEM") ||
			            CONTAINSSTRING(Fato_Ressup_Origem[Endereco], "WWW") ||
			            CONTAINSSTRING(Fato_Ressup_Origem[Endereco], "ADT")
			        )
			    )
			)
			
