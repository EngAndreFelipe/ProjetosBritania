	measure Separ_Pend_Pecas_D2Corridos =
			
			CALCULATE(
			    SUM(Fato_Consolidacao_Saida[QtdeItemMov]),
			    FILTER(
			        Fato_Consolidacao_Saida,
			        Fato_Consolidacao_Saida[SituacaoItem] <> "Concluído" &&
			        Fato_Consolidacao_Saida[FaixaHoraFim] = "Separação Pendente" &&
			        Fato_Consolidacao_Saida[D2Corridos] >= 2
			    )
			)
		formatString: 0
