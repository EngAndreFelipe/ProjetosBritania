	column 'Ordenação Status' =
			
			SWITCH(
			    TRUE(),
			    'Fato_Onda'[StatusOnda] = "null", 6,
			    'Fato_Onda'[StatusOnda] = "Em Separação", 1,
			    'Fato_Onda'[StatusOnda] = "Conferido Linha", 2,
			    'Fato_Onda'[StatusOnda] = "Stage Conferência", 3,
			    'Fato_Onda'[StatusOnda] = "Expedido" , 4,
			    'Fato_Onda'[StatusOnda] = "Não Integrado", 5)
