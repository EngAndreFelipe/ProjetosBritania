	partition Fato_Onda = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf) [log-agrupado] ,#(lf) f.[serie] ,#(lf) f.[nr-nota-fis] ,#(lf) lf.StatusOnda ,#(lf) le.DataEmissaoNotaFiscal ,#(lf) le.HoraEmissaoNotaFiscal ,#(lf) cv.DescSalesChannel ,#(lf) le.TransportadorRomaneio ,#(lf) f.[qt-faturada] ,#(lf) f.[num-docto] ,#(lf) f.[des-erro] ,#(lf) le.DataSaida ,#(lf) f.[dt-geracao] ,#(lf) f.[cod-depos] ,#(lf) lf.CubagemPrevista ,#(lf) lf.ObservacaoExpedicao #(lf)FROM Stage.tot.BrEcomOnda F#(lf)LEFT  JOIN DW.dbo.Dim_Item DI#(lf)#(tab)#(tab)ON DI.CodItem = F.[it-codigo]#(lf)LEFT  JOIN DW.logistica.Fato_FTB101 LF#(lf)#(tab)#(tab)ON LF.CodEstab = F.[cod-estabel]#(lf)#(tab)#(tab)AND LF.SerieNotaFiscal = F.serie#(lf)#(tab)#(tab)AND LF.NumeroNotaFiscal = F.[nr-nota-fis]#(lf)#(tab)#(tab)AND LF.CodItem = F.[it-codigo]#(lf)LEFT  JOIN DW.logistica.Fato_EcomLogisticaExpedicao LE#(lf)#(tab)#(tab)ON LE.SerienotaFiscal = F.[serie]#(lf)#(tab)#(tab)AND LE.NumeroNotaFiscal = F.[nr-nota-fis]#(lf)LEFT  JOIN Stage.tot.VtexSalesChannel CV#(lf)#(tab)#(tab)ON CV.CodSalesChannel = LE.CanalVenda"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"DataEmissaoNotaFiscal", type date}, {"HoraEmissaoNotaFiscal", type time}, {"dt-geracao", type date},  {"DataSaida", type date},  {"CubagemPrevista", type number}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

