	column FreteCorrigido
		dataType: double
		lineageTag: 9d6d4113-4cbe-4e43-86ed-e854a598fa16
		summarizeBy: sum
		sourceColumn: FreteCorrigido

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition dwGTB201 = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataInicial DATE = DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1);#(lf)#(lf)SELECT #(lf)    gtb.[Estabelecimento],#(lf)    gtb.[SerieNotaFiscal],#(lf)    gtb.[NumeroNotaFiscal],#(lf)    gtb.[NatOperacao],#(lf)    gtb.[Denominacao],#(lf)    gtb.[NomeMatrizTransportador] AS Transportador,#(lf)    gtb.[VlFretePrevisto],#(lf)    gtb.[ValorNotaFiscal],#(lf)    gtb.[NomeAbrev] AS NomeMatriz,#(lf)    gtb.[NumeroPedido],#(lf)    gtb.[CidadeEntrega],#(lf)    gtb.[UfDestino],#(lf)    LTRIM(RTRIM(gtb.[NumeroRomaneio])) AS NumeroRomaneio, -- Trim direto no SQL#(lf)    CAST(gtb.[DataEmissaoNotaFiscal] AS date) AS DataEmissao,#(lf)    CAST(gtb.[DataSaida] AS date) AS DataSaida,#(lf)    gtb.[QuantidadeFaturada] AS QtdeFat,#(lf)    gtb.[PesoBruto],#(lf)    CAST(gtb.[DataCriacaoRomaneio] AS date) AS DataRomaneio,#(lf)#(lf)    -- Substituir null de ValidaDisplay por 'DIVERSOS'#(lf)    ISNULL(vDisplay.ValidaDisplay, 'DIVERSOS') AS ValidaDisplay,#(lf)#(lf)    CASE#(lf)        WHEN ne.[qt-volumes] IS NULL THEN 0#(lf)        ELSE gtb.[VlFretePrevisto]#(lf)    END AS FreteCorrigido,#(lf)#(lf)    -- Coluna TipoFrete#(lf)    CASE#(lf)        WHEN gtb.[NomeMatrizTransportador] LIKE '%BRITANIA%' #(lf)             OR gtb.[NomeMatrizTransportador] LIKE 'RETIRA%' THEN 'FRETE FOB'#(lf)        WHEN gtb.[NumeroPedido] LIKE '%PRO' THEN 'PROCON'#(lf)        WHEN gtb.[NumeroPedido] LIKE '%JUR' THEN 'JURÍDICO'#(lf)        ELSE 'FRETE NORMAL'#(lf)    END AS TipoFrete,#(lf)#(lf)    -- Coluna Transporte#(lf)    CASE#(lf)        WHEN gtb.[NomeMatrizTransportador] LIKE 'J.J%' THEN 'CORREIOS'#(lf)        ELSE 'TRANSPORTADORA'#(lf)    END AS Transporte,#(lf)#(lf)    -- Coluna CidadeUF#(lf)    CONCAT(gtb.[CidadeEntrega], ', ', gtb.[UfDestino]) AS CidadeUF#(lf)#(lf)FROM [DW].[logistica].[Fato_GTB] gtb#(lf)LEFT JOIN STAGE.tot.NotaEmbal ne#(lf)    ON ne.DtEmisNota > @DataInicial#(lf)    AND ne.[cod-estabel] = '15'#(lf)    AND ne.serie IN('5','21')#(lf)    AND ne.[nr-nota-fis] = gtb.NumeroNotaFiscal#(lf)#(lf)-- Consulta Display#(lf)OUTER APPLY (#(lf)    SELECT DISTINCT #(lf)        fatf.IdEstab, #(lf)        fatf.IdEmitente, #(lf)        fatf.NumeroNotaFiscal, #(lf)        fatf.SerieNotaFiscal,#(lf)        MAX(#(lf)            CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN it.DescItem LIKE '%SMARTPHONE%' THEN NULL#(lf)                WHEN it.DescItem LIKE 'DISPLAY%' THEN 'DISPLAY'#(lf)                WHEN it.DescItem LIKE 'TELA LCD%' THEN 'DISPLAY'#(lf)#(tab)#(tab)#(tab)#(tab)WHEN it.DescItem LIKE 'TV%' THEN 'DISPLAY'#(lf)#(tab)#(tab)#(tab)#(tab)WHEN it.DescItem LIKE 'TELA DE CRIST%' THEN 'DISPLAY'#(lf)                WHEN it.DescItem LIKE 'TELA DISPLAY%' THEN 'DISPLAY'#(lf)            END#(lf)        ) AS ValidaDisplay#(lf)    FROM DW.dbo.Fato_Faturamento fatf#(lf)    JOIN DW.dbo.Dim_Item it #(lf)        ON fatf.IdItem = it.Id#(lf)    WHERE fatf.DataEmissaoNotaFiscal > @DataInicial#(lf)        AND fatf.IdEstab = 8#(lf)        AND fatf.SerieNotaFiscal = gtb.SerieNotaFiscal#(lf)        AND fatf.NumeroNotaFiscal = gtb.NumeroNotaFiscal#(lf)    GROUP BY #(lf)        fatf.IdEstab, #(lf)        fatf.IdEmitente, #(lf)        fatf.NumeroNotaFiscal, #(lf)        fatf.SerieNotaFiscal#(lf)) vDisplay#(lf)#(lf)WHERE gtb.Estabelecimento IN('15')#(lf)    AND gtb.SerieNotaFiscal IN(5, 21)#(lf)    AND gtb.DataEmissaoNotaFiscal > @DataInicial#(lf)    AND gtb.NumeroPedido <> ''#(lf)    AND gtb.NomeMatrizTransportador NOT IN('', 'Sem Info');"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

