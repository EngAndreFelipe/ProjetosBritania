	column 'Quantidade Ajustada' = COALESCE(Dim_WMS[Quantidade], 0)
		formatString: 0
		lineageTag: b7fdcd26-acfc-4ee0-96a2-d2eb833517fc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Dim_WMS = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="   SELECT#(lf)        I.Id,#(lf)        W.Item AS CodItem,#(lf)        W.Descricao,#(lf)        SUM(CAST(W.Total - Reservado AS INT)) AS Quantidade#(lf)    FROM DW.logistica.Fato_ESWM9022 AS W#(lf)    LEFT JOIN DW.dbo.Dim_Item AS I ON I.CodItem = W.Item#(lf)    WHERE W.Estab = '15' AND W.Local = 'AAT'#(lf)    GROUP BY I.Id, W.Item, W.Descricao#(lf)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

