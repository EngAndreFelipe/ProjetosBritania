table Dim_Ressuprimento
	lineageTag: fe92a680-fffb-43c8-b0e3-07c97ed41dd5

	measure MensagensEmProcesso =
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( Dim_Ressuprimento[IdMovto] ),
			        Dim_Ressuprimento[SitMensagem] = "Em processo"
			    ),
			    0
			)
		formatString: 0
		lineageTag: 34fd381f-d500-4441-acef-e3c9de7d2cec

	measure MensagensNãoIniciadas =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(Dim_Ressuprimento[IdMovto]),
			    Dim_Ressuprimento[SitMensagem] = "Não Iniciado"
			),0)
		formatString: 0
		lineageTag: 56d66cb4-1fd9-478e-920d-658ee8583172

	measure PeçasFinalizadas =
			
			COALESCE(CALCULATE(
			    SUM(Dim_Ressuprimento[QtdeItemMov]),
			    Dim_Ressuprimento[SitMensagem] = "Finalizado"
			),0)
		formatString: 0
		lineageTag: 92660984-e274-45c9-9577-f8073bb40089

	measure MensagensFinalizadas =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(Dim_Ressuprimento[IdMovto]),
			    Dim_Ressuprimento[SitMensagem] = "Finalizado"
			),0)
		formatString: 0
		lineageTag: d040f297-7a54-4308-8f6f-e37b586dfe3e

	measure UltimaDataCargaMov = MAX(Dim_Ressuprimento[DataCarga])
		formatString: General Date
		lineageTag: 5e34c0af-dd58-4017-897b-39078a7085a0

