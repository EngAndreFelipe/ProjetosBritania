	partition Dim_Ressuprimento = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)    M.IdMovto,#(lf)    M.Documento,#(lf)    M.DataImplantacao,#(lf)    M.NumeroDocumento,#(lf)    M.DtInicioTarefa AS DataExec,#(lf)    M.Item,#(lf)    I.DescItem,#(lf)    M.QtdeItemMov,#(lf)    M.Usuario2,#(lf)    -- SitMensagem consolidada#(lf)    CASE #(lf)        WHEN MAX(CASE WHEN M.SituacaoItem = 'Concluído' THEN 1 END) = 1 THEN 'Finalizado'#(lf)        WHEN MAX(CASE WHEN M.SituacaoItem = 'Não iniciado' AND M.Usuario2 IS NULL THEN 1 END) = 1 THEN 'Não Iniciado'#(lf)        WHEN MAX(CASE WHEN M.SituacaoItem = 'Não iniciado' AND M.Usuario2 IS NOT NULL THEN 1 END) = 1 THEN 'Em processo'#(lf)        ELSE 'Outro status'#(lf)    END AS SitMensagem,#(lf)    -- Endereço de Entrada#(lf)    MAX(CASE WHEN M.Movimento = 'Entrada' THEN M.IdEndereco END) AS IdEnderecoEntrada,#(lf)    MAX(CASE WHEN M.Movimento = 'Entrada' THEN M.Endereco END) AS EnderecoEntrada,#(lf)    -- Endereço de Saída#(lf)    MAX(CASE WHEN M.Movimento = 'Saida' THEN M.IdEndereco END) AS IdEnderecoSaida,#(lf)    MAX(CASE WHEN M.Movimento = 'Saida' THEN M.Endereco END) AS EnderecoSaida,#(lf)    CAST(M.DataCarga AS DATETIME) AS DataCarga#(lf)FROM dw.logistica.Fato_Mov_Estoque_PA_AT AS M#(lf)LEFT JOIN STAGE.tot.WmBox AS E #(lf)    ON M.IdEndereco = E.[id-box]#(lf)LEFT JOIN DW.dbo.Dim_Item AS I#(lf)    ON I.CodItem = M.Item#(lf)WHERE #(lf)    M.Local = 'aat'#(lf)    AND M.NumeroDocumento LIKE 'Ressup-%'#(lf)    AND CAST(M.[DataImplantacao] AS DATE) >= DATEADD(MONTH, -3, GETDATE())#(lf)    AND E.[cod-local] = 'aat'#(lf)GROUP BY M.IdMovto, M.Documento, M.NumeroDocumento, M.Item, I.DescItem, M.QtdeItemMov, M.Usuario2, M.DtInicioTarefa, M.DataImplantacao, M.DataCarga#(lf)ORDER BY M.IdMovto ASC;"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"DataExec", type date}, {"DataCarga", type datetime}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

