table Fato_MovimentaçõesResumo
	lineageTag: bb650b7c-5371-4a1a-bf18-0cb78f4bc174

	column Id
		formatString: 0
		lineageTag: fb6c4a1b-0ab7-4974-b0b6-a632153b082f
		summarizeBy: none
		isNameInferred
		sourceColumn: Fato_Movimentações[Id]

