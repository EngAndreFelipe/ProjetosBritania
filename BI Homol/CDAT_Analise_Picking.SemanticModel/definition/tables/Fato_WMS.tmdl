		annotation SummarizationSetBy = Automatic

	partition Fato_WMS = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="WITH EnderecoSeparado AS (#(lf)    SELECT #(lf)        Endereco,#(lf)        Item,#(lf)        Local,#(lf)        Total,#(lf)        PARSENAME(REPLACE(Endereco, '/', '.'), 4) AS Bloco,#(lf)        PARSENAME(REPLACE(Endereco, '/', '.'), 3) AS Rua,#(lf)        PARSENAME(REPLACE(Endereco, '/', '.'), 2) AS Nivel,#(lf)        PARSENAME(REPLACE(Endereco, '/', '.'), 1) AS Coluna#(lf)    FROM DW.logistica.Fato_ESWM9022#(lf))#(lf)SELECT #(lf)    I.Id AS IdItem,#(lf)    E.Item,#(lf)    CAST(E.Total AS INT) AS Saldo,#(lf)    O.[id-box] AS IdBox,#(lf)    O.[cod-bloco] AS Bloco,#(lf)    O.[cod-rua] AS Rua,#(lf)    O.[cod-nivel] AS Nivel,#(lf)    O.[cod-coluna] AS Coluna#(lf)FROM EnderecoSeparado E#(lf)LEFT JOIN STAGE.tot.wmbox O#(lf)    ON E.Bloco  = O.[cod-bloco]#(lf)   AND E.Rua    = O.[cod-rua]#(lf)   AND E.Nivel  = O.[cod-nivel]#(lf)   AND E.Coluna = O.[cod-coluna]#(lf)LEFT JOIN DW.dbo.Dim_Item AS I ON I.CodItem = E.Item#(lf)WHERE E.Local = 'aat';"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

