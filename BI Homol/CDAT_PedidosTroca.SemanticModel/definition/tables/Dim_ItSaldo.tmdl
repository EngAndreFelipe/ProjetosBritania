	column SaldoTotal = (Dim_ItSaldo[AAT]) + (Dim_ItSaldo[AT2]) + (Dim_ItSaldo[AT4]) + (Dim_ItSaldo[EX2]) + (Dim_ItSaldo[EX4]) + (Dim_ItSaldo[EX3]) + (Dim_ItSaldo[PK4])
		formatString: 0
		lineageTag: 8103448e-1293-4dee-8af6-d33061ae2103
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ValidaSaldo =
			SWITCH(
			                TRUE(),
			                    Dim_ItSaldo[SaldoTotal] = 0, "Sem saldo",
			                    Dim_ItSaldo[SaldoTotal] > 0, "Com saldo")
		lineageTag: a9301ae5-2b56-45a9-a843-e1edd29bb8fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_ItSaldo = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf)    [it-codigo] AS Item,#(lf)    CAST(ISNULL([AT2], 0) AS INT) AS AT2,#(lf)    CAST(ISNULL([EX2], 0) AS INT) AS EX2,#(lf)    CAST(ISNULL([EX3], 0) AS INT) AS EX3,#(lf)    CAST(ISNULL([AT4], 0) AS INT) AS AT4,#(lf)    CAST(ISNULL([EX4], 0) AS INT) AS EX4,#(lf)    CAST(ISNULL([AAT], 0) AS INT) AS AAT,#(lf)    CAST(ISNULL([PK4], 0) AS INT) AS PK4#(lf)FROM (#(lf)    SELECT#(lf)        [it-codigo],#(lf)        [cod-depos],#(lf)        [qtidade-atu]#(lf)    FROM STAGE.tot.SaldoEstoq#(lf)    WHERE#(lf)        LEN([it-codigo]) = 9#(lf)        AND (#(lf)            [it-codigo] LIKE '0%' #(lf)            OR [it-codigo] LIKE '10%'#(lf)        )#(lf)        AND [it-codigo] NOT LIKE '02%'#(lf)) AS src#(lf)PIVOT (#(lf)    SUM([qtidade-atu]) #(lf)    FOR [cod-depos] IN (#(lf)        [AT2], [EX2], [EX3], #(lf)        [AT4], [EX4], [AAT], [PK4]#(lf)    )#(lf)) AS pvt;"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

