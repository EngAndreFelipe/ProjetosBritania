	column DataProgEntrega
		dataType: dateTime
		formatString: Short Date
		lineageTag: 68ffa8c7-183f-4ba9-b995-db2357ccf28c
		summarizeBy: none
		sourceColumn: DataProgEntrega

		variation Variation
			isDefault
			relationship: 2f0baacd-645a-4ddc-bafe-b2da5bda37f6
			defaultHierarchy: LocalDateTable_4025d062-76ce-4d94-aa5a-c85e3761d122.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column PrazoEntrega =
			
			VAR DataInicial = COALESCE(Fato_AcompEntregas[DataSaida], Fato_AcompEntregas[DataEmissaoNotaFiscal])
			VAR DiasTransito = Fato_AcompEntregas[TransTime]
			RETURN
			    CALCULATE (
			        MAXX (
			            TOPN (
			                DiasTransito,
			                FILTER (
			                    ALL ( Dim_Data ),
			                    Dim_Data[Data] > DataInicial &&
			                    Dim_Data[DiaUtil] = TRUE
			                ),
			                Dim_Data[Data],
			                ASC
			            ),
			            Dim_Data[Data]
			        )
			    )
		formatString: Short Date
		lineageTag: f16ecefc-ab6b-435f-9ba8-0ffbfcecc08e
		summarizeBy: none

		variation Variation
			isDefault
			relationship: e935a4c4-0638-4d44-b5a6-4b027b9e186c
			defaultHierarchy: LocalDateTable_5bb63558-222d-457c-a095-a82fd22295a6.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column StatusNota = ```
			
			VAR Prazo = Fato_AcompEntregas[TransTime]
			VAR DiasUteisRestantes = Fato_AcompEntregas[DiasUteisRestantes]
			VAR DataPrazo = Fato_AcompEntregas[PrazoEntrega]
			VAR DataSaida = Fato_AcompEntregas[DataSaida]
			VAR StatusEntrega = Fato_AcompEntregas[Status]
			VAR Porcentagem = ROUND(DIVIDE(DiasUteisRestantes, Prazo, 0), 2)
			RETURN
			    IF(
			        StatusEntrega = "Entrega Pendente",
			        IF(
			            ISBLANK(DataSaida),
			            "Não Expedida",
			            IF(
			                ISBLANK(DataPrazo),
			                "Sem Prazo Definido",
			                IF(
			                    DataPrazo < TODAY(),
			                    "Atraso",
			                    SWITCH(
			                        TRUE(),
			                        Prazo <= 5 && Porcentagem < 0.4, "Risco de Atraso",
			                        Prazo <= 5 && Porcentagem < 0.6, "Atenção",
			                        Prazo <= 5, "Sob Controle",
			
			                        Prazo <= 15 && Porcentagem < 0.3, "Risco de Atraso",
			                        Prazo <= 15 && Porcentagem < 0.6, "Atenção",
			                        Prazo <= 15, "Sob Controle",
			
			                        Prazo > 15 && Porcentagem <= 0.2, "Risco de Atraso",
			                        Prazo > 15 && Porcentagem < 0.4, "Atenção",
			                        Prazo > 15, "Sob Controle",
			
			                        TRUE, "Sob Controle"
			                    )
			                )
			            )
			        ),
			        "Entregue"
			    )
			
			```
		lineageTag: 73387908-638a-460b-91ae-b01f3b902a5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DiasUteisRestantes = ```
			
			VAR StatusEntrega = Fato_AcompEntregas[Status]
			VAR PrazoEntrega = Fato_AcompEntregas[PrazoEntrega]
			VAR Hoje = TODAY()
			
			VAR DiasRestantes =
			    CALCULATE(
			        COUNTROWS(Dim_Data),
			        FILTER(
			            Dim_Data,
			            Dim_Data[Data] > Hoje &&
			            Dim_Data[Data] <= PrazoEntrega &&
			            Dim_Data[DiaUtil] = TRUE()
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        // Já entregue
			        StatusEntrega IN { "Entregue no Prazo", "Entregue em Atraso" },
			            0,
			
			        // Prazo é hoje
			        StatusEntrega = "Entrega Pendente" && PrazoEntrega = Hoje,
			            0,
			
			        // Prazo ainda está à frente
			        StatusEntrega = "Entrega Pendente" && Hoje < PrazoEntrega,
			            DiasRestantes,
			
			        // Prazo já passou
			        StatusEntrega = "Entrega Pendente" && Hoje > PrazoEntrega,
			            0,
			
			        BLANK()
			    )
			
			```
		formatString: 0
		lineageTag: cb849ef9-d79d-4e14-a0a8-5ea90c459b5f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DiasUteisAtraso = ```
			
			VAR StatusEntrega = Fato_AcompEntregas[Status]
			VAR PrazoEntrega = Fato_AcompEntregas[PrazoEntrega]
			VAR TempoEntrega = Fato_AcompEntregas[TempoEntrega]
			VAR TransTime = Fato_AcompEntregas[TransTime]
			VAR Hoje = TODAY()
			
			VAR AtrasoNaoEntregue =
			    CALCULATE(
			        COUNTROWS(Dim_Data),
			        FILTER(
			            Dim_Data,
			            Dim_Data[Data] > PrazoEntrega &&
			            Dim_Data[Data] <= Hoje &&
			            Dim_Data[DiaUtil] = TRUE()
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        // Entregue no prazo → sem atraso
			        StatusEntrega = "Entregue no Prazo", 
			            0,
			
			        // Entregue em atraso → compara tempo real com tempo previsto
			        StatusEntrega = "Entregue em Atraso" && NOT ISBLANK(TempoEntrega) && NOT ISBLANK(TransTime),
			            MAX(0, TempoEntrega - TransTime),
			
			        // Entrega pendente → prazo ainda não venceu (Hoje <= PrazoEntrega)
			        StatusEntrega = "Entrega Pendente" && NOT ISBLANK(PrazoEntrega) && Hoje <= PrazoEntrega,
			            0,
			
			        // Entrega pendente → prazo já passou
			        StatusEntrega = "Entrega Pendente" && NOT ISBLANK(PrazoEntrega) && Hoje > PrazoEntrega,
			            AtrasoNaoEntregue,
			
			        // Qualquer outro caso → sem informação
			        BLANK()
			    )
			
			```
		lineageTag: 7a62017e-17ce-4307-ae72-560ae6494a28
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column NatOperacao
		dataType: string
		lineageTag: 5cd18f61-db22-4913-9e8c-908b8f0425e4
		summarizeBy: none
		sourceColumn: NatOperacao

		annotation SummarizationSetBy = Automatic

	partition Fato_AcompEntregas = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT  #(lf)    NF.[SERIE] AS SerieNotaFiscal,#(lf)    NF.[nr-nota-fis] AS NumeroNotaFiscal,#(lf)    NF.[dt-emis-nota] AS DataEmissaoNotaFiscal,#(lf)    NE.[qt-volumes] AS QtVolumes,#(lf)    CASE #(lf)        WHEN NE.[qt-volumes] IS NULL OR NE.[qt-volumes] = 0 THEN 'Complemento'#(lf)        ELSE 'Master'#(lf)    END AS TipoNota,#(lf)    F.SituacaoNota AS SituacaoNota,#(lf)    NF.[nat-operacao] AS NatOperacao,#(lf)    N.[Denominacao],#(lf)    NF.[dt-saida] AS DataSaida,#(lf)    COALESCE(NULLIF(NF.[dt-entr-cli], ''), FAT_APPLY.DataEntregaCliente) AS DataEntrega,#(lf)    NF.[dt-cancela] AS DataCancelamento,#(lf)    FAT_APPLY.DataPrevisaoEntrega AS DataPrevisaoEntrega,#(lf)    NF.[nome-ab-cli] AS Representante,#(lf)    F.TipoFrete AS TipoFrete,#(lf)    UPPER(NF.[cidade]) AS CidadeDestino,#(lf)    NF.[estado] AS EstadoDestino,#(lf)    F.VlFretePrevisto AS VlFretePrevisto,#(lf)    F.[VlFretePago],#(lf)    NF.[vl-tot-nota] AS TotalNota,#(lf)    F.[QuantidadeFaturada],#(lf)    F.[QuantidadeDevolvida],#(lf)    F.[QuantidadeAbatida],#(lf)    F.[ValorFreteReentrega],#(lf)    F.[ValorFreteDevolucao],#(lf)    F.[NumeroRomaneio],#(lf)    F.[SituacaoCalculo],#(lf)    F.[UsuarioCalculo],#(lf)    F.[VolumeM3] * 167 AS PesoCubico,#(lf)    F.[PesoBruto],#(lf)    F.[Ocorrencia],#(lf)    F.ObservacaoCarga AS ObservacaoCarga,#(lf)    NF.[cod-chave-aces-nf-eletro] AS ChaveNFe,#(lf)    NF.[nome-transp] AS NomeTransportadoraNF,#(lf)    NF.[DataCarga],#(lf)    F.[NomeMatrizTransportador],#(lf)    F.[CodigoFrete],#(lf)    F.[DataEnvioFinanceiro],#(lf)    PDB.[NumeroPedido],#(lf)    PDB.[NomeMatriz],#(lf)    PDB.[NumeroOS],#(lf)    CASE #(lf)        WHEN LTRIM(RTRIM(PDB.[NumeroOS])) IS NULL OR LTRIM(RTRIM(PDB.[NumeroOS])) = '' THEN 'NÃO'#(lf)        ELSE 'SIM'#(lf)    END AS OS,#(lf)    GV6.GV6_QTPRAZ AS TransTime,#(lf)    FAT_APPLY.[DataProgEntrega] #(lf)FROM [STAGE].[tot].[NotaFiscal] NF#(lf)LEFT JOIN [DW].[dbo].[Dim_Natureza] N #(lf)       ON NF.[nat-operacao] = N.[NatOperacao]#(lf)OUTER APPLY (#(lf)    SELECT TOP 1 FAT.*#(lf)    FROM [DW].[dbo].[Fato_Faturamento] FAT#(lf)    WHERE NF.[SERIE] = FAT.[SerieNotaFiscal]#(lf)      AND NF.[nr-nota-fis] = FAT.[NumeroNotaFiscal]#(lf)    ORDER BY FAT.[DataProgEntrega]#(lf)) FAT_APPLY#(lf)LEFT JOIN [DW].[auditoria].[Fato_CustosFrete_Faturamento] F #(lf)       ON NF.[SERIE] = F.[SerieNotaFiscal] #(lf)      AND NF.[nr-nota-fis] = F.[NumeroNotaFiscal]#(lf)LEFT JOIN [STAGE].[tot].[NotaEmbal] NE #(lf)       ON NF.[SERIE] = NE.[serie] #(lf)      AND NF.[nr-nota-fis] = NE.[nr-nota-fis]#(lf)LEFT JOIN (#(lf)    SELECT #(lf)        SerieNotaFiscal,#(lf)        NotaFiscal,#(lf)        STRING_AGG(NumeroPedido, ' / ') AS NumeroPedido,#(lf)        MIN(NomeMatriz) AS NomeMatriz,#(lf)        CASE #(lf)            WHEN COUNT(NULLIF(LTRIM(RTRIM(NumeroOS)), '')) = 0 THEN NULL#(lf)            ELSE STRING_AGG(NumeroOS, ' / ')#(lf)        END AS NumeroOS#(lf)    FROM [DW].[logistica].[Fato_PDB381]#(lf)    GROUP BY SerieNotaFiscal, NotaFiscal#(lf)) PDB #(lf)       ON NF.[SERIE] = PDB.SerieNotaFiscal #(lf)      AND NF.[nr-nota-fis] = PDB.NotaFiscal#(lf)LEFT JOIN STAGE.gfe.GWH nrclc #(lf)       ON NF.[SERIE] = nrclc.GWH_SERDC #(lf)      AND NF.[nr-nota-fis] = nrclc.GWH_NRDC#(lf)      AND ISNULL(LTRIM(RTRIM(nrclc.D_E_L_E_T_)), '') = ''#(lf)LEFT JOIN STAGE.gfe.GWG gwgchv #(lf)       ON nrclc.GWH_NRCALC = gwgchv.GWG_NRCALC#(lf)LEFT JOIN STAGE.gfe.GV6 GV6 #(lf)       ON gwgchv.GWG_NRTAB = GV6.GV6_NRTAB #(lf)      AND gwgchv.GWG_NRNEG = GV6.GV6_NRNEG #(lf)      AND gwgchv.GWG_CDFXTV = GV6.GV6_CDFXTV #(lf)      AND gwgchv.GWG_NRROTA = GV6.GV6_NRROTA#(lf)      AND gwgchv.GWG_CDEMIT = GV6.GV6_CDEMIT#(lf)      AND ISNULL(LTRIM(RTRIM(GV6.D_E_L_E_T_)), '') = ''#(lf)WHERE NF.[cod-estabel] = '15'#(lf)  AND NF.[SERIE] IN (5, 21)#(lf)  AND NF.[dt-emis-nota] BETWEEN '2025-07-01' AND GETDATE()#(lf)  AND F.SituacaoNota = 'Faturada'#(lf)  AND NF.[dt-cancela] IS NULL"]),
				    #"Linhas Filtradas" = Table.SelectRows(Fonte, each [DataEmissaoNotaFiscal] > RangeStart and [DataEmissaoNotaFiscal] <= RangeEnd),
