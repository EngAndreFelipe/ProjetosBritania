	column TempoEntrega = ```
			
			VAR DataSaida = Fato_AcompEntregas[DataSaida]
			VAR DataEntrega = Fato_AcompEntregas[DataEntrega]
			VAR DataEmissaoNF = Fato_AcompEntregas[DataEmissaoNotaFiscal]
			
			VAR DataInicial = 
			    IF(
			        ISBLANK(DataSaida) && NOT ISBLANK(DataEntrega),
			        Fato_AcompEntregas[DataEmissaoNotaFiscal],
			        DataSaida
			    )
			
			VAR DiasUteis = 
			    COUNTROWS(
			        FILTER(
			            Dim_Data,
			            Dim_Data[Data] > DataInicial &&
			            Dim_Data[Data] <= DataEntrega &&
			            Dim_Data[DiaUtil] = TRUE()
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(DataSaida) && ISBLANK(DataEntrega),
			        BLANK(),
			        IF(
			            ISBLANK(DataEntrega),
			            BLANK(),
			            IF(
			                DataSaida = DataEntrega,
			                0,
			                DiasUteis
			            )
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 2b9619dc-4dfb-46a0-bd8c-47fe9fdde4b9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DataPrevisaoEntrega
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 3bbd39e2-ffa1-4e5b-a3cb-09858d0cd1e7
		summarizeBy: none
		sourceColumn: DataPrevisaoEntrega

		variation Variation
			isDefault
			relationship: 0768c946-95bf-4b27-a6cc-83a3eb86e758
			defaultHierarchy: LocalDateTable_fb2a1a17-8135-47d3-8d1a-e9cec4dba736.'Hierarquia de datas'

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Status =
			
			VAR DataEntrega = Fato_AcompEntregas[DataEntrega]
			VAR DataProgEntrega = Fato_AcompEntregas[DataProgEntrega]
			VAR TempoEntrega = Fato_AcompEntregas[TempoEntrega]
			VAR TransTime = Fato_AcompEntregas[TransTime]
			RETURN
			    IF (
			        ISBLANK(DataEntrega),
			        "Entrega Pendente",
			        IF (
			            NOT ISBLANK(DataProgEntrega),
			            IF (
			                TempoEntrega <= TransTime || DataProgEntrega >= DataEntrega,
			                "Entregue no Prazo",
			                "Entregue em Atraso"
			            ),
			            IF (
			                TempoEntrega <= TransTime,
			                "Entregue no Prazo",
			                "Entregue em Atraso"
			            )
			        )
			    )
		lineageTag: e4d14e2b-10fb-40f7-a019-b27f2a42dd98
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

