	column ChvID
		lineageTag: c259a76e-5d9e-4b4f-ac85-ab85fb9cc530
		summarizeBy: none
		isNameInferred
		sourceColumn: [ChvId]

		annotation SummarizationSetBy = Automatic

	partition IncicadoresCalc = calculated
		mode: import
		source = ```
				
				VAR tb1 = SUMMARIZE(f_AtendimentoOS,f_AtendimentoOS[ID_2385], "IdIndicador", "2385", "Ano", YEAR(MAX(f_AtendimentoOS[DtIndicador])), "Mes", MONTH(MAX(f_AtendimentoOS[DtIndicador])), "MesAno", MAX(f_AtendimentoOS[DtIndicador]),
				    "RealizadoNumerador", SUMX(FILTER(f_AtendimentoOS, f_AtendimentoOS[Status] = TRUE()),f_AtendimentoOS[QuantidadeAtendida]),
				    "RealizadoDenominador", SUM(f_AtendimentoOS[QuantidadeAtendida])
				)
				VAR tb2 = SUMMARIZE(f_AtendimentoOS,f_AtendimentoOS[ID_2386], "IdIndicador", "2386", "Ano", YEAR(MAX(f_AtendimentoOS[DtIndicador])), "Mes", MONTH(MAX(f_AtendimentoOS[DtIndicador])),"MesAno", MAX(f_AtendimentoOS[DtIndicador]),
				    "RealizadoNumerador", SUMX(FILTER(f_AtendimentoOS, f_AtendimentoOS[StatusOs] = TRUE()),f_AtendimentoOS[QuantidadeAtendida]),
				    "RealizadoDenominador", SUMX(FILTER(f_AtendimentoOS, f_AtendimentoOS[StatusOs] = TRUE()),f_AtendimentoOS[QuantidadeAtendida]) + 
				        SUMX(FILTER(f_AtendimentoOS, f_AtendimentoOS[StatusOs] <> TRUE() && f_AtendimentoOS[Log_Erro] = BLANK()),f_AtendimentoOS[QuantidadeAtendida])
				)
				VAR tb3 = UNION(tb1, tb2)
				VAR addChave = ADDCOLUMNS(tb3, "ChvID", [IdIndicador] &"."& [Ano] &"."& [Mes])
				VAR addColDiasUteis = ADDCOLUMNS(addChave, "DiasUteis", BLANK())
				VAR tb = SELECTCOLUMNS(addColDiasUteis, [IdIndicador], [Ano], [Mes], [RealizadoNumerador], [RealizadoDenominador], [MesAno], [DiasUteis], [ChvID])
				
				VAR tb_padrao =
				    SELECTCOLUMNS(
				        tb,
				        "IdIndicador", [IdIndicador],
				        "Ano", [Ano],
				        "Mes", [Mes],
				        "RealizadoNumerador", [RealizadoNumerador],
				        "RealizadoDenominador", [RealizadoDenominador],
				        "MesAno", [MesAno],
				        "DiasUteis", [DiasUteis],
				        "ChvID", [ChvID]
				    )
				
				VAR dw_padrao =
				    SELECTCOLUMNS(
				        f_IndicadoresDW,
				        "IdIndicador", [IdIndicador],
				        "Ano", [Ano],
				        "Mes", [Mes],
				        "RealizadoNumerador", [RealizadoNumerador],
				        "RealizadoDenominador", [RealizadoDenominador],
				        "MesAno", [MesAno],
				        "DiasUteis", [DiasUteis],
				        "ChvID", [ChvID]
				    )
				
				RETURN
				    UNION(tb_padrao, dw_padrao)
				
				
				```

	annotation PBI_Id = 3b46784dfd72411cb588a5ac34c86874

