table Medidas
	lineageTag: ef5562db-4022-417d-9f35-d46ecee152c4

	measure _% =
			
			VAR numerador = SUM(f_Sgm[RealNumerador])
			VAR denominador = SUM(f_Sgm[RealDenominador])
			VAR real = DIVIDE(numerador, denominador, 0)
			RETURN
			    IF(ISBLANK(numerador) && ISBLANK(denominador), BLANK(),
			        FORMAT(real, SELECTEDVALUE(f_Sgm[Formato]))
			    )
		lineageTag: ff33a160-ccc7-49d3-8c5d-0d2440903e8b

		annotation PBI_FormatHint = {"isText":true}

	measure '_ Meta' =
			
			VAR metap = DIVIDE(CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[MesAno])), 100)
			VAR meta = CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[MesAno]))
			VAR formato = SELECTEDVALUE(f_Sgm[Formato])
			RETURN
			    SWITCH(
			        TRUE(),
			        formato = "0.00%", metap,  -- Deixa como número
			        formato = "#,#0.00", meta,  -- Deixa como número
			        meta  -- Default, em caso de valor não identificado
			    )
		lineageTag: 2d7bb70d-d0a7-417a-ada3-d15049bf4b1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_ Realizado' = DIVIDE(SUM(f_Sgm[RealNumerador]), SUM(f_Sgm[RealDenominador]))
		lineageTag: b3185eb7-f855-46ed-9bd3-33d6b71aae21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _CorFonte = ```
			
			VAR numerador = SUM(f_Sgm[RealNumerador])
			VAR denominador = SUM(f_Sgm[RealDenominador])
			VAR real = DIVIDE(numerador, denominador, 0)
			VAR meta = CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[Mes])) / IF(SELECTEDVALUE(f_Sgm[Formato]) = "0.00%", 100, 1)
			VAR vr = IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima", meta * 0.95, meta * 1.05)
			RETURN
			IF(ISBLANK(numerador), BLANK(),
			    IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima",
			        IF(real >= meta, "#FFFFFF",
			            IF(real < vr, "#FFFFFF", "#000000")
			        )
			    ,
			        IF(real <= meta, "#FFFFFF",
			            IF(real > vr, "#FFFFFF", "#000000")
			        )
			    )
			)
			
			
			
			
			
			
			
			
			```
		lineageTag: 6c2209c6-1738-44f6-93e4-3b8ea7920313

	measure _CorFundo =
			
			VAR numerador = SUM(f_Sgm[RealNumerador])
			VAR denominador = SUM(f_Sgm[RealDenominador])
			VAR real = DIVIDE(numerador, denominador, 0)
			VAR meta = CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[Mes])) / IF(SELECTEDVALUE(f_Sgm[Formato]) = "0.00%", 100, 1)
			VAR vr = IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima", meta * 0.95, meta * 1.05)
			RETURN
			
			IF(ISBLANK(numerador), BLANK(),
			    IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima",
			        IF(real >= meta, "#008000",
			            IF(real < vr, "#800080", "#FFFF00")
			        )
			    ,
			        IF(real <= meta, "#008000",
			            IF(real > vr, "#800080", "#FFFF00")
			        )
			    )
			)
		lineageTag: 1e850fe9-02d3-406b-af4f-791dc298d577

