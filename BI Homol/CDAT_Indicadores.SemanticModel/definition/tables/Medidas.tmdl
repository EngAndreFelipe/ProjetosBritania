	measure CorFonteFiltro =
			
			VAR numerador = SUM(f_Sgm[RealNumerador])
			VAR denominador = SUM(f_Sgm[RealDenominador])
			VAR real = DIVIDE(numerador, denominador, 0)
			VAR meta = CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[Mes])) / IF(SELECTEDVALUE(f_Sgm[Formato]) = "0.00%", 100, 1)
			VAR vr = IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima", meta * 0.95, meta * 1.05)
			RETURN
			
			IF(ISBLANK(numerador), BLANK(),
			    IF(SELECTEDVALUE(f_Sgm[TipoIndicador]) = "Para cima",
			        IF(real >= meta, "#3F953F",
			            IF(real < vr, "#AC95DA", "#E8D166")
			        )
			    ,
			        IF(real <= meta, "#3F953F",
			            IF(real > vr, "#AC95DA", "#E8D166")
			        )
			    )
			)
