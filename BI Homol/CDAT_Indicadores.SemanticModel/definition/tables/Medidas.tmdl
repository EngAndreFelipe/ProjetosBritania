	measure Meta =
			
			VAR metap = DIVIDE(CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[MesAno])), 100)
			VAR meta = CALCULATE(MAX(f_Sgm[Meta_Indicador]), ALLSELECTED(f_Sgm[MesAno]))
			VAR formato = SELECTEDVALUE(f_Sgm[Formato])
			RETURN
			    SWITCH(
			        TRUE(),
			        formato = "0.00%", FORMAT(metap, "0.00%"),  -- Deixa como número
			        formato = "#,#0.00", FORMAT(meta, "#,#0.00"),  -- Deixa como número
			        meta  -- Default, em caso de valor não identificado
