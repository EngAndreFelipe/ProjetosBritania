	column DiasUteisOs =
			
			var DtInicial = 'f_AtendimentoOS'[DataImplantacao]
			var DtFinal = 'f_AtendimentoOS'[DataSaida]
			var DiasUteis = CALCULATE(SUM(dCalendario[DiaUtilCalc]), FILTER(dCalendario, dCalendario[Calendario] >='f_AtendimentoOS'[DataImplantacao] && dCalendario[Calendario] <= 'f_AtendimentoOS'[DataSaida]))
			RETURN
			    DiasUteis -1
