		source =
				let
				    ID2985_86 = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataImplantacao DATE = EOMONTH(DATEADD(MONTH, - 4, GETDATE()));#(lf)DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = '2985' --  AT.CD.2985 - ATENDIMENTO DE PEÇAS COM OS EM ATÉ DOIS DIAS ÚTEIS#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = '2985' --  AT.CD.2985 - ATENDIMENTO DE PEÇAS COM OS EM ATÉ DOIS DIAS ÚTEIS#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)#(lf)-- Valida se tabela Temp existe e Deleta#(lf)IF OBJECT_ID('tempdb..#Filtered_PDB') IS NOT NULL#(lf)#(tab)DROP TABLE #Filtered_PDB;#(lf)#(lf)#(lf)SELECT p.NumeroPedido#(lf)#(tab),p.DataImplantacao#(lf)#(tab),p.CodEmitente#(lf)#(tab),p.QuantidadeAtendida#(lf)#(tab),p.DataSaida#(lf)#(tab),p.NotaFiscal#(lf)#(tab),p.SerieNotaFiscal#(lf)#(tab),p.EstabNotaFiscal#(lf)#(tab),p.SitCreditoPed#(lf)#(tab),p.CreditoPosto#(lf)#(tab),p.PedidoCompleto#(lf)#(tab),p.SitPedido#(lf)#(tab),p.CreditoCliente#(lf)#(tab),p.SitCredenciamento#(lf)INTO #Filtered_PDB#(lf)FROM DW.logistica.Fato_PDB381 p WITH (NOLOCK)#(lf)--Desconsidera Notas Canceladas#(lf)LEFT JOIN auditoria.Fato_CustosFrete_Faturamento acf WITH (NOLOCK) #(lf)#(tab)ON p.NotaFiscal = acf.NumeroNotaFiscal#(lf)#(tab)#(tab)AND p.SerieNotaFiscal = acf.SerieNotaFiscal#(lf)#(tab)#(tab)AND acf.DataEmissaoNotaFiscal >= @DataImplantacao#(lf)WHERE p.DataImplantacao > @DataImplantacao#(lf)#(tab)AND p.DataSaida BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)AND p.SitPedido IN ('2','3','5')#(lf)#(tab)AND p.SerieNotaFiscal IN (5,21)#(lf)#(tab)AND p.NumeroOS <> ''#(lf)#(tab)AND acf.IdDataCancelamento IS NULL;#(lf)#(lf)-- Consulta Log de Erro FTB400#(lf)WITH ConsLog AS (#(lf)#(tab)SELECT DISTINCT lg.POSTO#(lf)#(tab)#(tab),FORMAT(lg.DATA_ARQUIVO, 'yyyyMM') AS ANO_MES#(lf)#(tab)#(tab),lg.PEDIDO + CAST(lg.POSTO AS VARCHAR) AS ChvPedCliente#(lf)#(tab)#(tab),'Log Erro' AS LOG_ERRO#(lf)#(tab)FROM STAGE.excel.LogErroFTB400 lg WITH (NOLOCK)#(lf)#(tab)WHERE DATA_ARQUIVO BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(lf)#(tab)#(tab)AND NOT EXISTS (#(lf)#(tab)#(tab)#(tab)SELECT 1#(lf)#(tab)#(tab)#(tab)FROM (#(lf)#(tab)#(tab)#(tab)#(tab)VALUES ('Estado diferente')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),('Natureza em garantia e emite duplicata')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),('Emitente fora da faixa')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),('atendido total ou cance')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),('embarcado ou faturado')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),('')#(lf)#(tab)#(tab)#(tab)#(tab)) AS l(Descricao)#(lf)#(tab)#(tab)#(tab)WHERE CHARINDEX(l.Descricao, lg.LOG_DE_ERRO) > 0#(lf)#(tab)#(tab)#(tab))#(lf)),#(lf)tbPdbCalc AS (#(lf)#(tab)SELECT #(lf)#(tab)pdb.DataImplantacao#(lf)#(tab),CAST(pdb.DataSaida AS DATE) DataSaida#(lf)#(tab),CAST(pdb.QuantidadeAtendida AS INT) AS QuantidadeAtendida#(lf)#(tab),CASE #(lf)#(tab)#(tab)WHEN UPPER(pdb.SitCredenciamento) = 'N'#(lf)#(tab)#(tab)#(tab)THEN 'LogErro'#(lf)#(tab)#(tab)WHEN pdb.SitCreditoPed = 'Não Aprovado' #(lf)#(tab)#(tab)#(tab)THEN 'LogErro'#(lf)#(tab)#(tab)ELSE cl.LOG_ERRO#(lf)#(tab)END AS Log_Erro#(lf)#(tab), DATEDIFF(DAY, pdb.DataImplantacao, pdb.DataSaida) DiasCorridos#(lf)FROM #Filtered_PDB pdb#(lf)#(tab)LEFT JOIN dbo.Dim_SituacaoPedido sp WITH (NOLOCK) ON pdb.SitPedido = sp.CodSitPed#(lf)#(tab)LEFT JOIN ConsLog cl WITH (NOLOCK) ON FORMAT(pdb.DataSaida, 'yyyyMM') = cl.ANO_MES#(lf)#(tab)#(tab)AND pdb.NumeroPedido + CAST(pdb.CodEmitente AS VARCHAR) = cl.ChvPedCliente#(lf))#(lf)#(lf)SELECT DATEFROMPARTS(@ANO, @MES, 1) DtIndicador#(lf)#(tab),*#(lf)FROM tbPdbCalc"]),
				    TipoAlterado =
				        Table.TransformColumnTypes(ID2985_86,{{"DataImplantacao", type date}, {"DataSaida", type date}, {"DtIndicador", type date}})
				in
