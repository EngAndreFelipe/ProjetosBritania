		source =
				let
				    ID_3140_CustoFrete = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataInicial DATE = EOMONTH(DATEADD(MONTH, -4,GETDATE())); #(lf)DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '3140' -- AT.CD.3140 - CUSTO DE FRETE AT - CIF#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbCustoFrete AS(#(lf)#(tab)SELECT gtb.[SerieNotaFiscal]#(lf)#(tab)#(tab),gtb.[NumeroNotaFiscal]#(lf)#(tab)#(tab),gtb.[DataSaida]#(lf)#(tab)#(tab),gtb.[QuantidadeFaturada] AS QtdeFat#(lf)#(tab)#(tab),CASE#(tab)#(lf)#(tab)#(tab)#(tab)WHEN ne.[sigla-emb] IS NULL THEN 0#(lf)#(tab)#(tab)#(tab)ELSE gtb.[VlFretePrevisto]#(lf)#(tab)#(tab)END AS FreteCorrigido#(lf)#(tab)FROM [DW].[logistica].[Fato_GTB] gtb#(lf)#(tab)#(tab)LEFT JOIN STAGE.tot.NotaEmbal ne#(lf)#(tab)#(tab)#(tab)ON DtEmisNota >  @DataInicial#(lf)#(tab)#(tab)#(tab)#(tab)AND [cod-estabel] = '15'#(lf)#(tab)#(tab)#(tab)#(tab)AND serie IN('5','21')#(lf)#(tab)#(tab)#(tab)#(tab)AND [nr-nota-fis] = gtb.NumeroNotaFiscal#(lf)#(tab)--#(lf)#(tab)WHERE gtb.Estabelecimento IN('15')#(lf)  #(tab)#(tab)AND gtb.SerieNotaFiscal IN(5, 21)#(lf)  #(tab)#(tab)AND gtb.DataEmissaoNotaFiscal > @DataInicial#(lf)  #(tab)#(tab)AND gtb.NumeroPedido NOT IN('')#(lf)#(tab)#(tab)AND gtb.NomeMatrizTransportador NOT IN('','Sem Info')#(lf)#(tab)#(tab)AND gtb.DataSaida BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND gtb.NomeMatrizTransportador NOT LIKE 'BRITANIA%'#(lf)#(tab)#(tab)AND gtb.NomeMatrizTransportador NOT LIKE 'RETIRA%'#(lf))#(lf)SELECT @ID IdIndicador -- AT.CD.3140 - CUSTO DE FRETE AT - CIF#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),SUM(FreteCorrigido) RealizadoNumerador#(lf)#(tab),SUM(QtdeFat) RealizadoDenominador#(lf)FROM tbCustoFrete"]),
				    ID_0628_ExpD2 = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataImplantacao DATE = EOMONTH(DATEADD(MONTH, - 4, GETDATE()));#(lf)DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '628' -- AT.CD.0628 - PEÇAS EXPEDIDAS EM D+2#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbExpAT AS(#(lf)#(tab)SELECT CASE#(lf)#(tab)#(tab)#(tab)WHEN SomaDiaUtil.DiasExp > 2 THEN 'Atraso'#(lf)#(tab)#(tab)#(tab)ELSE 'Numerador'#(lf)#(tab)#(tab)END STATUS#(lf)#(tab)#(tab),pdb.QuantidadeAtendida QuantidadeAtendida#(lf)#(tab)FROM DW.logistica.Fato_PDB381 pdb WITH (NOLOCK)#(lf)#(tab)--Desconsidera Notas Canceladas#(lf)#(tab)LEFT JOIN auditoria.Fato_CustosFrete_Faturamento acf WITH (NOLOCK) ON pdb.NotaFiscal = acf.NumeroNotaFiscal#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal = acf.SerieNotaFiscal#(lf)#(tab)#(tab)AND acf.DataEmissaoNotaFiscal BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)-- Calcula Dias Úteis#(lf)#(tab)OUTER APPLY (#(lf)#(tab)#(tab)SELECT COALESCE(CASE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN SUM(CAST(DiaUtil AS INT)) - 1 < 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE SUM(CAST(DiaUtil AS INT)) - 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END, 0) AS DiasExp#(lf)#(tab)#(tab)FROM DW.dbo.Dim_Data#(lf)#(tab)#(tab)WHERE Data BETWEEN CASE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN pdb.DataEmbarque IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)THEN pdb.DtFaturamento#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE pdb.DataEmbarque#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(tab)#(tab)#(tab)AND pdb.DataSaida#(lf)#(tab)#(tab)) SomaDiaUtil#(lf)#(tab)--#(lf)#(tab)WHERE pdb.DataImplantacao > @DataImplantacao#(lf)#(tab)#(tab)AND pdb.DataSaida BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND pdb.SitPedido IN ('2','3','5')#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal IN (5,21)#(lf)#(tab)#(tab)AND acf.IdDataCancelamento IS NULL#(lf))#(lf)SELECT @ID IdIndicador -- AT.CD.0628 - PEÇAS EXPEDIDAS EM D+2#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),SUM(CASE WHEN STATUS = 'Numerador' THEN QuantidadeAtendida ELSE 0 END) RealizadoNumerador#(lf)#(tab),SUM(QuantidadeAtendida)  RealizadoDenominador#(lf)FROM tbExpAT"]),
				    ID_0568_IRP = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @DataImplantacao DATE = EOMONTH(DATEADD(MONTH, - 4, GETDATE()));#(lf)DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '568' -- AT.CD.0568 - ÍNDICE DE RECLAMAÇÃO DOS POSTOS#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbIRP AS(#(lf)#(tab)SELECT DISTINCT CAST(pdb.DataSaida AS DATE) dtSaida#(lf)#(tab)#(tab),pdb.NotaFiscal#(lf)#(tab)#(tab),pdb.SerieNotaFiscal#(lf)#(tab)#(tab),pdb.EstabNotaFiscal#(lf)#(tab)#(tab),CASE #(lf)#(tab)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPE'#(lf)#(tab)#(tab)#(tab)#(tab)THEN '-Errado'#(lf)#(tab)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPQ'#(lf)#(tab)#(tab)#(tab)#(tab)THEN '-Qudebrado'#(lf)#(tab)#(tab)#(tab)WHEN RIGHT(pdb.NumeroOS, 3) = 'RPF'#(lf)#(tab)#(tab)#(tab)#(tab)THEN '-Faltante'#(lf)#(tab)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END IRP#(lf)#(tab)FROM DW.logistica.Fato_PDB381 pdb WITH (NOLOCK)#(lf)#(tab)--Desconsidera Notas Canceladas#(lf)#(tab)LEFT JOIN auditoria.Fato_CustosFrete_Faturamento acf WITH (NOLOCK) ON pdb.NotaFiscal = acf.NumeroNotaFiscal#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal = acf.SerieNotaFiscal#(lf)#(tab)#(tab)AND acf.DataEmissaoNotaFiscal BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)WHERE acf.IdDataCancelamento IS NULL#(lf)#(tab)#(tab)AND  pdb.DataImplantacao > @DataImplantacao#(lf)#(tab)#(tab)AND pdb.DataSaida BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND pdb.SitPedido IN ('2','3','5')#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal IN (5,21)#(lf))#(lf)SELECT @ID IdIndicador -- AT.CD.0568 - ÍNDICE DE RECLAMAÇÃO DOS POSTOS#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),SUM(CASE WHEN IRP IS NOT NULL THEN 1 ELSE 0 END) RealizadoNumerador #(lf)#(tab),COUNT(NotaFiscal) RealizadoDenominador#(lf)FROM tbIRP"]),
				    DI_0058_EntregaPrazo = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '58' --  AT.CD.0058 - % ENTREGAS NO PRAZO AT#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbEntrga AS(#(lf)#(tab)SELECT DISTINCT aud.SerieNotaFiscal#(lf)#(tab)#(tab),aud.NumeroNotaFiscal#(lf)#(tab)#(tab),CAST(dtsaida.Data AS DATE) DataSaida#(lf)#(tab)#(tab),CAST(dtentrega.Data AS DATE) DataEntrega#(lf)#(tab)#(tab)-- Notas com data de programação de entrega serão consideradas No Prazo #(lf)#(tab)#(tab), CASE#(lf)#(tab)#(tab)#(tab)WHEN IdDataProgEntrega IS NOT NULL THEN 'NO PRAZO'#(lf)#(tab)#(tab)#(tab)WHEN SomaDiaUtil.DiasExp <= aud.TransTime THEN 'NO PRAZO'#(lf)#(tab)#(tab)#(tab)ELSE 'ATRASO'#(lf)#(tab)#(tab)END STATUS#(lf)#(tab)FROM auditoria.Fato_CustosFrete_Faturamento aud#(lf)#(tab)#(tab)LEFT JOIN dbo.Dim_Data dtsaida #(lf)#(tab)#(tab)#(tab)ON aud.IdDataSaida = dtsaida.id#(lf)#(tab)#(tab)LEFT JOIN dbo.Dim_Data dtentrega #(lf)#(tab)#(tab)#(tab)ON aud.IdDataEntrega = dtentrega.id#(lf)#(tab)OUTER APPLY (#(lf)#(tab)#(tab)SELECT COALESCE(CASE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN SUM(CAST(DiaUtil AS INT)) - 1 < 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE SUM(CAST(DiaUtil AS INT)) - 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END, 0) AS DiasExp#(lf)#(tab)#(tab)FROM DW.dbo.Dim_Data#(lf)#(tab)#(tab)WHERE Data BETWEEN dtsaida.Data#(tab)AND dtentrega.Data#(lf)#(tab)#(tab)) SomaDiaUtil#(lf)#(tab)WHERE aud.SerieNotaFiscal IN (5#(tab),21)#(lf)#(tab)#(tab)AND aud.IdEstab = 8#(lf)#(tab)#(tab)AND dtentrega.Data BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND aud.IdDataCancelamento IS NULL#(lf))#(lf)SELECT @ID IdIndicador --  AT.CD.0058 - % ENTREGAS NO PRAZO AT#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),SUM(CASE WHEN STATUS = 'NO PRAZO' THEN 1 ELSE 0 END) RealizadoNumerador#(lf)#(tab),COUNT(STATUS) RealizadoDenominador#(lf)FROM tbEntrga"]),
				    ID_2509_Produtividade = Sql.Database("PR-S188\DW", "DW", [Query="--EXPEDIÇÃO AT#(lf)DECLARE @DataImplantacao DATE = EOMONTH(DATEADD(MONTH, - 4, GETDATE()));#(lf)DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '2509' -- AT.CD.2509 - PRODUTIVIDADE AT#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbExpedicao AS(#(lf)#(tab)SELECT SUM(pdb.QuantidadeAtendida) Expedicao#(lf)#(tab)FROM DW.logistica.Fato_PDB381 pdb WITH (NOLOCK)#(lf)#(tab)--Desconsidera Notas Canceladas#(lf)#(tab)LEFT JOIN auditoria.Fato_CustosFrete_Faturamento acf WITH (NOLOCK) ON pdb.NotaFiscal = acf.NumeroNotaFiscal#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal = acf.SerieNotaFiscal#(lf)#(tab)#(tab)AND acf.DataEmissaoNotaFiscal BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)WHERE pdb.DataImplantacao > @DataImplantacao#(lf)#(tab)#(tab)AND pdb.DataSaida BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND pdb.SitPedido IN ('2','3','5')#(lf)#(tab)#(tab)AND pdb.SerieNotaFiscal IN (5,21)#(lf)#(tab)#(tab)AND acf.IdDataCancelamento IS NULL#(lf)),#(lf)tbRecebimento AS(#(lf)#(tab)--Calculo Recebimento#(lf)#(tab)SELECT SUM(QtdeItemMov) Recebimento#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT DISTINCT NumeroDocumento#(lf)#(tab)#(tab)#(tab)#(tab),QtdeItemMov#(lf)#(tab)#(tab)#(tab)FROM logistica.Fato_Mov_Estoque_PA_AT feat#(lf)#(tab)#(tab)#(tab)WHERE  LOCAL = 'AAT'#(lf)#(tab)#(tab)#(tab)#(tab)AND feat.Movimento = 'Entrada'#(lf)#(tab)#(tab)#(tab)#(tab)AND feat.Origem = 'Transferência Origem'#(lf)#(tab)#(tab)#(tab)#(tab)AND feat.DtFimTarefa BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)) AS MovEst#(lf)),#(lf)tbDesmonte AS(#(lf)#(tab)--Calculo Desmonte#(lf)#(tab)SELECT SUM(Quantidade) Desmonte#(lf)#(tab)FROM logistica.Fato_WM0620#(lf)#(tab)WHERE Documento LIKE '%DESC%'#(lf)#(tab)#(tab)AND Quantidade IS NOT NULL#(lf)#(tab)#(tab)AND DtFimTarefa BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)#(tab)AND Local = 'AAT'#(lf)),#(lf)tbRessup AS(#(lf)#(tab)--Calculo Ressuprimento#(lf)#(tab)SELECT SUM(QtdeItemMov) Ressuprimento#(lf)#(tab)FROM  (#(lf)#(tab)#(tab)SELECT DISTINCT NumeroDocumento#(tab)#(lf)#(tab)#(tab)#(tab),QtdeItemMov#(lf)#(tab)#(tab)FROM logistica.Fato_Mov_Estoque_PA_AT feat#(lf)#(tab)#(tab)WHERE  LOCAL = 'AAT'#(lf)#(tab)#(tab)#(tab)AND feat.Movimento = 'Entrada'#(lf)#(tab)#(tab)#(tab)AND feat.Origem = 'Transferência Destino'#(lf)#(tab)#(tab)#(tab)AND feat.DtFimTarefa BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)#(tab)AND EOMONTH(DATEFROMPARTS(@ANO, @MES, 1))#(lf)#(tab)) AS tbRessup#(lf)),#(lf)tbFuncionarios AS(#(lf)-- CALCULO FUNCIONARIOS#(lf)-- Não considerar horário comercial#(lf)-- Considerar op deposito, op empilhadeira, conferente e almoxarife#(lf)-- Data de Admissão 10 dias anterior a data atual#(lf)SELECT COUNT(DISTINCT f.cdn_funcionario) qtdeFuncionarios#(lf)FROM STAGE.tot.Funcionario f#(lf)#(tab)LEFT JOIN [STAGE].tot.SitAfastFunc sa#(lf)#(tab)#(tab)ON sa.cdn_estab = f.cdn_estab#(lf)#(tab)#(tab)#(tab)AND sa.cdn_empresa = f.cdn_empresa#(lf)#(tab)#(tab)#(tab)AND sa.cdn_funcionario = f.cdn_funcionario#(lf)#(tab)#(tab)#(tab)-- MOTIVO AFASTAMENTO - SUPERIOR A 15 DIAS OU MATERNIDADE#(lf)#(tab)#(tab)#(tab)AND sa.cdn_sit_afast_func IN('17','21','22','50')#(lf)#(tab)JOIN STAGE.tot.RHCargo cg#(lf)#(tab)#(tab)ON f.cdn_cargo_basic = cg.cdn_cargo_basic#(lf)#(tab)#(tab)#(tab)AND (cg.des_cargo LIKE 'OPERADOR DE DEP%'#(lf)#(tab)#(tab)#(tab)#(tab)OR cg.des_cargo LIKE 'ALMOXAR%'#(lf)#(tab)#(tab)#(tab)#(tab)OR cg.des_cargo LIKE 'OPERADOR DE EMP%'#(lf)#(tab)#(tab)#(tab)#(tab)OR cg.des_cargo LIKE 'CONFERENTE%'#(lf)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)AND NOT cg.des_cargo LIKE '%MATERIAIS%'#(lf)#(tab)JOIN STAGE.tot.RHTurnoTrabalho tt#(lf)#(tab)#(tab)ON f.cdn_turno_trab = tt.cdn_turno_trab#(lf)#(tab)#(tab)#(tab)AND (tt.des_turno_trab LIKE 'TA%'#(lf)#(tab)#(tab)#(tab)#(tab)OR tt.des_turno_trab LIKE 'TB%'#(lf)#(tab)#(tab)#(tab)#(tab)OR tt.des_turno_trab LIKE 'TC%')#(lf)WHERE f.cod_rh_ccusto = '23210'#(lf)#(tab)AND f.dat_desligto_func IS NULL#(lf)#(tab)AND sa.dat_term_proces_sit_afast <= CAST(GETDATE() AS DATE)#(lf)#(tab)AND f.dat_admis_func < DATEADD(DAY, -10,CAST(GETDATE() AS DATE))#(lf)),#(lf)-- Calcula Dias Úteis#(lf)tbDiasUteis AS(#(lf)#(tab)SELECT COALESCE(CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN SUM(CAST(DiaUtil AS INT)) - 1 < 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 0#(lf)#(tab)#(tab)#(tab)#(tab)ELSE SUM(CAST(DiaUtil AS INT)) - 1#(lf)#(tab)#(tab)#(tab)#(tab)END, 0) AS DiasUteis#(lf)#(tab)FROM DW.dbo.Dim_Data#(lf)#(tab)WHERE Data BETWEEN DATEFROMPARTS(@ANO, @MES, 1) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)AND CASE WHEN GETDATE() > EOMONTH(DATEFROMPARTS(@ANO, @MES, 1)) THEN#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) EOMONTH(DATEFROMPARTS(@ANO, @MES, 1)) ELSE CAST(GETDATE() AS DATE)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf))#(lf)SELECT  @ID IdIndicador -- AT.CD.2509 - PRODUTIVIDADE AT#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),ISNULL(tbDesmonte.Desmonte, 0) +#(lf)#(tab)#(tab)ISNULL(tbExpedicao.Expedicao, 0) +#(lf)#(tab)#(tab)ISNULL(tbRecebimento.Recebimento, 0) +#(lf)#(tab)#(tab)ISNULL(tbRessup.Ressuprimento, 0) AS RealizadoNumerador#(lf)#(tab),tbFuncionarios.qtdeFuncionarios RealizadoDenominador#(lf)#(tab),tbDiasUteis.DiasUteis#(lf)FROM tbDesmonte#(lf)#(tab),tbExpedicao#(lf)#(tab),tbRecebimento#(lf)#(tab),tbRessup#(lf)#(tab),tbFuncionarios#(lf)#(tab),tbDiasUteis"]),
				    ID_3139_Ageing130 = Sql.Database("PR-S188\DW", "DW", [Query="DECLARE @MES INT;#(lf)DECLARE @ANO INT;#(lf)DECLARE @ID INT;#(lf)#(lf)SELECT @ID = '3139' -- AT.AG.3139 - AGING DEPÓSITOS TRANSITÓRIOS CDAT ESTABELECIMENTO 130#(lf)#(lf)-- ANO#(lf)SELECT @ANO = MIN(Ano)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL;#(lf)#(lf)-- MES#(lf)SELECT @MES = MIN(Mes)#(lf)FROM DW.AT.GestaoMetas#(lf)WHERE IdIndicador = @ID#(lf)#(tab)AND MetaIndicador IS NOT NULL#(lf)#(tab)AND RealizadoNumerador IS NULL#(lf)#(tab)AND Ano = @ANO;#(lf)#(lf)WITH tbAging AS(#(lf)#(tab)SELECT est.CodEstab#(lf)#(tab)#(tab),dep.CodigoDeposito#(lf)#(tab)#(tab),SUM(fem.ValorDentroMeta) vlDentroMeta#(lf)#(tab)#(tab),SUM(fem.ValorForaMeta) vlForaMeta#(lf)#(tab)#(tab),SUM(fem.ValorDentroMeta) + SUM(fem.ValorForaMeta) vlTotal#(lf)#(tab)FROM dbo.Fato_EstoqueMeta fem#(lf)#(tab)INNER JOIN dbo.Dim_Deposito dep#(lf)#(tab)#(tab)ON fem.IdDeposito = dep.IdDeposito#(lf)#(tab)#(tab)#(tab)AND dep.CodigoDeposito IN('BEC','DRE','RCB','REC')#(lf)#(tab)LEFT JOIN dbo.Dim_Estabelecimento est#(lf)#(tab)#(tab)ON fem.IdEstabelec = est.Id#(lf)#(tab)WHERE IdEstabelec = '59' --130#(lf)#(tab)#(tab)AND fem.IdData =  (SELECT MAX(IdData) FROM dbo.Fato_EstoqueMeta) #(lf)#(tab)GROUP BY est.CodEstab#(lf)#(tab)#(tab),dep.CodigoDeposito#(lf))#(lf)SELECT @ID IdIndicador -- AT.AG.3139 - AGING DEPÓSITOS TRANSITÓRIOS CDAT ESTABELECIMENTO 130#(lf)#(tab),@ANO Ano#(lf)#(tab),@MES Mes#(lf)#(tab),SUM(vlDentroMeta) RealizadoNumerador#(lf)#(tab),SUM(vlTotal) RealizadoDenominador#(lf)FROM tbAging"]),
