	partition TabelaFinal = calculated
		mode: import
		source =
				
				UNION(
				    // Linhas reais
				    SELECTCOLUMNS(
				        Fato_Rastreio,
				        "DataImplantacao", [DataImplantacao],
				        "Item", [Item],
				        "Descricao", [Descricao],
				        "IdEndereco", [IdEndereco],
				        "Endereco", [Endereco],
				        "Saldo DCV", [Saldo DCV],
				        "Saldo AAT", [Saldo AAT],
				        "Saldo Total", [Saldo Total],
				        "Saldo WMS", [Saldo WMS],
				        "Ordem", [IdEndereco] * 10,
				        "Preenchimento", "Não"
				    ),
				
				    // Linha em branco 1
				    SELECTCOLUMNS(
				        FILTER(Fato_Rastreio, NOT(ISBLANK([Endereco]))),
				        "DataImplantacao", BLANK(),
				        "Item", [Item],
				        "Descricao", BLANK(),
				        "IdEndereco", [IdEndereco],
				        "Endereco", BLANK(),
				        "Saldo DCV", BLANK(),
				        "Saldo AAT", BLANK(),
				        "Saldo Total", BLANK(),
				        "Saldo WMS", BLANK(),
				        "Ordem", [IdEndereco] * 10 + 1,
				        "Preenchimento", "Sim"
				    ),
				
				    // Linha em branco 2
				    SELECTCOLUMNS(
				        FILTER(Fato_Rastreio, NOT(ISBLANK([Endereco]))),
				        "DataImplantacao", BLANK(),
				        "Item", [Item],
				        "Descricao", BLANK(),
				        "IdEndereco", [IdEndereco],
				        "Endereco", BLANK(),
				        "Saldo DCV", BLANK(),
				        "Saldo AAT", BLANK(),
				        "Saldo Total", BLANK(),
				        "Saldo WMS", BLANK(),
				        "Ordem", [IdEndereco] * 10 + 2,
				        "Preenchimento", "Sim"
				    ),
				
				    // Linha em branco 3
				    SELECTCOLUMNS(
				        FILTER(Fato_Rastreio, NOT(ISBLANK([Endereco]))),
				        "DataImplantacao", BLANK(),
				        "Item", [Item],
				        "Descricao", BLANK(),
				        "IdEndereco", [IdEndereco],
				        "Endereco", BLANK(),
				        "Saldo DCV", BLANK(),
				        "Saldo AAT", BLANK(),
				        "Saldo Total", BLANK(),
				        "Saldo WMS", BLANK(),
				        "Ordem", [IdEndereco] * 10 + 3,
				        "Preenchimento", "Sim"
				    )
				)

	annotation PBI_Id = 16e06f2e47a04c97b380a4376bdc6fb9

