	partition Fato_Estoque-1c701a9a-f92f-47ef-b59f-0bfb8fdd8e43 = m
		mode: import
		queryGroup: NOVO
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT F.QuantidadeDisponivel,#(lf)       D.CodigoDeposito,#(lf)       E.CodEstab,#(lf)       i.CodItem#(lf)FROM Fato_SaldoEstoque F#(lf)JOIN Dim_Localizacao L ON L.IdLocalizacao = F.IdLocalizacao#(lf)JOIN Dim_Estabelecimento E ON E.Id = L.idEstab#(lf)JOIN Dim_Deposito D ON D.IdDeposito = L.IdDeposito#(lf)JOIN dbo.Dim_Item i ON F.IdItem = i.Id#(lf)JOIN dbo.Dim_Data dt on dt.id = f.iddata#(lf)where dt.Data >= DATEFROMPARTS(YEAR(GETDATE()) - 2, 1, 1)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

