table Medidas
	lineageTag: f9c20d5a-150e-40b2-8d46-fd021d4081f4

	measure '# PROD' =
			
			CALCULATE(SUM(Fato_Sapp[Realizado]),
			FILTER(Fato_Sapp, Fato_Sapp[Data] >= DATE(YEAR(TODAY()),MONTH(TODAY()),1)))
			+
			CALCULATE(SUM(Fato_PcPMaster[produzido]),
			FILTER(Fato_PcPMaster,Fato_PcPMaster[data-programacao] >= DATE(YEAR(TODAY()),MONTH(TODAY()),1)))
		formatString: #,0
		lineageTag: a80fced7-6557-4103-97e8-41af599c7811

	measure '# Reportada' =
			CALCULATE(SUM(Fato_Movimento[QTD]),
