	partition Fato_WMS = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="select Estab, Local, Item, Descricao, Endereco, CAST(Total AS INT) AS Total, DataCarga#(lf)from DW.logistica.Fato_ESWM9022#(lf)where Estab = '15' #(lf)and Local = 'aat'#(lf)and Item LIKE '8%'"]),
				    #"Consultas Mescladas" = Table.NestedJoin(Fonte, {"Item"}, Tabela_Minimo, {"Item"}, "Tabela_Minimo", JoinKind.LeftOuter),
				    #"Tabela_Minimo Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "Tabela_Minimo", {"Mínimo"}, {"Tabela_Minimo.Mínimo"}),
