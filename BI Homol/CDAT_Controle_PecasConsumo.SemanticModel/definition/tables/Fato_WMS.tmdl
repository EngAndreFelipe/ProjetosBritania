table Fato_WMS
	lineageTag: 4f27dd64-888b-442a-bb94-93278aa7a938

	measure SaldoPorItem =
			
			CALCULATE(
			    SUM(Fato_WMS[Total]),
			    ALLEXCEPT(Fato_WMS, Fato_WMS[Item])
			)
		formatString: 0
		lineageTag: 9f0d5729-faad-43c3-8049-000ce325f583

	measure PrecisaRepor =
			
			VAR Saldo = [SaldoPorItem]
			VAR Minimo = MAX(Fato_WMS[MinimoItem])
			RETURN
			IF(
			    ISBLANK(Saldo) || ISBLANK(Minimo),
			    BLANK(),
			    IF(Saldo < Minimo, "Sim", "Não")
			)
		formatString: 0
		lineageTag: f8df708e-5c23-4e17-8a61-bb1f53a167e6

