table Fato_IndicadoresCic
	lineageTag: 2cb11e31-064a-42bd-b14e-688ae329c1f8

	measure SaldoContabilTotal = SUM(Fato_IndicadoresCic[Quantidade])
		formatString: 0
		lineageTag: ae1f0489-9801-46d7-a58d-7a60c8406b90

	measure MetaAcuraciaQuantidade = VALUE("0,9850")
		lineageTag: 7014bca5-a3aa-40f2-af0a-214120549e24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Contabil-Divergencia(Quantidade) = [SaldoContabilTotal] - [Totalajustes (Quantidade)]
		formatString: 0
		lineageTag: f2cdef4d-d1ab-4f6a-b616-fc5a61e8622d

	measure AcuraciaQuantidade = DIVIDE([Contabil-Divergencia(Quantidade)], [SaldoContabilTotal])
		lineageTag: f0e104fc-aace-4907-8843-24e1fc296e57

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MetaAcuraciaPosição = VALUE("0,9676")
