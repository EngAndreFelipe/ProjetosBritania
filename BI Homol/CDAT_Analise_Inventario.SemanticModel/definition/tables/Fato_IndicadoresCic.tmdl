		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ValorContabilTotal = SUM(Fato_IndicadoresCic[Valor Contabil])
		lineageTag: fb94d8a7-b9e4-4ff2-8894-4fc3e5babe9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Contabil-Divergencia(Valor) = [ValorContabilTotal] - [Totalajustes (Valor)]
		lineageTag: 66a3dfdf-4030-4824-aaeb-062e2feed4a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AcuraciaValor = DIVIDE([Contabil-Divergencia(Valor)], [ValorContabilTotal])
		lineageTag: 6fa95b65-71a2-4762-a0b9-825caea90c88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Totalajustes (Valor)' = SUM(Fato_IndicadoresCic[Valor Ajustado])
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: d309844f-1584-4e50-a21b-c537c7146ffc

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Totalajustes (Quantidade)' = SUM(Fato_IndicadoresCic[Ajustado])
		formatString: 0
		lineageTag: c7cba705-3084-49ec-9141-c16ddfed51cc

	measure 'Atingimento Valor' = DIVIDE([AcuraciaValor],[MetaAcuraciaValor])
		lineageTag: 6cfd21ff-4929-4289-817d-b70c3498a5ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Atingimento Posição' = DIVIDE([AcuraciaPorDia], [MetaAcuraciaPosição])
		lineageTag: 8fac49c1-c2eb-41ee-8e71-cb7d009578a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Atingimento Quantidade' = DIVIDE([AcuraciaQuantidade],[MetaAcuraciaQuantidade])
		lineageTag: 1e45d27d-f526-446d-90d3-92c4f309f50d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

