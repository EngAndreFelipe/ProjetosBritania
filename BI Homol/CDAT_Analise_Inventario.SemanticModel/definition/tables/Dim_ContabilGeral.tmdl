	partition Dim_ContabilGeral = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)    [it-codigo] AS Item,#(lf)    CAST(ISNULL([AAT],0) AS INT) AS AAT,#(lf)    CAST(ISNULL([DCV],0) AS INT) AS DCV,#(lf)    CAST(ISNULL([REC],0) AS INT) AS REC,#(lf)    CAST(ISNULL([RCB],0) AS INT) AS RCB,#(lf)    CAST(ISNULL([NAT],0) AS INT) AS NAT,#(lf)    CAST(ISNULL([DEV],0) AS INT) AS DEV#(lf)FROM (#(lf)    SELECT #(lf)        [it-codigo],#(lf)        [cod-depos],#(lf)        [qtidade-atu]#(lf)    FROM STAGE.tot.SaldoEstoq#(lf)    WHERE [cod-estabel] = '15'#(lf)) AS src#(lf)PIVOT (#(lf)    SUM([qtidade-atu]) #(lf)    FOR [cod-depos] IN ([AAT], [DCV], [REC], [RCB], [NAT], [DEV])#(lf)) AS pvt"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

