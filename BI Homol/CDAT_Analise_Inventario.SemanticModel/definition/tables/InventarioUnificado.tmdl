table InventarioUnificado
	lineageTag: 00cfa5aa-d469-4237-80e6-108fad7cf91b

	measure AcuracidadePorRua =
			
			VAR PosicoesCorretas =
			    CALCULATE (
			        DISTINCTCOUNT ( InventarioUnificado[IdBox] ),
			        InventarioUnificado[AcuracidadePorPosicaoUltimaData] = "Correto",
			        FILTER (
			            InventarioUnificado,
			            InventarioUnificado[Bloco] IN { "PCK", "RUA", "VAL" }&& NOT ( InventarioUnificado[Rua] IN { "25", "32", "01", "02", "46", "39", "40", "41", "42", "43", "44", "45", "47", "48" } )
			        )
			    )
			VAR PosicoesTotais =
			    CALCULATE (
			        DISTINCTCOUNT ( InventarioUnificado[IdBox] ),
			        NOT ISBLANK ( InventarioUnificado[AcuracidadePorPosicaoUltimaData] ),
			        FILTER (
			            InventarioUnificado,
			            InventarioUnificado[Bloco] IN { "PCK", "RUA", "VAL" }
			                && NOT ( InventarioUnificado[Rua] IN { "25", "32", "01", "02", "46", "39", "40", "41", "42", "43", "44", "45", "47", "48" } )
			        )
			    )
			RETURN
			DIVIDE ( PosicoesCorretas, PosicoesTotais )
		lineageTag: 6e929ef3-fade-4715-9ada-42c5e9028e68

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ContagemEnderecosGeral =
			
			CALCULATE(
			    DISTINCTCOUNT(InventarioUnificado[IdBox]),
			    KEEPFILTERS( InventarioUnificado[Bloco] IN {"RUA", "VAL", "PCK"} ),
			    KEEPFILTERS( NOT ( InventarioUnificado[RUA] IN {"25",  "32"} ) )
			)
		formatString: 0
		lineageTag: e1de79be-8ba2-458d-a166-682fd51ad73b

	measure ContagemEnderecosPCKGeral = CALCULATE(DISTINCTCOUNT(InventarioUnificado[IdBox]),InventarioUnificado[Bloco]="PCK")
		formatString: 0
		lineageTag: 9ae75a9e-eef4-4de0-8711-0f1f2549b483

	measure ContagemEnderecosRUAGeral =
			
			CALCULATE(
			    DISTINCTCOUNT(InventarioUnificado[IdBox]),
			    -- Mantém apenas Bloco = RUA ou VAL
			    KEEPFILTERS( InventarioUnificado[Bloco] IN {"RUA", "VAL"} ),
			    -- Exclui RUA 25, 31 e 32
			    KEEPFILTERS( NOT ( InventarioUnificado[RUA] IN {"25", "31", "32"} ) )
			)
		formatString: 0
		lineageTag: 3b58d8d3-7781-4338-9e5a-b2f6339161ed

	measure AcuraciaPorRua =
			
			VAR PosicoesCorretas =
			    CALCULATE (
			        DISTINCTCOUNT ( InventarioUnificado[IdBox] ),
			        InventarioUnificado[AcuracidadePorPosicaoUltimaData] = "Correto",
			        InventarioUnificado[Bloco] IN { "PCK", "RUA", "VAL" },
			        TREATAS (
			            SELECTCOLUMNS ( UltimaDataPorBoxCiclo, "IdBox", [IdBox], "UltimaData", [UltimaData] ),
			            InventarioUnificado[IdBox],
			            InventarioUnificado[DataInventario]
			        )
			    )
			VAR PosicoesTotais =
			    CALCULATE (
			        DISTINCTCOUNT ( InventarioUnificado[IdBox] ),
			        NOT ISBLANK ( InventarioUnificado[AcuracidadePorPosicaoUltimaData] ),
			        InventarioUnificado[Bloco] IN { "PCK", "RUA", "VAL" },
			        TREATAS (
			            SELECTCOLUMNS ( UltimaDataPorBoxCiclo, "IdBox", [IdBox], "UltimaData", [UltimaData] ),
			            InventarioUnificado[IdBox],
			            InventarioUnificado[DataInventario]
			        )
			    )
			RETURN
			DIVIDE ( PosicoesCorretas, PosicoesTotais )
		lineageTag: f1c687ec-8fe8-46e0-a8fe-7dd4752efdcf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

