	partition InventarioUnificado = calculated
		mode: import
		source =
				
				UNION (
				    SELECTCOLUMNS (
				        Fato_InvPrimeiroCiclo,
				        "IdBox", Fato_InvPrimeiroCiclo[IdBox],
				        "Bloco", Fato_InvPrimeiroCiclo[Bloco],
				        "Rua", Fato_InvPrimeiroCiclo[Rua],
				        "DataInventario", Fato_InvPrimeiroCiclo[DataInventario],
				        "AcuracidadePorPosicaoUltimaData", Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData], "EquipeContagem", Fato_InvPrimeiroCiclo[EquipeContagem],
				        "Ciclo", "Primeiro"
				    ),
				    SELECTCOLUMNS (
				        Fato_InvSegundoCiclo,
				        "IdBox", Fato_InvSegundoCiclo[IdBox],
				        "Bloco", Fato_InvSegundoCiclo[Bloco],
				        "Rua", Fato_InvSegundoCiclo[Rua],
				        "DataInventario", Fato_InvSegundoCiclo[DataInventario],
				        "AcuracidadePorPosicaoUltimaData", Fato_InvSegundoCiclo[AcuracidadePorPosicaoUltimaData], "EquipeContagem", Fato_InvSegundoCiclo[EquipeContagem],
				        "Ciclo", "Segundo"
				    )
				)

	annotation PBI_Id = 0050578e071c4b35b2d47c5e4248b51e

