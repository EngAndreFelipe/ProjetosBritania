table Fato_Contabil
	lineageTag: e2e8865e-1d09-40b0-8e4e-dfb1a4d9d66c

	column Item
		dataType: string
		lineageTag: 5a0b2b04-95d8-450d-b15f-57126bd64a86
		summarizeBy: none
		sourceColumn: Item

		annotation SummarizationSetBy = Automatic

	column Descrição
		dataType: string
		lineageTag: d6df9368-f318-4fd3-ac37-94fe363ccaf2
		summarizeBy: none
		sourceColumn: Descrição

		annotation SummarizationSetBy = Automatic

	column Quantidade
		dataType: int64
		formatString: 0
		lineageTag: e1612466-1ee8-4b71-9a1b-4bc055e062b1
		summarizeBy: sum
		sourceColumn: Quantidade

		annotation SummarizationSetBy = Automatic

	column Depósito
		dataType: string
		lineageTag: 1e666389-02b4-439d-9d02-82891e71b7c1
		summarizeBy: none
		sourceColumn: Depósito

		annotation SummarizationSetBy = Automatic

	partition Fato_Contabil = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT #(lf)  S.[it-codigo] AS 'Item',#(lf)  I.[DescItem] AS 'Descrição',#(lf)  SUM(CONVERT(INT,S.[qtidade-atu],0)) AS 'Quantidade',#(lf)  UPPER(S.[cod-depos]) AS 'Depósito'#(lf)FROM #(lf)  STAGE.tot.SaldoEstoq AS S#(lf)LEFT JOIN #(lf)  DW.dbo.Dim_Item AS I ON S.[it-codigo] = I.[CodItem]#(lf)WHERE #(lf)  (S.[cod-depos] = 'rec' or S.[cod-depos] = 'aat' or S.[cod-depos] = 'dcv' or S.[cod-depos] = 'inf')#(lf)  AND S.[cod-estabel] = '15' #(lf)  AND S.[qtidade-atu] <> 0#(lf)  AND CodItem NOT LIKE ''#(lf)#(lf)GROUP BY S.[it-codigo], I.[DescItem], S.[cod-depos]#(lf)#(lf)"])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

