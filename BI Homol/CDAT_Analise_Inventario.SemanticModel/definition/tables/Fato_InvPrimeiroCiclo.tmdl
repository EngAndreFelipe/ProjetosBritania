table Fato_InvPrimeiroCiclo
	excludeFromModelRefresh
	lineageTag: 435e8b7e-c7e5-4fc0-a4b3-caa487155e27

	measure QtdCorretosPrimeiroCiclo = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			    Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData] = "Correto"
			)
			
			```
		formatString: 0
		lineageTag: fcd554c6-e89d-4e05-ad54-6b76e6c3dc4e

	measure QtdIncorretosPrimeiroCiclo =
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			    Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData] = "Incorreto"
			)
		formatString: 0
		lineageTag: 3cbbecfc-b816-491e-968a-c4f403522c3c

	measure TaxaAcuracia = DIVIDE([QtdCorretosPrimeiroCiclo], Fato_InvPrimeiroCiclo[ContagemEnderecosPrimeiroCiclo], 0)
		lineageTag: bba25199-6374-4210-a711-f333f537d0a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ContagemEnderecosPrimeiroCiclo = ```
			
			    DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox])
			```
		formatString: 0
		lineageTag: ab93aaaf-196d-4409-97fe-62a9cf26af90

	measure QtdCorretosAcumuladoPrimeiroCiclo = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			    FILTER(
			        ALLSELECTED(Fato_InvPrimeiroCiclo),
			        Fato_InvPrimeiroCiclo[DataInventario] <= MAX(Fato_InvPrimeiroCiclo[DataInventario]) &&
			        Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData] = "Correto"
			    )
			)
			
			
			```
		formatString: 0
		lineageTag: de42cd48-d2bc-44a4-94ee-09892c9d1960

	measure TaxaAcuraciaAcumulada =
			
			DIVIDE([QtdCorretosAcumuladoPrimeiroCiclo], [ContagemEnderecosAcumuladoPrimeiroCiclo], 0)
		lineageTag: 6807bc1c-f611-48e0-acf0-b900774de763

	measure ContagemEnderecosAcumuladoPrimeiroCiclo = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			    FILTER(
			        ALLSELECTED(Fato_InvPrimeiroCiclo),
			        Fato_InvPrimeiroCiclo[DataInventario] <= MAX(Fato_InvPrimeiroCiclo[DataInventario])
			    )
			)
			
			```
		formatString: 0
		lineageTag: c0f2021f-d995-4d80-8b37-251f8eb4c5e4

	measure AcuracidadePorRuaPrimeiroCiclo =
			
			VAR PosicoesCorretas =
			    CALCULATE(
			        DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			        Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData] = "Correto",
			        (Fato_InvPrimeiroCiclo[Bloco] IN {"PCK","RUA","VAL"})
			    )
			VAR PosicoesTotais =
			    CALCULATE(
			        DISTINCTCOUNT(Fato_InvPrimeiroCiclo[IdBox]),
			        NOT ISBLANK(Fato_InvPrimeiroCiclo[AcuracidadePorPosicaoUltimaData]),
			        (Fato_InvPrimeiroCiclo[Bloco] IN {"PCK","RUA","VAL"})
			    )
			RETURN
			DIVIDE(PosicoesCorretas, PosicoesTotais)
		lineageTag: f955ff4d-6cdb-4623-9608-3d7df1cc7ae1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

