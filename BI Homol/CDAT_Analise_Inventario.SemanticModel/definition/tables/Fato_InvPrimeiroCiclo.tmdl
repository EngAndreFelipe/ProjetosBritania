	column EquipeContagem =
			
			VAR DataInv = Fato_InvPrimeiroCiclo[DataInventario]
			VAR Usuario = Fato_InvPrimeiroCiclo[Usuario1]
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(Dim_Usuarios[Equipe]),
			        FILTER(
			            Dim_Usuarios,
			            Dim_Usuarios[Usuario] = Usuario &&
			            DataInv >= Dim_Usuarios[De] &&
			            DataInv <= Dim_Usuarios[Até]
			        )
			    )
		lineageTag: fbe83ca2-416d-4584-af70-45b69d92a8c6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AcuracidadePorPosicao = ```
			
			    CALCULATE(
			        MAX(Fato_InvPrimeiroCiclo[Acuracidade]),
			        ALLEXCEPT(Fato_InvPrimeiroCiclo, Fato_InvPrimeiroCiclo[IdBox], Fato_InvPrimeiroCiclo[ChaveDocumento])
			    )
			```
		lineageTag: 33d124e2-7bb9-40b7-92be-4946611543ab
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

