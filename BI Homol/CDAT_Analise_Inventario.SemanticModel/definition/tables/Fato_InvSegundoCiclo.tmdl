	column ContagemMaisRecente =
			
			VAR DataMaisRecente =
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[DataInventario]),
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[IdBox]),
			        Fato_InvSegundoCiclo[EquipeContagem] = "INV-GERAL"
			    )
			RETURN
			    DataMaisRecente
		formatString: General Date
		lineageTag: 1f7a35e0-b6e0-48cc-a0b9-0f749765e01f
		summarizeBy: none

		variation Variation
			isDefault
			relationship: de8e8c80-64e8-4c44-aa8e-563420dcf35c
			defaultHierarchy: LocalDateTable_ac565b3d-4e77-40dc-85d8-badceef43f2b.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column ChaveDocumento =
			
			Fato_InvSegundoCiclo[NumeroInventario] & "-" & FORMAT(Fato_InvSegundoCiclo[DataInventario], "YYYYMMDD")
		lineageTag: e03ef443-cc15-4d37-babb-76b4d639a177
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ContagemId =
			
			VAR CurrentIdBox = Fato_InvSegundoCiclo[idbox]
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(Fato_InvSegundoCiclo[ChaveDocumento]),
			        FILTER(
			            Fato_InvSegundoCiclo,
			            Fato_InvSegundoCiclo[idbox] = CurrentIdBox
			        )
			    )
		formatString: 0
		lineageTag: f8a6960c-b88f-49f4-ada1-9db48c24278c
		summarizeBy: count

		annotation SummarizationSetBy = Automatic

	column EquipeContagem =
			
			VAR DataInv = Fato_InvSegundoCiclo[DataInventario]
			VAR Usuario = Fato_InvSegundoCiclo[Usuario1]
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(Dim_Usuarios[Equipe]),
			        FILTER(
			            Dim_Usuarios,
			            Dim_Usuarios[Usuario] = Usuario &&
			            DataInv >= Dim_Usuarios[De] &&
			            DataInv <= Dim_Usuarios[Até]
			        )
			    )
		lineageTag: 16f20f86-4b2e-4b27-ad3a-32b1d85edaed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AcuracidadePorPosicao = ```
			
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[Acuracidade]),
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[IdBox], Fato_InvSegundoCiclo[ChaveDocumento])
			    )
			```
		lineageTag: 0cb7246b-d054-4223-aa13-b5abb80608e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ValidaEndereco = IF(COUNTROWS(FILTER(Dim_Endereco, Dim_Endereco[IdBox] = Fato_InvSegundoCiclo[IdBox])) > 0, "Válido", "Não válido")
		lineageTag: 0e1ca2d3-3751-4c5e-a997-b5ef72b03892
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fato_InvSegundoCiclo = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("PR-S188\DW", "DW", [Query="SELECT#(lf)    CONVERT(VARCHAR(10), E.[dt-inventario], 103) AS DataInventario,#(lf)    E.[num-seq-invent] AS NumeroInventario,#(lf)#(lf)    -- Situação do inventário#(lf)    CASE V.[ind-sit-invent]#(lf)        WHEN 1 THEN 'Não iniciado'#(lf)        WHEN 2 THEN 'Em processo'#(lf)        WHEN 3 THEN 'Concluído'#(lf)        WHEN 4 THEN 'Atualizado'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoInv,#(lf)#(lf)    E.[id-box] AS IdBox,#(lf)    E.[cod-bloco] AS Bloco,#(lf)    E.[cod-rua] AS Rua,#(lf)    E.[cod-nivel] AS Nivel,#(lf)    E.[cod-coluna] AS Coluna,#(lf)#(lf)    -- Situação do endereço#(lf)    CASE E.[ind-sit-inv-end]#(lf)        WHEN 1 THEN 'Não iniciado'#(lf)        WHEN 2 THEN 'Em processo'#(lf)        WHEN 3 THEN 'Concluído'#(lf)        WHEN 4 THEN 'Atualizado'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoEnd,#(lf)#(lf)    I.[cod-item] AS Item,#(lf)    T.[DescItem] AS DescItem,#(lf)#(lf)    -- Situação do item#(lf)    CASE I.[ind-sit-inv-item]#(lf)        WHEN 1 THEN 'Não iniciado'#(lf)        WHEN 2 THEN 'Em processo'#(lf)        WHEN 3 THEN 'Concluído'#(lf)        WHEN 4 THEN 'Atualizado'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoItem,#(lf)#(lf)    -- Saldo ajustado#(lf)    CASE #(lf)        WHEN I.[cod-item] IS NULL AND I.[ind-sit-inv-item] NOT IN (1,2,3,4) AND E.[ind-sit-inv-end] = 4 THEN 0#(lf)        WHEN ISNUMERIC(I.[qtd-saldo]) = 1 THEN CAST(I.[qtd-saldo] AS INT)#(lf)        ELSE 0#(lf)    END AS Saldo,#(lf)#(lf)    -- QtdApurada1 ajustada#(lf)    CASE #(lf)        WHEN I.[cod-item] IS NULL AND I.[ind-sit-inv-item] NOT IN (1,2,3,4) AND E.[ind-sit-inv-end] = 4 THEN 0#(lf)        WHEN ISNUMERIC(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 3)) = 1 THEN #(lf)            CAST(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 3) AS FLOAT)#(lf)        ELSE 0#(lf)    END AS QtdApurada1,#(lf)#(lf)    -- QtdApurada2 ajustada#(lf)    CASE #(lf)        WHEN I.[cod-item] IS NULL AND I.[ind-sit-inv-item] NOT IN (1,2,3,4) AND E.[ind-sit-inv-end] = 4 THEN 0#(lf)        WHEN ISNUMERIC(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 2)) = 1 THEN #(lf)            CAST(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 2) AS FLOAT)#(lf)        ELSE 0#(lf)    END AS QtdApurada2,#(lf)#(lf)    -- QtdApurada3 permanece original com proteção#(lf)    CASE #(lf)        WHEN ISNUMERIC(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 1)) = 1 THEN #(lf)            CAST(PARSENAME(REPLACE(I.[qtd-apurada], ';', '.'), 1) AS FLOAT)#(lf)        ELSE 0#(lf)    END AS QtdApurada3,#(lf)#(lf)    E.[num-ult-contagem] AS UltimaContagem,#(lf)#(lf)    -- QtdFinal ajustada#(lf)    CASE #(lf)        WHEN I.[cod-item] IS NULL AND I.[ind-sit-inv-item] NOT IN (1,2,3,4) AND E.[ind-sit-inv-end] = 4 THEN 0#(lf)        WHEN ISNUMERIC(I.[qtd-final]) = 1 THEN CAST(I.[qtd-final] AS INT)#(lf)        ELSE 0#(lf)    END AS QtdFinal,#(lf)#(lf)    -- Divergencia ajustada#(lf)    CASE #(lf)        WHEN ISNUMERIC(I.[qtd-final]) = 1 AND ISNUMERIC(I.[qtd-saldo]) = 1 THEN #(lf)            CAST(I.[qtd-final] AS INT) - CAST(I.[qtd-saldo] AS INT)#(lf)        ELSE 0#(lf)    END AS Divergencia,#(lf)#(lf)    -- Coluna Acuracidade corrigida#(lf)CASE#(lf)    WHEN #(lf)        (#(lf)            I.[cod-item] IS NULL AND #(lf)            I.[ind-sit-inv-item] NOT IN (1,2,3,4) AND #(lf)            E.[ind-sit-inv-end] = 4#(lf)        )#(lf)        OR (#(lf)            ISNUMERIC(I.[qtd-final]) = 0 AND #(lf)            ISNUMERIC(I.[qtd-saldo]) = 0#(lf)        )#(lf)        THEN 'Correto'#(lf)    WHEN #(lf)        ISNUMERIC(I.[qtd-final]) = 1 AND #(lf)        ISNUMERIC(I.[qtd-saldo]) = 1 AND #(lf)        CAST(I.[qtd-final] AS INT) - CAST(I.[qtd-saldo] AS INT) = 0#(lf)        THEN 'Correto'#(lf)    ELSE 'Incorreto'#(lf)END AS Acuracidade,#(lf)#(lf)    -- Situação das contagens#(lf)    CASE PARSENAME(REPLACE(E.[ind-status-contagem], ';', '.'), 3)#(lf)        WHEN '1' THEN 'Não Contado'#(lf)        WHEN '2' THEN 'Em processo'#(lf)        WHEN '3' THEN 'Concluído'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoContagem1,#(lf)#(lf)    CASE PARSENAME(REPLACE(E.[ind-status-contagem], ';', '.'), 2)#(lf)        WHEN '1' THEN 'Não Contado'#(lf)        WHEN '2' THEN 'Em processo'#(lf)        WHEN '3' THEN 'Concluído'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoContagem2,#(lf)#(lf)    CASE PARSENAME(REPLACE(E.[ind-status-contagem], ';', '.'), 1)#(lf)        WHEN '1' THEN 'Não Contado'#(lf)        WHEN '2' THEN 'Em processo'#(lf)        WHEN '3' THEN 'Concluído'#(lf)        ELSE 'Desconhecido'#(lf)    END AS SituacaoContagem3,#(lf)#(lf)    -- Usuários#(lf)    LTRIM(RTRIM(LEFT(E.[usuario], CHARINDEX(';', E.[usuario]) - 1))) AS Usuario1,#(lf)    LTRIM(RTRIM(SUBSTRING(E.[usuario], CHARINDEX(';', E.[usuario]) + 1,#(lf)        CHARINDEX(';', E.[usuario], CHARINDEX(';', E.[usuario]) + 1) - CHARINDEX(';', E.[usuario]) - 1))) AS Usuario2,#(lf)    LTRIM(RTRIM(SUBSTRING(E.[usuario], CHARINDEX(';', E.[usuario], CHARINDEX(';', E.[usuario]) + 1) + 1,#(lf)        CHARINDEX(';', E.[usuario] + ';', CHARINDEX(';', E.[usuario], CHARINDEX(';', E.[usuario]) + 1) + 1)#(lf)        - CHARINDEX(';', E.[usuario], CHARINDEX(';', E.[usuario]) + 1) - 1))) AS Usuario3,#(lf)#(lf)    -- Datas e horários#(lf)    CONVERT(VARCHAR(10), CONVERT(DATE, E.[dt-leitura], 101), 103) AS DataLeitura,#(lf)    CONVERT(VARCHAR(8), DATEADD(SECOND, TRY_CAST(PARSENAME(REPLACE(E.[hr-leitura], ';', '.'), 3) AS INT), 0), 108) AS HoraLeitura1,#(lf)    CONVERT(VARCHAR(8), DATEADD(SECOND, TRY_CAST(PARSENAME(REPLACE(E.[hr-leitura], ';', '.'), 2) AS INT), 0), 108) AS HoraLeitura2,#(lf)    CONVERT(VARCHAR(8), DATEADD(SECOND, TRY_CAST(PARSENAME(REPLACE(E.[hr-leitura], ';', '.'), 1) AS INT), 0), 108) AS HoraLeitura3,#(lf)#(lf)    CONVERT(datetime, E.[DataCarga]) AS DataCarga#(lf)#(lf)FROM STAGE.tot.WmInventarioEndereco AS E#(lf)LEFT JOIN STAGE.tot.WmInventarioItem AS I#(lf)    ON E.[dt-inventario] = I.[dt-inventario]#(lf)    AND E.[num-seq-invent] = I.[num-seq-invent]#(lf)    AND E.[id-box] = I.[id-box]#(lf)LEFT JOIN STAGE.tot.WmInventario AS V#(lf)    ON I.[cod-estabel] = V.[cod-estabel]#(lf)    AND I.[cod-local] = V.[cod-local]#(lf)    AND I.[dt-inventario] = V.[dt-inventario]#(lf)    AND I.[num-seq-invent] = V.[num-seq-invent]#(lf)LEFT JOIN DW.dbo.Dim_Item AS T#(lf)    ON I.[cod-item] = T.CodItem#(lf)WHERE E.[cod-estabel] = '15'#(lf)  AND E.[cod-local] = 'aat'#(lf)  AND E.[dt-inventario] >= '2026-02-25'#(lf)  AND E.[ind-sit-inv-end] NOT LIKE '1'#(lf)#(lf)ORDER BY E.[dt-inventario], E.[num-seq-invent];"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"DataInventario", type date}, {"IdBox", Int64.Type}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

