	column AcuracidadePorPosicaoUltimaData =
			
			VAR DataMaisRecente =
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[DataInventario]),
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[IdBox])
			    )
			VAR AcuracidadeFinal =
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[Acuracidade]),
			        Fato_InvSegundoCiclo[DataInventario] = DataMaisRecente,
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[IdBox])
			    )
			RETURN
			    IF(AcuracidadeFinal = "Correto", "Correto", "Incorreto")
		lineageTag: 53f6275e-cc6d-45d6-840a-7bb6c42559e5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AcuracidadePorItemUltimaData =
			
			VAR DataMaisRecente =
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[DataInventario]),
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[Item])
			    )
			VAR AcuracidadeFinal =
			    CALCULATE(
			        MAX(Fato_InvSegundoCiclo[Acuracidade]),
			        Fato_InvSegundoCiclo[DataInventario] = DataMaisRecente,
			        ALLEXCEPT(Fato_InvSegundoCiclo, Fato_InvSegundoCiclo[Item])
			    )
			RETURN
			    IF(AcuracidadeFinal = "Correto", "Correto", "Incorreto")
		lineageTag: d3343ca7-f9fb-4ce4-a185-c189dd15ced4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

