table Fato_InvSegundoCiclo
	lineageTag: 143cb120-9420-4f83-a5c8-52cb45f15f88

	measure UltimaCargaInventario = MAX(Fato_InvSegundoCiclo[DataCarga])
		formatString: General Date
		lineageTag: 7c763402-ada0-4b43-9e0e-67a512393e31

	measure ContagemEnderecosPCK = CALCULATE(DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),Fato_InvSegundoCiclo[Bloco]="PCK")
		formatString: 0
		lineageTag: 44f1d14d-901d-4ff2-80b0-a302d855189c

	measure ContagemEnderecosRUA =
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),
			    -- Mantém apenas Bloco = RUA ou VAL
			    KEEPFILTERS( Fato_InvSegundoCiclo[Bloco] IN {"RUA", "VAL"} ),
			    -- Exclui RUA 25, 31 e 32
			    KEEPFILTERS( NOT ( Fato_InvSegundoCiclo[RUA] IN {"25", "31", "32"} ) )
			)
		formatString: 0
		lineageTag: a3bb9e6d-b95f-4e35-8871-861bf48ade86

	measure ContagemEnderecos =
			
			CALCULATE(
			    DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),
			    KEEPFILTERS( Fato_InvSegundoCiclo[Bloco] IN {"RUA", "VAL", "PCK"} ),
			    KEEPFILTERS( NOT ( Fato_InvSegundoCiclo[RUA] IN {"25",  "32"} ) )
			)
		formatString: 0
		lineageTag: 89e19896-5af1-4ee2-9c26-6b4cdbea4e84

	measure ContagemSKUs = DISTINCTCOUNT(Fato_InvSegundoCiclo[Item])
		formatString: 0
		lineageTag: 58f1a577-bda8-45e7-b7d0-7801c7330dcc

	measure PercentualAjuste =
			
			VAR ValorAjustado = SUM(Fato_InvSegundoCiclo[ValorAjuste])
			VAR ValorSaldo = SUM(Fato_InvSegundoCiclo[ValorSaldo])
			VAR PercentualAjustado = DIVIDE(ValorAjustado, ValorSaldo)
			RETURN
			IF(
			    ValorSaldo = 0,
			    BLANK(),
			    1 - PercentualAjustado
			)
		lineageTag: 6176c049-3c84-4d50-b94b-0087e9267172

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ContagemItensInv = DISTINCTCOUNT(Fato_InvSegundoCiclo[Item])
		formatString: 0
		lineageTag: 3fef71cf-5b62-4e39-99c4-d39b7b5faf9e

	measure SomaPeças =
			
			SUM(Fato_InvSegundoCiclo[QtdApurada1]) +
			SUM(Fato_InvSegundoCiclo[QtdApurada2]) +
			SUM(Fato_InvSegundoCiclo[QtdApurada3])
		lineageTag: 4e763605-903a-483c-b0c4-d7ea26b5460f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AcuracidadePorRuaSegundoCiclo =
			
			VAR PosicoesCorretas =
			    CALCULATE(
			        DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),
			        Fato_InvSegundoCiclo[AcuracidadePorPosicaoUltimaData] = "Correto",
			        (Fato_InvSegundoCiclo[Bloco] IN {"PCK","RUA","VAL"})
			    )
			VAR PosicoesTotais =
			    CALCULATE(
			        DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),
			        NOT ISBLANK(Fato_InvSegundoCiclo[AcuracidadePorPosicaoUltimaData]),
			        (Fato_InvSegundoCiclo[Bloco] IN {"PCK","RUA","VAL"})
			    )
			RETURN
			DIVIDE(PosicoesCorretas, PosicoesTotais)
		lineageTag: 7c02688c-7b8d-4856-bc11-7a71b0308444

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MediaEnderecosDia =
			
			DIVIDE(
			    DISTINCTCOUNT(Fato_InvSegundoCiclo[IdBox]),
			        DISTINCTCOUNT(Fato_InvSegundoCiclo[DataInventario]))
		lineageTag: 15122997-1e18-4da2-8360-273bf7d62ed4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DiasContados = ```
			
			    DISTINCTCOUNT(Fato_InvSegundoCiclo[DataInventario])
			```
		formatString: 0
		lineageTag: 726c1f5c-3ffd-4c62-9ff1-696a7af116b0

	measure PrevisãoDeDias = [TotalEnderecos] / [MediaEnderecosDia]
		lineageTag: 85d87bd4-c265-497f-ace0-59050b92da17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

