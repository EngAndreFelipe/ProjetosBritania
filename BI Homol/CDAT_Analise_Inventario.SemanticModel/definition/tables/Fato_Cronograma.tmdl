		summarizeBy: sum
		sourceColumn: Família

		annotation SummarizationSetBy = Automatic

	column SaldoContabil = COALESCE(RELATED(Dim_DCV[Quantidade]),0) + COALESCE(RELATED(Dim_AAT[Quantidade]),0) + COALESCE(RELATED(Dim_ATE[Quantidade]),0)
		formatString: 0
		lineageTag: 8139e418-920a-41a6-9eb3-5a7bb4b89bd7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SaldoWMS = COALESCE(RELATED(Dim_WMS[Quantidade]),0)
		formatString: 0
		lineageTag: aac8b982-7946-4eec-a189-7c80ec1675d4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Dia = DAY(Fato_Cronograma[Data Inventário ])
		formatString: 0
		lineageTag: 18e25c15-08fe-4ce6-bed1-a4697e37943a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Mês = FORMAT(Fato_Cronograma[Data Inventário ], "MMMM")
