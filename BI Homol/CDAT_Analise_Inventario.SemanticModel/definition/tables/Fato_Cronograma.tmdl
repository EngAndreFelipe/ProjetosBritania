table Fato_Cronograma
	lineageTag: dfceeda4-2b27-49fb-bd53-228888712e21

	measure DivergenciaPecas = SUM(Fato_Cronograma[SaldoWMS]) - SUM(Fato_Cronograma[SaldoContabil])
		formatString: 0
		lineageTag: c5459614-bdec-4e9f-821b-9666e9de71a8

	measure DivergenciaValor = SUM(Fato_Cronograma[CustoPeça]) * [DivergenciaPecas]
		lineageTag: 78b4a14e-b44f-4552-8572-e437f9a78662

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ContagemItens = DISTINCTCOUNT(Fato_Cronograma[Código])
		formatString: 0
		lineageTag: 56697c3b-0ceb-47cd-9c02-e98521d47d23

	measure SomaContabil = SUM(Fato_Cronograma[SaldoContabil])
		formatString: 0
		lineageTag: 8f479aad-c8ca-4093-8252-c90982d3bf1f

	measure SomaWMS = SUM(Fato_Cronograma[SaldoWMS])
		formatString: 0
		lineageTag: e4c4dd42-37c8-46fb-9e7b-cdd851b37360

	measure DivergenciaValorTotal = SUMX(Fato_Cronograma,[DivergenciaValor])
		lineageTag: 8bfb8383-5033-4d7a-935a-23101e501e84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DivergenciaABSPecas = SUMX(Fato_Cronograma, ABS([DivergenciaPecas]))
		formatString: 0
		lineageTag: 1df94c2d-483d-4afa-8ac6-42b95eda3591

	measure DivergenciaValorTotalABS = SUMX(Fato_Cronograma,ABS([DivergenciaValor]))
		lineageTag: bd8541e0-d292-4b6d-b72b-968b806ca897

		annotation PBI_FormatHint = {"isGeneralNumber":true}

