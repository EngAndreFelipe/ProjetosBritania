		summarizeBy: none
		sourceColumn: Classe_ABC

		annotation SummarizationSetBy = Automatic

	partition Dim_Enderecos_Inutil = m
		mode: import
		source = ```
				let
				    Fonte = Value.NativeQuery(
				        Sql.Database("PR-S188\DW", "Stage"),
				        "
				        SELECT 
				            CONCAT([cod-bloco], '/', [cod-rua], '/', [cod-nivel], '/', [cod-coluna]) AS Localizacao,
				            [id-box] AS IdBox, 
				            CASE [cdn-tipo-box]
				                WHEN 1 THEN 'PORTA PALETE'
				                WHEN 2 THEN 'PICKING'
				                WHEN 3 THEN 'SEPARAÇÃO'
				                WHEN 4 THEN 'DOCA'
				                WHEN 5 THEN 'INUTILIZADO'
				                WHEN 6 THEN 'RESERVA'
				                WHEN 7 THEN 'TRANSITÓRIO RETRABALHO'
				                ELSE 'DESCONHECIDO'
				            END AS TipoEndereco,
				            [cod-local], 
				            [cod-bloco], 
				            [cod-rua], 
				            [cod-nivel], 
				            [cod-coluna], 
				                     
				            
				            CASE [log-bloq-armaz]
				                            WHEN 0 THEN 'NAO'
				                            WHEN 1 THEN 'SIM'
				                            ELSE 'DESCONHECIDO'
				                        END AS Bloq_Armaz,
				
				                        CASE [log-bloq-retir]
				                            WHEN 0 THEN 'NAO'
				                            WHEN 1 THEN 'SIM'
				                            ELSE 'DESCONHECIDO'
				                        END AS Bloq_Retir,
				 
				            [ind-status-box],            
				            [ind-posicao-box], 
				            [int-2] AS Prioridade, 
				            
				            
				
				            
				            CAST(
				                CASE [idi-classif-abc]
				                    WHEN '1' THEN 'A'
				                    WHEN '2' THEN 'B'
				                    WHEN '3' THEN 'C'
				                    ELSE CAST([idi-classif-abc] AS varchar)
				                END AS varchar
				            ) AS Classe_ABC
				        FROM tot.WmBox
				        WHERE 
				            [cod-local] IN ('AAT')
				            AND [cdn-tipo-box] = 5
				        ",
				        null,
				        [EnableFolding=true]
				    )
				in
				    Fonte
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

